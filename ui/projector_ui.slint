
// ─────────────────────────────────────────────────────────────
//  MEDIDOR DE TEXTO — no se muestra en pantalla, solo se usa
//  para preguntarle al motor de layout de Slint cuánto espacio
//  real ocuparía un texto a un tamaño de fuente dado. Esto
//  reemplaza cualquier fórmula matemática de estimación (que
//  varía entre sistemas operativos/fuentes) por una medición
//  100% real, igual en cualquier hardware o distro.
// ─────────────────────────────────────────────────────────────
export component MedidorTexto inherits Text {
    // Se posiciona fuera del área visible; no necesita layout real.
    x: -10000px;
    y: -10000px;

    wrap: word-wrap;
    overflow: clip;
    font-family: "Google Sans";
    font-weight: 900;

    // Rust lee esta altura después de fijar `text`, `width` y `font-size`.
    out property <length> altura_medida: self.preferred-height;
}

export component MedidorWindow inherits Window {
    width: 4px;
    height: 4px;

    medidor := MedidorTexto { }

    public function medir_altura(texto: string, ancho: length, tamano_fuente: length) -> length {
        medidor.text = texto;
        medidor.width = ancho;
        medidor.font-size = tamano_fuente;
        return medidor.altura_medida;
    }
}

export component ProjectorWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "";

    // 1. El fondo real de la ventana de Windows siempre será negro
    background: black;

    default-font-family: "Google Sans";

    in property <string> texto_proyeccion: "";
    in property <string> referencia: "";
    in property <float>  tamano_letra: 85;
    in property <color>  bg_color: black;
    in property <color>  text_color: white;
    in property <image>  fondo_imagen;
    in property <string> fondo_imagen_aspecto: "rellenar";
    in property <bool>   mostrar_imagen: false;
    in property <image>  fondo_video_frame;
    in property <bool>   es_video: false;
    in property <float>  fondo_opacity: 0.0;

     in property <image>  biblioteca_video_frame;
    in property <bool>   mostrar_video_biblioteca: false;

    in property <float> margen_izquierdo: 0;
    in property <float> margen_derecho: 0;
    in property <float> margen_superior: 0;
    in property <float> margen_inferior: 0;

        // 2. NUEVO PARADIGMA: el fondo (imagen/video) SIEMPRE ocupa el 100%
    //    de la ventana, sin recalcularse jamás por los márgenes. Cada
    //    margen solo dibuja su propia "cortina" negra en su borde,
    //    totalmente independiente de los otros tres. Esto elimina el
    //    bug donde mover un margen (p.ej. izquierdo) reescalaba el
    //    fondo con "contain"/"cover" y provocaba un desplazamiento
    //    visible también en el eje contrario.
    Rectangle {
        width: 100%; height: 100%;
        background: root.bg_color;

        // ── Capa 1: Imagen estática (tamaño FIJO, nunca depende de márgenes) ─
        if (root.mostrar_imagen && !root.es_video && !root.mostrar_video_biblioteca) : Image {
            source: root.fondo_imagen;
            width: 100%; height: 100%;
            image-fit: root.fondo_imagen_aspecto == "rellenar" ? cover
                     : (root.fondo_imagen_aspecto == "estirar" ? fill : contain);
        }

        // ── Capa 1.5: Frame de video de FONDO (tamaño FIJO) ──────────────
        if (root.es_video && !root.mostrar_video_biblioteca) : Image {
            source: root.fondo_video_frame;
            width: 100%; height: 100%;
            image-fit: contain;
        }

        // ── Capa 2: Velo oscurecedor — SOLO aplica al fondo ──────────────
        if (!root.mostrar_video_biblioteca) : Rectangle {
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, root.fondo_opacity);
        }

        // ── Capa 3: Texto — se ubica dentro del área visible (con márgenes) ─
        //    Aquí SÍ aplicamos los márgenes, porque el texto debe
        //    reposicionarse dentro del espacio disponible. Esto no
        //    afecta al fondo, que vive en una capa completamente aparte.
        if (!root.mostrar_video_biblioteca) : VerticalLayout {
            x: root.margen_izquierdo * 1px;
            y: root.margen_superior * 1px;
            width: parent.width - (root.margen_izquierdo + root.margen_derecho) * 1px;
            height: parent.height - (root.margen_superior + root.margen_inferior) * 1px;
            spacing: 0px;

            padding-left: 4px;
            padding-right: 4px;
            padding-top: 3px;
            padding-bottom: 3px;

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                Text {
                    text: root.texto_proyeccion;
                    color: root.text_color;
                    font-size: root.tamano_letra * 1px;
                    font-weight: 900;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }

            if (root.referencia != "") : Rectangle {
                height: 8%;
                min-height: 55px;
                max-height: 100px;
                background: transparent;
                Text {
                    text: root.referencia;
                    color: root.text_color;
                    font-size: 75px;
                    font-weight: 800;
                    font-italic: true;
                    padding-right: 20px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        // ── Capa 4: Video de la BIBLIOTECA (tamaño FIJO) ─────────────────
        if (root.mostrar_video_biblioteca) : Rectangle {
            width: 100%; height: 100%;
            background: black;

            Image {
                source: root.biblioteca_video_frame;
                width: 100%; height: 100%;
                image-fit: contain;
            }
        }

        // ── Capa 5: CORTINAS DE MARGEN ────────────────────────────────────
        // Cada cortina depende ÚNICAMENTE de su propia variable. Mover
        // el margen izquierdo solo cambia el ancho de la cortina
        // izquierda; no toca superior, inferior ni derecha, y — lo
        // más importante — NO fuerza ningún recálculo de escala del
        // fondo, porque el fondo ya no vive dentro de este cálculo.
        Rectangle {
            x: 0; y: 0;
            width: root.margen_izquierdo * 1px; height: 100%;
            background: black;
        }
        Rectangle {
            x: parent.width - root.margen_derecho * 1px; y: 0;
            width: root.margen_derecho * 1px; height: 100%;
            background: black;
        }
        Rectangle {
            x: 0; y: 0;
            width: 100%; height: root.margen_superior * 1px;
            background: black;
        }
        Rectangle {
            x: 0; y: parent.height - root.margen_inferior * 1px;
            width: 100%; height: root.margen_inferior * 1px;
            background: black;
        }
    }



}