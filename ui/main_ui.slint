    public function focus_panel() { panel-focus.focus(); }

    // ══════════════════════════════════════════════════════════════
    //  LAYOUT PRINCIPAL  (2 columnas: sidebar izquierdo + central)
    // ══════════════════════════════════════════════════════════════
    Rectangle {
        width: 100%; height: 100%;

        HorizontalLayout {

            // ╔══════════════════════════════════════════════════╗
            // ║   COLUMNA 1: SIDEBAR UNIFICADO (nav + biblioteca) ║
            // ╚══════════════════════════════════════════════════╝
            Rectangle {
                width: 300px; background: Theme.bg_sidebar;
                border-width: 1px; border-color: Theme.border_subtle;

                VerticalLayout {

                    // ── BARRA DE TABS ───────────────────────────
                    Rectangle {
                        height: 34px; background: Theme.bg_topbar;
                        border-width: 1px; border-color: Theme.border_subtle;

                        HorizontalLayout {
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "CANTOS";
                                active: root.active-tab == "cantos";
                                clicked => { 
                                    root.active-tab = "cantos"; 
                                    root.elemento_seleccionado = ""; 
                                    root.estrofas_actuales = []; 
                                    root.active_estrofa_index = -1;
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "BIBLIA";
                                active: root.active-tab == "biblias";
                                clicked => { 
                                    root.active-tab = "biblias"; 
                                    root.elemento_seleccionado = ""; 
                                    root.estrofas_actuales = []; 
                                    root.active_estrofa_index = -1;
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "IMGS";
                                active: root.active-tab == "imagenes";
                                clicked => { 
                                    root.active-tab = "imagenes"; 
                                    root.elemento_seleccionado = "";
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "VIDEOS";
                                active: root.active-tab == "videos";
                                clicked => { 
                                    root.active-tab = "videos"; 
                                    root.elemento_seleccionado = "";
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "PDF/PPTX";
                                active: root.active-tab == "pdf";
                                clicked => { 
                                    root.active-tab = "pdf"; 
                                    root.elemento_seleccionado = "";
                                    root.sync_estilos(); 
                                }
                            }
                        }

                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border_subtle; }
                    }

                    // ── CONTENIDO DE BIBLIOTECA (vertical-stretch) ──
                    Rectangle {
                        vertical-stretch: 1;

                        // ── TAB CANTOS ──
                        if (root.active-tab == "cantos") : VerticalLayout {
                            // Buscador
                            Rectangle {
                                height: 52px;
                                Rectangle {
                                    height: 32px; x: 10px; y: 10px; width: parent.width - 20px;
                                    border-radius: 4px; background: Theme.bg_input; border-width: 1px; border-color: Theme.border_input;
                                    HorizontalLayout {
                                        padding-left: 10px; spacing: 6px;
                                        Text { text: ""; font-size: 10px; color: Theme.text_muted; vertical-alignment: center; }
                                        TextInput { text <=> root.buscador_texto; font-size: 10px; color: Theme.text_primary; vertical-alignment: center; horizontal-stretch: 1; edited => { root.buscador_pending = self.text; root.hay_busqueda_pendiente = true; } }                                    }
                                }
                            }
                            // Lista de cantos
                            Rectangle {
                                vertical-stretch: 1; background: Theme.bg_list; border-width: 1px; border-color: Theme.border_subtle;
                                ScrollView {
                                    VerticalLayout {
                                        padding-left: 4px; padding-right: 4px; padding-top: 4px; spacing: 0px;
                                                                                for canto in root.cantos : Rectangle {
                                            height: 36px;
                                            property <bool> fila_resaltada: touch-canto.has-hover || star-touch.has-hover;
                                            background: fila_resaltada ? rgba(63,111,115,0.18) : transparent;
                                            touch-canto := TouchArea {
                                                clicked => { root.seleccionar_canto(canto.id); }
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                        root.menu_canto_id = canto.id;
                                                        root.menu_canto_titulo = canto.titulo;
                                                        root.menu_x = min(self.absolute-position.x + self.mouse-x, root.width - 185px);
                                                        root.menu_y = min(self.absolute-position.y + self.mouse-y, root.height - 114px);
                                                        root.mostrar_menu_canto = true;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
        padding-left: 10px; padding-right: 4px; spacing: 4px;
        Text { text: canto.titulo; color: Theme.text_primary; font-size: 11px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        
        Rectangle {
            width: 28px; height: 28px; border-radius: 6px;
            background: star-touch.has-hover ? rgba(255,200,0,0.12) : transparent;
            star-touch := TouchArea {
                clicked => { root.toggle_favorito_canto(canto.id); }
            }
            Text {
                text: canto.favorito ? "★" : "☆";
                color: canto.favorito ? #fbbf24 : (star-touch.has-hover ? #fbbf24 : Theme.text_muted);
                font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border_subtle; }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB BIBLIAS ──
                        if (root.active-tab == "biblias") : VerticalLayout {
                            padding: 10px; spacing: 10px;
                            ComboBox { height: 32px; width: 100%; model: root.bible-versions; current-value <=> root.current-bible-version; selected(val) => { root.bible-version-changed(val); } }
                            Rectangle {
                                height: 32px; width: 100%; background: Theme.bg_input; border-radius: 4px; border-width: 1px; border-color: Theme.border_input;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                                    Text { text: ""; font-size: 10px; color: Theme.text_muted; vertical-alignment: center; }
                                    search_focus := FocusScope {
                                        horizontal-stretch: 1; forward-focus: search_input;
                                        key-pressed(event) => {
                                            if (event.text == Key.Tab || event.text == Key.RightArrow) {
                                                if (root.bible-search-suggestion != "" && root.bible-search-suggestion != root.bible-search-text) {
                                                    root.bible-search-text = root.bible-search-suggestion + " ";
                                                    root.bible-search-suggestion = "";
                                                    root.bible-search-changed(root.bible-search-text);
                                                    search_input.set-selection-offsets(999, 999);
                                                    return accept;
                                                }
                                            }
                                            return reject;
                                        }
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            Text { text: root.bible-search-suggestion; color: Theme.text_muted; font-size: 1px; vertical-alignment: center; horizontal-alignment: left; width: 100%; }
                                            search_input := TextInput {
                                                width: 100%; height: 100%;
                                                text <=> root.bible-search-text;
                                                color: Theme.text_primary; font-size: 10px; vertical-alignment: center;
                                                edited => { root.bible-search-changed(self.text); }
                                                key-pressed(event) => {
                                                    if (event.text == Key.Return && event.modifiers.shift) {
                                                        root.bible-search-preview(self.text);
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                                accepted => { root.bible-search-accepted(self.text); }
                                            }
                                        }
                                    }
                                }
                            }
                            if (!root.show-bible-chapters) : Rectangle {
                                vertical-stretch: 1; background: Theme.bg_list; border-radius: 8px; border-width: 1px; border-color: Theme.border_subtle;
                                ScrollView {
                                    VerticalLayout {
                                        padding: 4px;
                                        for book in root.bible-books : Rectangle {
                                            height: 36px; background: touch-book.has-hover ? rgba(63,111,115,0.18) : transparent;
                                            touch-book := TouchArea { clicked => { root.selected-bible-book = book; root.show-bible-chapters = true; root.bible-book-selected(book); } }
                                            HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: book.nombre; color: touch-book.has-hover ? Theme.text_primary : Theme.text_secondary; font-size: 11px; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border_subtle; }
                                        }
                                    }
                                }
                            }
                            if (root.show-bible-chapters) : Rectangle {
                                vertical-stretch: 1; background: Theme.bg_list; border-radius: 8px; border-width: 1px; border-color: Theme.border_subtle;
                                VerticalLayout {
                                    Rectangle {
                                        height: 36px;
                                        touch-back := TouchArea { clicked => { root.show-bible-chapters = false; } }
                                        HorizontalLayout { padding-left: 12px; spacing: 8px; Text { text: "<"; color: Theme.accent; font-weight: 900; vertical-alignment: center;} Text { text: root.selected-bible-book.nombre; color: Theme.accent; font-size: 11px; font-weight: 900; vertical-alignment: center; } }
                                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border_subtle; }
                                    }
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px; alignment: start;
                                            for row in root.chapter-rows : HorizontalLayout {
                                                spacing: 8px; height: 42px;
                                                for cap in row.caps : Rectangle {
                                                    width: 42px; border-radius: 6px; border-width: 1px; border-color: Theme.border_subtle;
                                                    background: touch-cap.has-hover ? Theme.accent : Theme.bg_input;
                                                    touch-cap := TouchArea { clicked => { root.bible-chapter-selected(cap); } }
                                                    Text { text: cap; color: touch-cap.has-hover ? white : Theme.text_secondary; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB IMÁGENES MULTIMEDIA ──
                        if (root.active-tab == "imagenes") : Rectangle {
                            vertical-stretch: 1; background: Theme.bg_list; border-width: 1px; border-color: Theme.border_subtle;
                            TouchArea {
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        root.menu_media_idx = -1;
                                        root.menu_media_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                        root.menu_media_y = min(self.absolute-position.y + self.mouse-y, root.height - 150px);
                                        root.mostrar_menu_media = true;
                                    }
                                }
                                ScrollView {
                                    VerticalLayout {
                                        padding: 8px; spacing: 8px;
                                        for item[idx] in root.multimedia_items : Rectangle {
                                            height: 52px; border-radius: 6px;
                                            background: root.selected_media_idx == idx ? rgba(63,111,115,0.18) : (touch-media.has-hover ? Theme.bg_card_hover : transparent);
                                            touch-media := TouchArea {
                                                clicked => { root.selected_media_idx = idx; }
                                                double-clicked => { root.proyectar_multimedia(idx); }
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                        root.menu_media_idx = idx;
                                                        root.menu_media_x = self.absolute-position.x + self.mouse-x;
                                                        root.menu_media_y = self.absolute-position.y + self.mouse-y;
                                                        root.mostrar_menu_media = true;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                padding: 6px; spacing: 12px;
                                                Rectangle {
                                                    width: 72px; height: 40px; border-radius: 4px; clip: true; background: #000;
                                                    Image {
                                                        source: item.img; width: 100%; height: 100%;
                                                        image-fit: item.aspecto == "rellenar" ? cover : (item.aspecto == "estirar" ? fill : contain);
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center; spacing: 4px;
                                                    Text { text: item.nombre; color: Theme.text_primary; font-size: 11px; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
                                                    if (root.default_bg_type == "imagen" && root.default_bg_idx == idx) : Text { text: "FONDO PREDETERMINADO"; color: #eab308; font-size: 9px; font-weight: 800; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB VIDEOS (BIBLIOTECA) ──
                        if (root.active-tab == "videos") : Rectangle {
                            vertical-stretch: 1; background: Theme.bg_list; border-width: 1px; border-color: Theme.border_subtle;
                            TouchArea {
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        root.menu_video_idx = -1;
                                        root.menu_video_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                        root.menu_video_y = min(self.absolute-position.y + self.mouse-y, root.height - 146px);
                                        root.mostrar_menu_video = true;
                                    }
                                }
                                ScrollView {
                                    VerticalLayout {
                                        padding: 8px; spacing: 8px;
                                        for item[idx] in root.video_items : Rectangle {
                                            height: 60px; border-radius: 6px;
                                            background: root.selected_video_idx == idx ? rgba(63,111,115,0.18) : (touch-vid.has-hover ? Theme.bg_card_hover : transparent);
                                            touch-vid := TouchArea {
                                                clicked => { root.seleccionar_video_lista(idx); }
                                                double-clicked => { root.proyectar_video(idx); }
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                        root.menu_video_idx = idx;
                                                        root.menu_video_x = self.absolute-position.x + self.mouse-x;
                                                        root.menu_video_y = self.absolute-position.y + self.mouse-y;
                                                        root.mostrar_menu_video = true;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                padding: 6px; spacing: 12px;
                                                Rectangle {
                                                    width: 80px; height: 45px; border-radius: 4px; clip: true; background: #000;
                                                    Image { source: item.img; width: 100%; height: 100%; image-fit: cover; }
                                                    Text { text: "▶"; color: rgba(255,255,255,0.7); font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                VerticalLayout {
                                                    alignment: center; spacing: 4px;
                                                    Text { text: item.nombre; color: Theme.text_primary; font-size: 11px; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
                                                    if (item.is_loop) : Text { text: "BUCLE ACTIVADO"; color: Theme.accent; font-size: 9px; font-weight: 800; }
                                                    if (root.default_bg_type == "video" && root.default_bg_idx == idx) : Text { text: "FONDO PREDETERMINADO"; color: #eab308; font-size: 9px; font-weight: 800; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB PDF (BIBLIOTECA) ──
                        if (root.active-tab == "pdf") : Rectangle {
                            vertical-stretch: 1; background: Theme.bg_list; border-width: 1px; border-color: Theme.border_subtle;
                            TouchArea {
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        root.menu_pdf_idx = -1;
                                        root.menu_pdf_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                        root.menu_pdf_y = min(self.absolute-position.y + self.mouse-y, root.height - 100px);
                                        root.mostrar_menu_pdf = true;
                                    }
                                }
                            }
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px; spacing: 8px;
                                    for item[idx] in root.pdf_items : Rectangle {
                                        height: 60px; border-radius: 6px;
                                        background: root.selected_pdf_idx == idx ? rgba(63,111,115,0.18) : (touch-pdf.has-hover ? Theme.bg_card_hover : transparent);
                                        touch-pdf := TouchArea {
                                            clicked => { root.seleccionar_pdf(idx); }
                                            pointer-event(e) => {
                                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                    root.menu_pdf_idx = idx;
                                                    root.menu_pdf_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                                    root.menu_pdf_y = min(self.absolute-position.y + self.mouse-y, root.height - 100px);
                                                    root.mostrar_menu_pdf = true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding: 6px; spacing: 12px;
                                            Rectangle {
                                                width: 40px; height: 48px; border-radius: 4px; clip: true; background: #fff;
                                                Image { source: item.miniatura; width: 100%; height: 100%; image-fit: cover; }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 4px;
                                                Text { text: item.nombre; color: Theme.text_primary; font-size: 11px; font-weight: 700; horizontal-stretch: 1; overflow: elide; }
                                                Text { text: item.total_paginas + " Páginas"; color: Theme.text_secondary; font-size: 9px; font-weight: 600; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── SECCIÓN FAVORITOS ───────────────────────
                    Rectangle {
                        height: 250px; background: Theme.bg_topbar;
                        border-width: 1px; border-color: Theme.border_subtle;

                        VerticalLayout {
                            // Encabezado favoritos
                            Rectangle {
                                height: 28px;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: "★  FAVORITOS"; color: #fbbf24; font-size: 9px; font-weight: 700; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: root.favoritos.length > 0 ? root.favoritos.length + "" : ""; color: Theme.text_muted; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border_subtle; }
                            }

                            // Lista de favoritos
                            Rectangle {
                                vertical-stretch: 1; clip: true;
                                if (root.favoritos.length == 0) : Text {
                                    text: "Pulsa ☆ en un canto o versículo\npara añadirlo aquí";
                                    color: Theme.text_muted; font-size: 9px; font-weight: 600;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    wrap: word-wrap; width: 100%; height: 100%;
                                }
                                if (root.favoritos.length > 0) : ScrollView {
                                    VerticalLayout {
                                        padding: 4px; spacing: 0px;
                                        for fav in root.favoritos : Rectangle {
                                            height: 34px; border-radius: 4px;
                                            background: touch-fav.has-hover ? rgba(251,191,36,0.12) : transparent;
                                            touch-fav := TouchArea {
                                                clicked => { root.abrir_favorito(fav); }
                                            }
                                            HorizontalLayout {
                                                padding-left: 10px; padding-right: 8px; spacing: 8px;
                                                // Icono tipo
                                                Text {
                                                    text: fav.tipo == "canto" ? "♪" : "✝";
                                                    color: fav.tipo == "canto" ? Theme.accent : #7c5cbf;
                                                    font-size: 10px; vertical-alignment: center;
                                                    width: 14px;
                                                }
                                                // Título
                                                Text {
                                                    text: fav.referencia != "" ? fav.referencia : fav.titulo;
                                                    color: touch-fav.has-hover ? #8a6510 : Theme.text_secondary;
                                                    font-size: 10px; font-weight: 600;
                                                    vertical-alignment: center; horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                // Estrella para quitar
                                                Rectangle {
                                                    width: 22px; height: 22px; border-radius: 4px;
                                                    background: del-fav.has-hover ? rgba(0,0,0,0.06) : transparent;
                                                    del-fav := TouchArea {
                                                        clicked => {
                                                            if (fav.tipo == "canto") { root.toggle_favorito_canto(fav.id); }
                                                            else { root.toggle_favorito_estrofa(fav.referencia, fav.titulo); }
                                                        }
                                                    }
                                                    Text { text: "★"; color: del-fav.has-hover ? Theme.text_muted : #d39b16; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: rgba(0,0,0,0.03); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ╔══════════════════════════════════════════════╗
            // ║  COLUMNA 2: PANEL CENTRAL                    ║
            // ╚══════════════════════════════════════════════╝
            Rectangle {
                horizontal-stretch: 1; background: Theme.bg_main;
                VerticalLayout {
                    // ── MENÚ SUPERIOR + BARRA DE TÍTULO ─────────────────
                    VerticalLayout {
                        height: 84px;
                        spacing: 0px;

                        // Menú superior: reemplaza el botón de engranaje.
                        Rectangle {
                            height: 36px;
                            background: Theme.bg_topbar;
                            border-width: 1px;
                            border-color: Theme.border_subtle;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;

                                TopMenuItem {
                                    text: "Fondos";
                                    clicked => { root.mostrar_personalizar = true; }
                                }

                                Rectangle {
                                width: 140px; height: 36px;
                                border-radius: 4px;
                                background: cfg-touch.has-hover ? Theme.bg_card_hover : transparent;
                                cfg-touch := TouchArea {
                                    clicked => {
                                        root.menu_configuracion_x = self.absolute-position.x;
                                        root.menu_configuracion_y = self.absolute-position.y + self.height;
                                        root.mostrar_menu_configuracion = !root.mostrar_menu_configuracion;
                                    }
                                }
                                Text {
                                    text: "Configuración";
                                    color: cfg-touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                    font-size: 11px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }

                            Rectangle {
                                width: 118px; height: 36px;
                                border-radius: 4px;
                                background: tools-touch.has-hover ? Theme.bg_card_hover : transparent;
                                tools-touch := TouchArea {
                                    clicked => {
                                        root.menu_herramientas_x = self.absolute-position.x;
                                        root.menu_herramientas_y = self.absolute-position.y + self.height;
                                        root.mostrar_menu_herramientas = !root.mostrar_menu_herramientas;
                                    }
                                }
                                Text {
                                    text: "Herramientas";
                                    color: tools-touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                    font-size: 11px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }


                            Rectangle {
                                width: 90px; height: 36px;
                                border-radius: 4px;
                                background: help-touch.has-hover ? Theme.bg_card_hover : transparent;
                                help-touch := TouchArea {
                                    clicked => {
                                        root.menu_ayuda_x = self.absolute-position.x;
                                        root.menu_ayuda_y = self.absolute-position.y + self.height;
                                        root.mostrar_menu_ayuda = !root.mostrar_menu_ayuda;
                                    }
                                }
                                Text {
                                    text: "Ayuda";
                                    color: help-touch.has-hover ? Theme.text_primary : Theme.text_secondary;
                                    font-size: 11px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }

                                Rectangle { horizontal-stretch: 1; }

                                Rectangle {
                                    width: 52px;
                                    height: 28px;
                                    border-radius: 8px;
                                    background: touch-live.has-hover ? #b91c1c : #dc2626;
                                    border-width: 1px;
                                    border-color: rgba(220, 38, 38, 0.6);

                                    touch-live := TouchArea {
                                        clicked => {
                                            root.abrir_proyector();
                                            if (root.default_bg_type == "imagen" && root.default_bg_idx >= 0 && root.default_bg_idx < root.multimedia_items.length) {
                                                root.proyectar_multimedia(root.default_bg_idx);
                                            } else if (root.default_bg_type == "video" && root.default_bg_idx >= 0 && root.default_bg_idx < root.video_items.length) {
                                                root.proyectar_video(root.default_bg_idx);
                                            }
                                        }
                                    }

                                    Text {
                                        text: "LIVE";
                                        font-size: 9px;
                                        font-weight: 900;
                                        letter-spacing: 0.8px;
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 48px;
                            background: Theme.bg_main;

                            HorizontalLayout {
                                padding-left: 24px;
                                padding-right: 16px;

                                Text {
                                    text: root.elemento_seleccionado == "" ? "SELECCIONA UN ELEMENTO" : " " + root.elemento_seleccionado;
                                    color: root.elemento_seleccionado == "" ? Theme.text_muted : Theme.accent;
                                    font-size: 12px;
                                    font-weight: 900;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.border_subtle;
                            }
                        }
                    }

                    panel-focus := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(event) => {
                            if (root.estrofas_actuales.length > 0 && (root.active-tab == "cantos" || root.active-tab == "biblias")) {
                                if (event.text == Key.UpArrow) {
                                    if (root.active_estrofa_index > 0) {
                                        root.active_estrofa_index -= 1;
                                        root.proyectar_estrofa(root.estrofas_actuales[root.active_estrofa_index].texto, root.active-tab == "biblias" ? root.elemento_seleccionado + ":" + root.estrofas_actuales[root.active_estrofa_index].orden : "");
                                        
                                        // Scroll dinámico con valor NEGATIVO para enlace bidireccional
                                        root.scroll_to_y = root.active-tab == "biblias" 
                                            ? -(root.active_estrofa_index * 115px > 150px ? root.active_estrofa_index * 115px - 150px : 0px)
                                            : -((root.active_estrofa_index / 3) * 192px > 150px ? (root.active_estrofa_index / 3) * 192px - 150px : 0px);
                                    }
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    if (root.active_estrofa_index < root.estrofas_actuales.length - 1) {
                                        root.active_estrofa_index += 1;
                                        root.proyectar_estrofa(root.estrofas_actuales[root.active_estrofa_index].texto, root.active-tab == "biblias" ? root.elemento_seleccionado + ":" + root.estrofas_actuales[root.active_estrofa_index].orden : "");
                                        
                                        // Scroll dinámico con valor NEGATIVO para enlace bidireccional
                                        root.scroll_to_y = root.active-tab == "biblias" 
                                            ? -(root.active_estrofa_index * 115px > 150px ? root.active_estrofa_index * 115px - 150px : 0px)
                                            : -((root.active_estrofa_index / 3) * 192px > 150px ? (root.active_estrofa_index / 3) * 192px - 150px : 0px);
                                    } else if (root.active_estrofa_index == -1) {
                                        root.active_estrofa_index = 0;
                                        root.proyectar_estrofa(root.estrofas_actuales[root.active_estrofa_index].texto, root.active-tab == "biblias" ? root.elemento_seleccionado + ":" + root.estrofas_actuales[root.active_estrofa_index].orden : "");
                                        root.scroll_to_y = 0px;
                                    }
                                    return accept;
                                }
                            }
                            return reject;
                        }

                        Rectangle {
                            width: 100%; height: 100%; background: Theme.bg_main;

                            // ── VISTA CANTOS / BIBLIAS ──
                            if (root.active-tab == "cantos" || root.active-tab == "biblias") : Rectangle {
                                width: 100%; height: 100%;
                                if (root.estrofas_actuales.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: root.elemento_seleccionado == "" ? "SELECCIONA UN ARCHIVO DE LA BIBLIOTECA" : root.elemento_seleccionado; color: Theme.text_muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                                }
                                if (root.estrofas_actuales.length > 0) : ScrollView {
                                    viewport-y <=> root.scroll_to_y;
                                    VerticalLayout {
                                        padding: 16px; spacing: 12px;
                                        // ── CUADRÍCULA 3×N ──
                                        // Fila 0: índices 0,1,2
                                        // Fila 1: índices 3,4,5 … etc.
                                        // Se generan filas de hasta 3 celdas usando GridLayout
                                        GridLayout {
                                            spacing: 12px;
                                            for estrofa[idx] in root.estrofas_actuales : Rectangle {
                                                row: root.active-tab == "biblias" ? idx : idx / 3;
                                                col: root.active-tab == "biblias" ? 0 : mod(idx, 3);
                                                height: root.active-tab == "biblias" ? 103px : 180px;
                                                border-radius: 8px; border-width: 1px;
                                                background: idx == root.active_estrofa_index
                                                    ? rgba(220, 38, 38, 0.18)
                                                    : (touch-estrofa.has-hover ? Theme.accent_soft : Theme.bg_card);
                                                border-color: idx == root.active_estrofa_index
                                                    ? #dc2626
                                                    : (touch-estrofa.has-hover ? Theme.accent : Theme.border_subtle);

                                                touch-estrofa := TouchArea {
                                                    clicked => {
                                                        root.active_estrofa_index = idx;
                                                        root.proyectar_estrofa(
                                                            estrofa.texto,
                                                            root.active-tab == "biblias"
                                                                ? root.elemento_seleccionado + ":" + estrofa.orden
                                                                : ""
                                                        );
                                                        panel-focus.focus();
                                                    }
                                                }

                                                VerticalLayout {
                                                    padding: 10px; spacing: 6px;

                                                    // ── Cabecera: número + estrellita + badge LIVE/PROYECTAR ──
                                                    HorizontalLayout {
                                                        spacing: 6px; alignment: space-between;
                                                        
                                                        // Agrupamos el número y la estrellita a la izquierda
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Text {
                                                                text: estrofa.orden;
                                                                color: idx == root.active_estrofa_index ? #dc2626 : Theme.accent;
                                                                font-weight: 900; font-size: 10px;
                                                                vertical-alignment: center;
                                                            }
                                                            
                                                            // Aquí está la estrellita nueva
                                                            Rectangle {
                                                                width: 20px;
                                                                TouchArea {
                                                                    mouse-cursor: pointer;
                                                                    clicked => {
                                                                        root.toggle_favorito_estrofa(root.elemento_seleccionado + ":" + estrofa.orden, estrofa.texto);
                                                                    }
                                                                    Text {
                                                                        text: estrofa.favorito ? "★" : "☆";
                                                                        color: estrofa.favorito ? #d39b16 : Theme.text_muted;
                                                                        font-size: 14px;
                                                                        horizontal-alignment: center;
                                                                        vertical-alignment: center;
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        Rectangle {
                                                            width: 54px; height: 18px; border-radius: 4px; border-width: 1px;
                                                            background: idx == root.active_estrofa_index ? #dc2626 : transparent;
                                                            border-color: idx == root.active_estrofa_index
                                                                ? #dc2626
                                                                : (touch-estrofa.has-hover ? rgba(63,111,115,0.45) : Theme.border_subtle);
                                                            Text {
                                                                text: idx == root.active_estrofa_index ? "EN VIVO" : "CLIC";
                                                                color: idx == root.active_estrofa_index ? white : (touch-estrofa.has-hover ? Theme.accent : Theme.text_muted);
                                                                font-size: 8px; font-weight: 800;
                                                                horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // ── Separador ──
                                                    Rectangle {
                                                        height: 1px;
                                                        background: idx == root.active_estrofa_index
                                                            ? rgba(220,38,38,0.3)
                                                            : Theme.border_subtle;
                                                    }

                                                    // ── Texto de la estrofa (tamaño fijo uniforme) ──
                                                    Rectangle {
                                                        vertical-stretch: 1; clip: true;
                                                        Text {
                                                            text: estrofa.texto;
                                                            color: idx == root.active_estrofa_index
                                                                ? white
                                                                : (touch-estrofa.has-hover ? Theme.text_primary : Theme.text_secondary);
                                                            font-size: root.active-tab == "biblias" ? 13.5px : 11.5px;
                                                            font-weight: 600;
                                                            wrap: word-wrap;
                                                            overflow: elide;
                                                            width: 100%; height: 100%;
                                                            vertical-alignment: top;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ── VISTA IMÁGENES (panel central) ──
                            if (root.active-tab == "imagenes") : Rectangle {
                                width: 100%; height: 100%; background: Theme.bg_main;
                                touch-central-media := TouchArea {
                                    clicked => { root.proyectar_multimedia(root.selected_media_idx); }
                                }
                                if (root.selected_media_idx >= 0 && root.selected_media_idx < root.multimedia_items.length) : VerticalLayout {
                                    Rectangle {
                                        vertical-stretch: 1; horizontal-stretch: 1; clip: true;
                                        Image {
                                            source: root.multimedia_items[root.selected_media_idx].img;
                                            width: 100%; height: 100%;
                                            image-fit: root.multimedia_items[root.selected_media_idx].aspecto == "rellenar" ? cover : (root.multimedia_items[root.selected_media_idx].aspecto == "estirar" ? fill : contain);
                                        }
                                        Rectangle {
                                            width: 175px; height: 32px; x: 10px; y: 10px;
                                            background: Theme.bg_card; border-radius: 6px; border-width: 1px; border-color: Theme.border_subtle;
                                            Text {
                                                text: root.multimedia_items[root.selected_media_idx].aspecto == "centro" ? "MODO: AJUSTAR AL CENTRO" : root.multimedia_items[root.selected_media_idx].aspecto == "rellenar" ? "MODO: RELLENAR PANTALLA" : "MODO: ESTIRAR";
                                                color: Theme.text_secondary; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                if (root.selected_media_idx == -1 || root.multimedia_items.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: "SELECCIONA UNA IMAGEN DE LA BIBLIOTECA"; color: Theme.text_muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                                }
                            }

                            // ── VISTA VIDEOS (panel central) ──
                            if (root.active-tab == "videos") : Rectangle {
                                width: 100%; height: 100%; background: Theme.bg_main;
                                if (root.selected_video_idx >= 0 && root.selected_video_idx < root.video_items.length) : VerticalLayout {
                                    padding: 16px; spacing: 12px;
                                    Rectangle {
                                        height: 45px; border-radius: 6px;
                                        background: root.is_video_projecting ? #c93636 : Theme.accent;
                                        TouchArea {
                                            clicked => {
                                                if (!root.is_video_projecting) { root.proyectar_video(root.selected_video_idx); }
                                            }
                                        }
                                        Text {
                                            text: root.is_video_projecting ? "🔴 VIDEO EN PROYECCIÓN" : "▶ PROYECTAR VIDEO";
                                            color: white; font-weight: 700; font-size: 14px;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        vertical-stretch: 1; horizontal-stretch: 1; clip: true; background: black; border-radius: 8px;
                                        Image { source: root.preview_video_frame; width: 100%; height: 100%; image-fit: contain; }
                                        TouchArea {
                                            clicked => { root.toggle_preview_video(root.selected_video_idx); }
                                            if (!root.is_preview_playing) : Rectangle {
                                                width: 60px; height: 60px; border-radius: 30px;
                                                background: rgba(0,0,0,0.6); border-width: 2px; border-color: rgba(255,255,255,0.2);
                                                x: (parent.width - 60px) / 2; y: (parent.height - 60px) / 2;
                                                Text { text: "▶"; color: white; font-size: 24px; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                    if (root.is_video_projecting) : HorizontalLayout {
                                        height: 40px; spacing: 16px; padding-left: 16px; padding-right: 16px;
                                        Rectangle {
                                            width: 40px; height: 40px; border-radius: 20px; background: Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle;
                                            TouchArea { clicked => { root.toggle_proyector_play(); } }
                                            Text { text: root.is_proyector_playing ? "⏸" : "▶"; color: Theme.text_primary; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            width: 40px; height: 40px; border-radius: 20px; background: Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle;
                                            TouchArea { clicked => { root.toggle_proyector_mute(); } }
                                            Text { text: root.is_proyector_muted ? "🔇" : "🔊"; color: Theme.text_primary; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            alignment: center; horizontal-stretch: 1;
                                            Rectangle {
                                                horizontal-stretch: 1; height: 12px; background: #d0d0d0; border-radius: 6px;
                                                Rectangle { x: 0; y: 0; width: parent.width * root.proyector_progress; height: 100%; background: Theme.accent; border-radius: 6px; }
                                                touch_progress := TouchArea {
                                                    width: 100%; height: 100%;
                                                    clicked => { root.seek_proyector_video(touch_progress.mouse-x / touch_progress.width); }
                                                }
                                            }
                                        }
                                        Text { text: root.proyector_time; color: Theme.text_secondary; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    }
                                }
                                if (root.selected_video_idx == -1 || root.video_items.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: "SELECCIONA UN VIDEO DE LA BIBLIOTECA"; color: Theme.text_muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                                }
                            }

                            // ── VISTA PDF (panel central) ──
                            if (root.active-tab == "pdf") : Rectangle {
                                width: 100%; height: 100%; background: Theme.bg_main;
                                if (root.pdf_pages.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: "SELECCIONA O AGREGA UN PDF"; color: Theme.text_muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
                                }
                                if (root.pdf_pages.length > 0) : ScrollView {
                                    GridLayout {
                                        padding: 16px; spacing: 16px;
                                        for page[idx] in root.pdf_pages : Rectangle {
                                            row: idx / 3; col: mod(idx, 3);
                                            height: 220px; border-radius: 8px; clip: true;
                                            border-width: 2px;
                                            border-color: idx == root.active_pdf_page ? #ef4444 : (touch-page.has-hover ? Theme.accent : Theme.border_subtle);
                                            Image { source: page; width: 100%; height: 100%; image-fit: contain; }
                                            touch-page := TouchArea { clicked => { root.proyectar_pdf_pagina(idx); } }
                                            
                                            // Indicador de número de página
                                            Rectangle {
                                                x: 8px; y: 8px; width: 28px; height: 28px; border-radius: 14px; 
                                                background: idx == root.active_pdf_page ? #ef4444 : rgba(0,0,0,0.8);
                                                Text { text: idx + 1; color: white; font-size: 11px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL MULTIMEDIA IMÁGENES (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_media) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        TouchArea {
            clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; }
        }
        Rectangle {
            x: root.menu_media_x; y: root.menu_media_y;
            width: 180px; height: root.menu_media_idx != -1 ? 150px : 40px;
            background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Agregar Imagen"; icon: "+"; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.agregar_multimedia(); } }
                if (root.menu_media_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_media_idx != -1) : VerticalLayout {
                    spacing: 2px;
                    MenuItem { text: "Aspecto de Imagen"; icon: "⛶"; has_submenu: true; clicked => { root.mostrar_submenu_aspecto = !root.mostrar_submenu_aspecto; } }
                    
                    // NUEVO BOTON PREDETERMINADO
                    MenuItem { text: "Fondo Predeterminado"; icon: "★"; text_color: #eab308; icon_color: #eab308; clicked => { root.default_bg_type = "imagen"; root.default_bg_idx = root.menu_media_idx; root.mostrar_menu_media = false; } }
                    
                    HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                    MenuItem { text: "Eliminar Imagen"; icon: ""; text_color: #f87171; icon_color: #f87171; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.eliminar_multimedia(root.menu_media_idx); } }
                }
            }
        }
        if (root.mostrar_submenu_aspecto && root.menu_media_idx != -1) : Rectangle {
            x: root.menu_media_x + 178px; y: root.menu_media_y + 36px;
            width: 170px; height: 106px;
            background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Ajustar al centro"; icon: "⛶"; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.cambiar_aspecto_multimedia(root.menu_media_idx, "centro"); } }
                MenuItem { text: "Rellenar pantalla"; icon: "⛶"; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.cambiar_aspecto_multimedia(root.menu_media_idx, "rellenar"); } }
                MenuItem { text: "Estirar"; icon: "T"; text_color: Theme.accent; icon_color: Theme.accent; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.cambiar_aspecto_multimedia(root.menu_media_idx, "estirar"); } }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL VIDEOS (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_video) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        TouchArea { clicked => { root.mostrar_menu_video = false; root.mostrar_submenu_reproduccion = false; } }
        if (root.mostrar_submenu_reproduccion && root.menu_video_idx != -1) : Rectangle {
            x: root.menu_video_x + 178px; y: root.menu_video_y + 35px;
            width: 160px; height: 72px;
            background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
            VerticalLayout {
                padding: 4px; spacing: 2px;
                Rectangle {
                    height: 30px; border-radius: 4px; background: touch_norm.has-hover ? Theme.bg_card_hover : transparent;
                    touch_norm := TouchArea { clicked => { root.cambiar_modo_reproduccion(root.menu_video_idx, "normal"); root.mostrar_submenu_reproduccion = false; root.mostrar_menu_video = false; } }
                    Text { text: "Normal (Una vez)"; color: Theme.text_primary; font-size: 13px; x: 12px; vertical-alignment: center; height: 100%; }
                }
                Rectangle {
                    height: 30px; border-radius: 4px; background: touch_loop.has-hover ? Theme.bg_card_hover : transparent;
                    touch_loop := TouchArea { clicked => { root.cambiar_modo_reproduccion(root.menu_video_idx, "bucle"); root.mostrar_submenu_reproduccion = false; root.mostrar_menu_video = false; } }
                    Text { text: "Bucle Infinito"; color: Theme.accent; font-size: 13px; font-weight: 700; x: 12px; vertical-alignment: center; height: 100%; }
                }
            }
        }
        Rectangle {
            x: root.menu_video_x; y: root.menu_video_y;
            width: 180px; height: root.menu_video_idx != -1 ? 146px : 40px;
            background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Agregar Video"; icon: "+"; clicked => { root.mostrar_menu_video = false; root.mostrar_submenu_reproduccion = false; root.agregar_video(); } }
                if (root.menu_video_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_video_idx != -1) : Rectangle {
                    height: 30px; border-radius: 4px; background: touch_rep.has-hover ? Theme.bg_card_hover : transparent;
                    touch_rep := TouchArea { clicked => { root.mostrar_submenu_reproduccion = !root.mostrar_submenu_reproduccion; } }
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; alignment: space-between;
                        Text { text: " Reproducción"; color: Theme.text_primary; font-size: 13px; vertical-alignment: center; }
                        Text { text: "›"; color: Theme.accent; font-size: 16px; vertical-alignment: center; font-weight: 700; }
                    }
                }
                
                // NUEVO BOTON PREDETERMINADO
                if (root.menu_video_idx != -1) : MenuItem { text: "Fondo Predeterminado"; icon: "★"; text_color: #eab308; icon_color: #eab308; clicked => { root.default_bg_type = "video"; root.default_bg_idx = root.menu_video_idx; root.mostrar_menu_video = false; } }
                
                if (root.menu_video_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_video_idx != -1) : MenuItem { text: "Eliminar Video"; icon: ""; text_color: #f87171; icon_color: #f87171; clicked => { root.mostrar_menu_video = false; root.mostrar_submenu_reproduccion = false; root.eliminar_video(root.menu_video_idx); } }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL DE PERSONALIZACIÓN (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════
    //  MODAL PERSONALIZACIÓN — diseño minimalista v2
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_personalizar) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        nm-backdrop := TouchArea { clicked => { root.mostrar_personalizar = false; } }

        Rectangle {
            width: 620px; height: 498px;
            background: Theme.bg_popup;
            border-radius: 14px;
            border-width: 2px; border-color: Theme.border_strong;
            nm-blocker := TouchArea {}

            property <string> current_gal_tab: "imagenes";

            VerticalLayout {
                // ── HEADER ─────────────────────────────────────────────────
                Rectangle {
                    height: 50px;
                    HorizontalLayout {
                        padding-left: 22px; padding-right: 14px; spacing: 0px;
                        Text { text: "PROYECCIÓN"; color: Theme.text_muted; font-size: 9px; font-weight: 900; letter-spacing: 2px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        // Pill tab switcher
                        Rectangle {
                            width: 160px; height: 30px; border-radius: 8px;
                            background: rgba(0,0,0,0.04); border-width: 1px; border-color: Theme.border_subtle;
                            HorizontalLayout { padding: 3px; spacing: 3px;
                                Rectangle { horizontal-stretch: 1; border-radius: 6px; background: root.modal_tab == "biblias" ? rgba(63,111,115,0.22) : transparent; nm-t1 := TouchArea { clicked => { root.modal_tab = "biblias"; } } Text { text: "BIBLIA"; color: root.modal_tab == "biblias" ? #38bdf8 : Theme.text_secondary; font-size: 9px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Rectangle { horizontal-stretch: 1; border-radius: 6px; background: root.modal_tab == "cantos" ? rgba(63,111,115,0.22) : transparent; nm-t2 := TouchArea { clicked => { root.modal_tab = "cantos"; } } Text { text: "CANTO"; color: root.modal_tab == "cantos" ? #38bdf8 : Theme.text_secondary; font-size: 9px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                            }
                        }
                        Rectangle { width: 10px; }
                        // Close
                        Rectangle { width: 30px; height: 30px; border-radius: 8px; background: nm-close.has-hover ? rgba(0,0,0,0.06) : transparent; nm-close := TouchArea { clicked => { root.mostrar_personalizar = false; } } Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                }
                Rectangle { height: 1px; background: rgba(0,0,0,0.05); }

// ── FUENTE (GLOBAL: aplica igual a biblia y canto) ──────────
Rectangle {
    height: 54px;
    HorizontalLayout {
        padding-left: 22px; padding-right: 22px; spacing: 12px;
        Text {
            text: "FUENTE"; color: Theme.text_muted; font-size: 10px;
            font-weight: 900; letter-spacing: 2px; vertical-alignment: center;
        }
        ComboBox {
    width: 180px; height: 30px;
    model: root.fuentes_disponibles;
    current-value: root.proyeccion_font_family;
    selected(val) => {
        root.proyeccion_font_family = val;
        root.cambiar_fuente_proyeccion(val);
    }
}
        Rectangle { horizontal-stretch: 1; }
    }
}
Rectangle { height: 1px; background: rgba(0,0,0,0.05); }

// ── CONTENT ────────────────────────────────────────────────
Rectangle {
    vertical-stretch: 1;

                    // ═══ BIBLIA TAB ═════════════════════════════════════════
                    if (root.modal_tab == "biblias") : VerticalLayout {
                        padding-left: 22px; padding-right: 22px; padding-top: 18px; padding-bottom: 16px; spacing: 0px;

                        // — FONDO —
                        Text { text: "FONDO"; color: Theme.text_muted; font-size: 10px; font-weight: 900; letter-spacing: 2px; }
                        Rectangle { height: 10px; }
                        HorizontalLayout { spacing: 0px; alignment: space-between;
                            // BG type pills
                            HorizontalLayout { spacing: 6px; alignment: start;
                                Rectangle { width: 44px; height: 32px; border-radius: 7px; background: #000000; border-width: 2px; border-color: root.biblias_bg_type == "negro" ? Theme.accent : rgba(255,255,255,0.15); nm-bbn := TouchArea { clicked => { root.biblias_bg_type = "negro"; root.sync_estilos(); } } }
                               Rectangle { width: 44px; height: 32px; border-radius: 7px; background: #ffffff; border-width: 2px; border-color: root.biblias_bg_type == "blanco" ? Theme.accent : rgba(0,0,0,0.15); nm-bbb := TouchArea { clicked => { root.biblias_bg_type = "blanco"; root.sync_estilos(); } } }
                                Rectangle { width: 66px; height: 32px; border-radius: 7px; background: root.biblias_bg_type == "imagen" ? Theme.accent_soft : rgba(0,0,0,0.03); border-width: 1px; border-color: root.biblias_bg_type == "imagen" ? Theme.accent : rgba(0,0,0,0.06); nm-bbi := TouchArea { clicked => { root.biblias_bg_type = "imagen"; root.sync_estilos(); } } Text { text: "Imagen"; font-size: 11px; font-weight: 700; color: root.biblias_bg_type == "imagen" ? #38bdf8 : Theme.text_secondary; horizontal-alignment: center; vertical-alignment: center; }  }
                                Rectangle { width: 62px; height: 32px; border-radius: 7px; background: root.biblias_bg_type == "video" ? Theme.accent_soft : rgba(0,0,0,0.03); border-width: 1px; border-color: root.biblias_bg_type == "video" ? Theme.accent : rgba(0,0,0,0.06); nm-bbv := TouchArea { clicked => { root.biblias_bg_type = "video"; root.sync_estilos(); } } Text { text: "Video"; font-size: 9px; font-weight: 700; color: root.biblias_bg_type == "video" ? #38bdf8 : Theme.text_secondary; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                            // Opacity inline
                            HorizontalLayout { spacing: 8px; alignment: end;
                                Text { text: "Opacidad"; color: Theme.text_muted; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                Slider { width: 100px; minimum: 0.0; maximum: 1.0; value <=> root.biblias_fondo_opacity; changed => { root.sync_estilos(); } }
                                Text { text: round(root.biblias_fondo_opacity * 100) + "%"; color: Theme.text_secondary; font-size: 9px; font-weight: 700; vertical-alignment: center; min-width: 30px; }
                            }
                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 1px; background: rgba(0,0,0,0.04); }
                        Rectangle { height: 16px; }

                        // — TEXTO —
                        HorizontalLayout { spacing: 0px; alignment: space-between;
                            VerticalLayout { spacing: 8px; alignment: start;
                                Text { text: "TEXTO"; color: Theme.text_muted; font-size: 10px; font-weight: 900; letter-spacing: 2px; }
                                HorizontalLayout { spacing: 5px; alignment: start;
                                    // White
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #ffffff ? rgba(63,111,115,0.18) : transparent; border-width: 2px; border-color: root.biblias_font_color == #ffffff ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #ffffff; border-width: 1px; border-color: rgba(0,0,0,0.08); } nm-bfc0 := TouchArea { clicked => { root.biblias_font_color = #ffffff; root.sync_estilos(); } } }
                                    // Black
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #000000 ? rgba(63,111,115,0.18) : transparent; border-width: 2px; border-color: root.biblias_font_color == #000000 ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #000000; border-width: 1px; border-color: Theme.border_subtle; } nm-bfc1 := TouchArea { clicked => { root.biblias_font_color = #000000; root.sync_estilos(); } } }
                                    // Amarillo
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #fef08a ? rgba(63,111,115,0.18) : transparent; border-width: 2px; border-color: root.biblias_font_color == #fef08a ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #fef08a; } nm-bfc2 := TouchArea { clicked => { root.biblias_font_color = #fef08a; root.sync_estilos(); } } }
                                    // Verde
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #86efac ? rgba(63,111,115,0.18) : transparent; border-width: 2px; border-color: root.biblias_font_color == #86efac ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #86efac; } nm-bfc3 := TouchArea { clicked => { root.biblias_font_color = #86efac; root.sync_estilos(); } } }
                                    // Azul
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #93c5fd ? rgba(63,111,115,0.18) : transparent; border-width: 2px; border-color: root.biblias_font_color == #93c5fd ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #93c5fd; } nm-bfc4 := TouchArea { clicked => { root.biblias_font_color = #93c5fd; root.sync_estilos(); } } }
                                    // Coral
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #fca5a5 ? rgba(63,111,115,0.18) : transparent; border-width: 2px; border-color: root.biblias_font_color == #fca5a5 ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #fca5a5; } nm-bfc5 := TouchArea { clicked => { root.biblias_font_color = #fca5a5; root.sync_estilos(); } } }
                                    // Lila
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #d8b4fe ? rgba(63,111,115,0.18) : transparent; border-width: 2px; border-color: root.biblias_font_color == #d8b4fe ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #d8b4fe; } nm-bfc6 := TouchArea { clicked => { root.biblias_font_color = #d8b4fe; root.sync_estilos(); } } }
                                    // Más colores
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: rgba(0,0,0,0.04); border-width: 1px; border-color: Theme.border_subtle; nm-bfcc := TouchArea { clicked => { root.color_target = "biblias"; root.mostrar_selector_color = true; } } Text { text: "+"; color: Theme.text_secondary; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                                }
                            }
                            // Tamaño de letra
                            VerticalLayout { spacing: 8px; alignment: start; horizontal-stretch: 0;
                                Text { text: "TAMAÑO"; color: Theme.text_muted; font-size: 10px; font-weight: 900; letter-spacing: 2px; }
                                HorizontalLayout { spacing: 4px; alignment: start;
                                    Rectangle { width: 30px; height: 28px; border-radius: 6px; background: nm-bsm.has-hover ? rgba(0,0,0,0.07) : rgba(0,0,0,0.03); border-width: 1px; border-color: Theme.border_subtle; nm-bsm := TouchArea { clicked => { root.biblias_font_scale = max(0.5, root.biblias_font_scale - 0.1); root.sync_font_scale(); } } Text { text: "−"; color: Theme.text_secondary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }
                                    Rectangle { width: 52px; height: 28px; border-radius: 6px; background: rgba(0,0,0,0.02); border-width: 1px; border-color: Theme.border_subtle; Text { text: round(root.biblias_font_scale * 100) + "%"; color: Theme.text_secondary; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                    Rectangle { width: 30px; height: 28px; border-radius: 6px; background: nm-bsp.has-hover ? rgba(0,0,0,0.07) : rgba(0,0,0,0.03); border-width: 1px; border-color: Theme.border_subtle; nm-bsp := TouchArea { clicked => { root.biblias_font_scale = min(2.0, root.biblias_font_scale + 0.1); root.sync_font_scale(); } } Text { text: "+"; color: Theme.text_secondary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }
                                }
                            }
                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 1px; background: rgba(0,0,0,0.04); }
                        Rectangle { height: 14px; }

                        // — GALERÍA —
                        HorizontalLayout { alignment: space-between;
                            Text { text: "GALERÍA"; color: Theme.text_muted; font-size: 10px; font-weight: 900; letter-spacing: 2px; vertical-alignment: center; }
                            HorizontalLayout { spacing: 0px;
                                Rectangle { width: 80px; height: 24px; border-top-left-radius: 6px; border-bottom-left-radius: 6px; background: current_gal_tab == "imagenes" ? Theme.accent_soft : rgba(0,0,0,0.02); border-width: 1px; border-color: current_gal_tab == "imagenes" ? Theme.accent : rgba(0,0,0,0.05); nm-bgi := TouchArea { clicked => { current_gal_tab = "imagenes"; } } Text { text: "Imágenes"; color: current_gal_tab == "imagenes" ? #38bdf8 : Theme.text_secondary; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Rectangle { width: 70px; height: 24px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; background: current_gal_tab == "videos" ? Theme.accent_soft : rgba(0,0,0,0.02); border-width: 1px; border-color: current_gal_tab == "videos" ? Theme.accent : rgba(0,0,0,0.05); nm-bgv := TouchArea { clicked => { current_gal_tab = "videos"; } } Text { text: "Videos"; color: current_gal_tab == "videos" ? #38bdf8 : Theme.text_secondary; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                            }
                        }
                        Rectangle { height: 10px; }

                        Rectangle {
                            vertical-stretch: 1; border-radius: 8px; clip: true;
                            if (current_gal_tab == "imagenes") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 1px; border-color: Theme.border_subtle; background: nm-bagi.has-hover ? rgba(0,0,0,0.05) : rgba(0,0,0,0.02); nm-bagi := TouchArea { clicked => { root.agregar_a_galeria("biblias-img"); } } VerticalLayout { alignment: center; spacing: 3px; Text { text: "+"; color: Theme.text_muted; font-size: 20px; horizontal-alignment: center; } Text { text: "Agregar"; color: Theme.text_muted; font-size: 8px; horizontal-alignment: center; font-weight: 700; } } }
                                    for img[idx] in root.biblias_image_data : Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 2px; border-color: root.biblias_selected_img == idx ? Theme.accent : rgba(0,0,0,0.04); clip: true; Image { source: img; width: 100%; height: 100%; image-fit: cover; } TouchArea { clicked => { root.seleccionar_galeria_item("biblias-img", idx); } } Rectangle { width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: 8px; background: rgba(0,0,0,0.75); TouchArea { clicked => { root.eliminar_galeria_item("biblias-img", idx); } } Text { text: "✕"; color: #f87171; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: 900; } } }
                                }
                            }
                            if (current_gal_tab == "videos") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 1px; border-color: Theme.border_subtle; background: nm-bagv.has-hover ? rgba(0,0,0,0.05) : rgba(0,0,0,0.02); nm-bagv := TouchArea { clicked => { root.agregar_a_galeria("biblias-vid"); } } VerticalLayout { alignment: center; spacing: 3px; Text { text: "+"; color: Theme.text_muted; font-size: 20px; horizontal-alignment: center; } Text { text: "Agregar"; color: Theme.text_muted; font-size: 8px; horizontal-alignment: center; font-weight: 700; } } }
                                    for vid[idx] in root.biblias_video_names : Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 2px; background: #080808; border-color: root.biblias_selected_vid == idx ? Theme.accent : rgba(0,0,0,0.04); VerticalLayout { padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 6px; alignment: center; spacing: 4px; Rectangle { height: 14px; background: rgba(0,0,0,0.04); border-radius: 3px; Text { text: "MP4"; font-size: 6px; font-weight: 900; color: Theme.text_muted; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } } Text { text: vid; font-size: 7px; color: Theme.text_secondary; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; } } TouchArea { clicked => { root.seleccionar_galeria_item("biblias-vid", idx); } } Rectangle { width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: 8px; background: rgba(0,0,0,0.75); TouchArea { clicked => { root.eliminar_galeria_item("biblias-vid", idx); } } Text { text: "✕"; color: #f87171; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: 900; } } }
                                }
