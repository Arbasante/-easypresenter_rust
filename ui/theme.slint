    out property <color> accent_hover: root.is_black ? BlackPalette.accent_hover : (root.is_dark ? NavyPalette.accent_hover : LightPalette.accent_hover);
    out property <color> accent_soft: root.is_black ? BlackPalette.accent_soft : (root.is_dark ? NavyPalette.accent_soft : LightPalette.accent_soft);
    out property <color> warning: root.is_black ? BlackPalette.accent_amber : (root.is_dark ? NavyPalette.accent_amber : LightPalette.accent_amber);
    out property <color> warning_soft: root.is_black ? BlackPalette.warning_soft : (root.is_dark ? NavyPalette.warning_soft : LightPalette.warning_soft);
    out property <color> menu_hover: root.is_black ? BlackPalette.menu_hover : (root.is_dark ? NavyPalette.menu_hover : LightPalette.menu_hover);
    out property <color> menu_text: root.is_black ? BlackPalette.text_menu : (root.is_dark ? NavyPalette.text_menu : LightPalette.text_menu);
    out property <color> menu_icon: root.is_black ? BlackPalette.text_menu : (root.is_dark ? NavyPalette.text_menu : LightPalette.text_menu);
    out property <color> list_hover: root.is_black ? BlackPalette.list_hover : (root.is_dark ? NavyPalette.list_hover : LightPalette.list_hover);
    out property <color> success: root.is_black ? BlackPalette.success : (root.is_dark ? NavyPalette.success : LightPalette.success);
    out property <color> success_fill: root.is_black ? BlackPalette.success_fill : (root.is_dark ? NavyPalette.success_fill : LightPalette.success_fill);
    out property <color> success_soft: root.is_black ? BlackPalette.success_soft : (root.is_dark ? NavyPalette.success_soft : LightPalette.success_soft);
    out property <color> danger: root.is_black ? BlackPalette.danger : (root.is_dark ? NavyPalette.danger : LightPalette.danger);
    out property <color> danger_fill: root.is_black ? BlackPalette.danger_fill : (root.is_dark ? NavyPalette.danger_fill : LightPalette.danger_fill);
    out property <color> danger_hover: root.is_black ? BlackPalette.danger_hover : (root.is_dark ? NavyPalette.danger_hover : LightPalette.danger_hover);
    out property <color> danger_soft: root.is_black ? BlackPalette.danger_soft : (root.is_dark ? NavyPalette.danger_soft : LightPalette.danger_soft);
    out property <color> disabled_fill: root.is_black ? BlackPalette.disabled_fill : (root.is_dark ? NavyPalette.disabled_fill : LightPalette.disabled_fill);
    out property <color> icon_settings: root.is_black ? BlackPalette.icon_settings : (root.is_dark ? NavyPalette.icon_settings : LightPalette.icon_settings);
    out property <color> scroll_thumb: root.is_black ? BlackPalette.scroll_thumb : (root.is_dark ? NavyPalette.scroll_thumb : LightPalette.scroll_thumb);
    out property <color> overlay: root.is_black ? BlackPalette.overlay : (root.is_dark ? NavyPalette.overlay : LightPalette.overlay);
    out property <color> shadow: root.is_black ? BlackPalette.shadow : (root.is_dark ? NavyPalette.shadow : LightPalette.shadow);
    out property <color> media_overlay: root.is_black ? BlackPalette.media_overlay : (root.is_dark ? NavyPalette.media_overlay : LightPalette.media_overlay);
    out property <color> media_hover: root.is_black ? BlackPalette.media_hover : (root.is_dark ? NavyPalette.media_hover : LightPalette.media_hover);
    out property <color> media_text: root.is_black ? BlackPalette.media_text : (root.is_dark ? NavyPalette.media_text : LightPalette.media_text);
    out property <color> media_muted: root.is_black ? BlackPalette.media_muted : (root.is_dark ? NavyPalette.media_muted : LightPalette.media_muted);
    out property <color> media_border: root.is_black ? BlackPalette.media_border : (root.is_dark ? NavyPalette.media_border : LightPalette.media_border);
    out property <brush> surface_main: root.bg_main;
    out property <brush> surface_sidebar: root.bg_sidebar;
    out property <brush> surface_topbar: root.bg_topbar;
    out property <brush> surface_list: root.bg_list;
    out property <brush> surface_card: root.bg_card;
    out property <brush> surface_popup: root.bg_popup;
    out property <brush> surface_input: root.bg_input;

    out property <length> radius_control: 6px;
    out property <length> radius_surface: 8px;
    out property <length> radius_modal: 12px;
    out property <length> popup_shadow_blur: 18px;
    out property <length> popup_shadow_offset: 4px;
    out property <int> font_weight_body: 500;
    out property <int> font_weight_heading: 700;

}
