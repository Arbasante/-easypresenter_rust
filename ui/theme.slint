// Paletas reactivas de la interfaz; sólo contienen valores de color.
// Los tonos de texto y los rellenos con texto blanco se ajustan para WCAG AA.
// Los colores de proyección elegidos por el usuario son independientes del tema.
export global BlackPalette {
    out property <color> bg_list: #0a0a0a;
    out property <color> bg_sidebar: #121212;
    out property <color> bg_main: #1a1a1a;
    out property <color> bg_panel_right: #1a1a1a;
    out property <color> bg_input: #232323;
    out property <color> bg_titlebar: #2b2b2b;
    out property <color> border_main: #2a2a2a;
    out property <color> border_input: #3a3a3a;
    out property <color> border_list_item: #1f1f1f;
    out property <color> border_dashed: #333333;
    out property <color> text_primary: #ffffff;
    out property <color> text_list: #e8e8e8;
    out property <color> text_menu: #b5b5b5;
    out property <color> text_header: #969696;
    out property <color> text_section: #929fab;
    out property <color> text_placeholder: #969696;
    out property <color> text_muted: #969696;
    out property <color> text_empty: #878787;
    out property <color> accent_amber: #e69a1a;
    out property <color> icon_settings: #8a8a8a;
    out property <color> accent_text: #65b5f3;
    out property <color> accent_hover: #006cbe;
    out property <color> accent_soft: #102c40;
    out property <color> menu_hover: #212121;
    out property <color> list_hover: #191919;
    out property <color> panel_hover: #292929;
    out property <color> success: #91c9ad;
    out property <color> danger: #f1a6a0;
    out property <color> warning_soft: #302516;
    out property <color> danger_soft: #38201e;
    out property <color> success_soft: #1c3026;
    out property <color> overlay: rgba(0,0,0,0.76);
    out property <color> shadow: rgba(0,0,0,0.55);
    out property <color> bg_preview: #000000;
    out property <color> text_on_accent: #ffffff;
    out property <color> bg_hover: #292929;
    out property <color> accent: #0078d4;
    out property <color> accent_icon: #1e90e0;
    out property <color> scroll_thumb: #3a3a3a;
    out property <color> success_fill: #18794e;
    out property <color> danger_fill: #b42318;
    out property <color> danger_hover: #912018;
    out property <color> disabled_fill: #3a3a3a;
    out property <color> media_overlay: #121212;
    out property <color> media_hover: #292929;
    out property <color> media_text: #ffffff;
    out property <color> media_muted: #b5b5b5;
    out property <color> media_border: #3a3a3a;
}

