                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 1px; background: rgba(0,0,0,0.04); }
                        Rectangle { height: 14px; }

                        HorizontalLayout { alignment: space-between;
                            Text { text: "GALERÍA"; color: Theme.text_muted; font-size: 10px; font-weight: 900; letter-spacing: 2px; vertical-alignment: center; }
                            HorizontalLayout { spacing: 0px;
                                Rectangle { width: 80px; height: 24px; border-top-left-radius: 6px; border-bottom-left-radius: 6px; background: current_gal_tab == "imagenes" ? Theme.accent_soft : rgba(0,0,0,0.02); border-width: 1px; border-color: current_gal_tab == "imagenes" ? Theme.accent : rgba(0,0,0,0.05); nm-cgi := TouchArea { clicked => { current_gal_tab = "imagenes"; } } Text { text: "Imágenes"; color: current_gal_tab == "imagenes" ? #38bdf8 : Theme.text_secondary; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Rectangle { width: 70px; height: 24px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; background: current_gal_tab == "videos" ? Theme.accent_soft : rgba(0,0,0,0.02); border-width: 1px; border-color: current_gal_tab == "videos" ? Theme.accent : rgba(0,0,0,0.05); nm-cgv := TouchArea { clicked => { current_gal_tab = "videos"; } } Text { text: "Videos"; color: current_gal_tab == "videos" ? #38bdf8 : Theme.text_secondary; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                            }
                        }
                        Rectangle { height: 10px; }

                        Rectangle {
                            vertical-stretch: 1; border-radius: 8px; clip: true;
                            if (current_gal_tab == "imagenes") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 1px; border-color: Theme.border_subtle; background: nm-cagi.has-hover ? rgba(0,0,0,0.05) : rgba(0,0,0,0.02); nm-cagi := TouchArea { clicked => { root.agregar_a_galeria("cantos-img"); } } VerticalLayout { alignment: center; spacing: 3px; Text { text: "+"; color: Theme.text_muted; font-size: 20px; horizontal-alignment: center; } Text { text: "Agregar"; color: Theme.text_muted; font-size: 8px; horizontal-alignment: center; font-weight: 700; } } }
                                    for img[idx] in root.cantos_image_data : Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 2px; border-color: root.cantos_selected_img == idx ? Theme.accent : rgba(0,0,0,0.04); clip: true; Image { source: img; width: 100%; height: 100%; image-fit: cover; } TouchArea { clicked => { root.seleccionar_galeria_item("cantos-img", idx); } } Rectangle { width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: 8px; background: rgba(0,0,0,0.75); TouchArea { clicked => { root.eliminar_galeria_item("cantos-img", idx); } } Text { text: "✕"; color: #f87171; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: 900; } } }
                                }
                            }
                            if (current_gal_tab == "videos") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 1px; border-color: Theme.border_subtle; background: nm-cagv.has-hover ? rgba(0,0,0,0.05) : rgba(0,0,0,0.02); nm-cagv := TouchArea { clicked => { root.agregar_a_galeria("cantos-vid"); } } VerticalLayout { alignment: center; spacing: 3px; Text { text: "+"; color: Theme.text_muted; font-size: 20px; horizontal-alignment: center; } Text { text: "Agregar"; color: Theme.text_muted; font-size: 8px; horizontal-alignment: center; font-weight: 700; } } }
                                    for vid[idx] in root.cantos_video_names : Rectangle { width: 92px; height: 64px; border-radius: 8px; border-width: 2px; background: #080808; border-color: root.cantos_selected_vid == idx ? Theme.accent : rgba(0,0,0,0.04); VerticalLayout { padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 6px; alignment: center; spacing: 4px; Rectangle { height: 14px; background: rgba(0,0,0,0.04); border-radius: 3px; Text { text: "MP4"; font-size: 6px; font-weight: 900; color: Theme.text_muted; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } } Text { text: vid; font-size: 7px; color: Theme.text_secondary; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; } } TouchArea { clicked => { root.seleccionar_galeria_item("cantos-vid", idx); } } Rectangle { width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: 8px; background: rgba(0,0,0,0.75); TouchArea { clicked => { root.eliminar_galeria_item("cantos-vid", idx); } } Text { text: "✕"; color: #f87171; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: 900; } } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    in-out property <bool> mostrar_menu_configuracion: false;
    in-out property <length> menu_configuracion_x: 0px;
    in-out property <length> menu_configuracion_y: 0px;

    in-out property <bool> mostrar_menu_herramientas: false;
    in-out property <length> menu_herramientas_x: 0px;
    in-out property <length> menu_herramientas_y: 0px;

    in-out property <bool> mostrar_menu_ayuda: false;
    in-out property <length> menu_ayuda_x: 0px;
    in-out property <length> menu_ayuda_y: 0px;

    in-out property <bool> mostrar_acerca_de: false;
    in-out property <string> acerca_version: "";
    in-out property <string> acerca_aceleracion: "";

    in-out property <bool> libreoffice_listo: false;
    in-out property <bool> instalando_libreoffice: false;
    in-out property <float> libreoffice_progreso: 0.0;
    in-out property <string> libreoffice_error: "";
    callback activar_soporte_pptx();
    in-out property <string> aviso_mensaje: "";

    // ══════════════════════════════════════════════════════════════
//  MENÚ DESPLEGABLE: CONFIGURACIÓN (Proyector + Tema)
// ══════════════════════════════════════════════════════════════
if (root.mostrar_menu_configuracion) : Rectangle {
    width: 100%; height: 100%; background: transparent;
    TouchArea { clicked => { root.mostrar_menu_configuracion = false; } }
    Rectangle {
        x: root.menu_configuracion_x; y: root.menu_configuracion_y;
        width: 160px; height: 110px;
        background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
        TouchArea {}
        VerticalLayout {
            padding: 4px; spacing: 2px;
            MenuItem {
                text: "Proyector"; icon: "";
                clicked => { root.mostrar_menu_configuracion = false; root.mostrar_modal_margenes = true; }
            }
            MenuItem {
                text: "Pantallas"; icon: "";
                clicked => {
                    root.mostrar_menu_configuracion = false;
                    root.mostrar_modal_pantallas = true;
                    root.abrir_modal_pantallas();
                }
            }
            MenuItem {
                text: "Tema"; icon: "";
                clicked => {
                    root.mostrar_menu_configuracion = false;
                    Theme.is_dark = !Theme.is_dark;
                    root.notificar_cambio_tema(Theme.is_dark);
                }
            }
        }
    }
}

// ══════════════════════════════════════════════════════════════
//  MENÚ DESPLEGABLE: HERRAMIENTAS (Importar/Exportar)
// ══════════════════════════════════════════════════════════════
if (root.mostrar_menu_herramientas) : Rectangle {
    width: 100%; height: 100%; background: transparent;
    TouchArea { clicked => { root.mostrar_menu_herramientas = false; } }
    Rectangle {
        x: root.menu_herramientas_x; y: root.menu_herramientas_y;
        width: 200px; height: 110px;
        background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
        TouchArea {}
        VerticalLayout {
            padding: 4px; spacing: 2px;
            MenuItem {
                text: "Importar/Exportar"; icon: "";
                clicked => {
                    root.mostrar_menu_herramientas = false;
                }
            }
            
            MenuItem {
                text: "Salida por IP (OBS)"; icon: "";
                clicked => {
                    root.mostrar_menu_herramientas = false;
                    root.mostrar_modal_overlay = true;
                    root.abrir_modal_overlay();
                }
            }

            MenuItem {
                text: root.libreoffice_listo ? "PPTX/ODP: Activado" : "Activar PPTX/ODP";
                icon: root.libreoffice_listo ? "" : "";
                text_color: root.libreoffice_listo ? #22c55e : Theme.menu_text;
                icon_color: root.libreoffice_listo ? #22c55e : Theme.menu_icon;
                clicked => {
                    root.mostrar_menu_herramientas = false;
                    if (!root.libreoffice_listo) {
                        root.activar_soporte_pptx();
                    }
                }
            }
        }
    }
}


// ══════════════════════════════════════════════════════════════
//  MENÚ DESPLEGABLE: AYUDA
// ══════════════════════════════════════════════════════════════
if (root.mostrar_menu_ayuda) : Rectangle {
    width: 100%; height: 100%; background: transparent;
    TouchArea { clicked => { root.mostrar_menu_ayuda = false; } }
    Rectangle {
        x: root.menu_ayuda_x; y: root.menu_ayuda_y;
        width: 170px; height: 40px;
        background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
        TouchArea {}
        VerticalLayout {
            padding: 4px; spacing: 2px;
            MenuItem {
                text: "Acerca de"; icon: "";
                clicked => {
                    root.mostrar_menu_ayuda = false;
                    root.mostrar_acerca_de = true;
                }
            }
        }
    }
}
// ══════════════════════════════════════════════════════════════
//  MODAL: ACERCA DE
// ══════════════════════════════════════════════════════════════
if (root.mostrar_acerca_de) : Rectangle {
    width: 100%; height: 100%; background: Theme.overlay;
    TouchArea { clicked => { root.mostrar_acerca_de = false; } }

    Rectangle {
        width: 520px; height: 560px;
        background: Theme.bg_popup; border-radius: 14px;
        border-width: 2px; border-color: Theme.border_strong;
        TouchArea {}

        VerticalLayout {
            // ── Header ───────────────────────────────────────────────
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 26px; padding-right: 14px;
                    Text { text: "ACERCA DE"; color: Theme.text_muted; font-size: 10px; font-weight: 900; letter-spacing: 2px; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle {
                        width: 32px; height: 32px; border-radius: 8px;
                        background: touch-close-acerca.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-acerca := TouchArea { clicked => { root.mostrar_acerca_de = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.separator; }

            // ── Contenido ────────────────────────────────────────────
            VerticalLayout {
                vertical-stretch: 1;
                padding-left: 32px; padding-right: 32px;
                padding-top: 28px; padding-bottom: 28px;
                spacing: 0px;

                // Nombre y versión, centrados y con más aire
                VerticalLayout {
                    alignment: center; spacing: 8px;
                    Text { text: "ReadyShow"; color: Theme.accent; font-size: 30px; font-weight: 900; horizontal-alignment: center; }
                    Rectangle {
                        width: 90px; height: 26px; border-radius: 13px;
                        background: Theme.accent_soft;
                        Text {
                            text: "Versión " + root.acerca_version;
                            color: Theme.accent; font-size: 11px; font-weight: 800;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                    }
                }

                Rectangle { height: 26px; }

                // Estado de aceleración — más aire y texto más grande
                Rectangle {
                    height: 58px; border-radius: 10px;
                    background: Theme.bg_list; border-width: 1px; border-color: Theme.border_subtle;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 12px;
                        Rectangle {
                            width: 32px; height: 32px; border-radius: 16px;
                            background: Theme.accent_soft;
                            Text { text: "⚙"; color: Theme.accent; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                        Text {
                            text: root.acerca_aceleracion;
                            color: Theme.text_secondary; font-size: 11px; font-weight: 700;
                            wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle { height: 24px; }

                // Licencia — ocupa el espacio restante, con buen padding interno
                Text { text: "LICENCIA MIT"; color: Theme.text_muted; font-size: 10px; font-weight: 900; letter-spacing: 1.5px; height: 18px; }
                Rectangle { height: 8px; }
                Rectangle {
                    vertical-stretch: 1; border-radius: 10px;
                    background: Theme.bg_list; border-width: 1px; border-color: Theme.border_subtle;
                    clip: true;
                    ScrollView {
                        VerticalLayout {
                            padding: 18px;
                            Text {
                                text: "Copyright © 2025 Arbasante\n\nSe concede permiso, de forma gratuita, a cualquier persona que obtenga una copia de este software y de los archivos de documentación asociados, para utilizar el software sin restricción, incluyendo, sin limitación, los derechos de uso, copia, modificación, fusión, publicación, distribución, sublicencia y/o venta de copias del software, y a permitir a las personas a quienes se les proporcione el software hacerlo, sujeto a las siguientes condiciones:\n\nEl aviso de copyright anterior y este aviso de permiso se incluirán en todas las copias o partes sustanciales del software.\n\nEl software se proporciona \"tal cual\", sin garantía de ningún tipo, expresa o implícita, incluyendo pero sin limitarse a las garantías de comerciabilidad, idoneidad para un propósito particular y no infracción.";
                                color: Theme.text_secondary; font-size: 11px; wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}


    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL DE CANTO (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_canto) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        touch-dismiss := TouchArea { clicked => { root.mostrar_menu_canto = false; } }
        Rectangle {
            x: root.menu_x; y: root.menu_y;
            width: 185px; height: 114px;
            background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
            touch-block := TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 0px;
                Rectangle { height: 34px; border-radius: 6px; background: touch-add.has-hover ? rgba(63,111,115,0.15) : transparent; touch-add := TouchArea { clicked => { root.mostrar_menu_canto = false; root.abrir_formulario_nuevo(); } } HorizontalLayout { padding-left: 12px; spacing: 10px; Text { text: "+"; color: Theme.accent; font-size: 15px; font-weight: 900; vertical-alignment: center; } Text { text: "Agregar canto"; color: Theme.text_primary; font-size: 11px; font-weight: 600; vertical-alignment: center; } } }
                Rectangle { height: 34px; border-radius: 6px; background: touch-edit.has-hover ? rgba(63,111,115,0.15) : transparent; touch-edit := TouchArea { clicked => { root.mostrar_menu_canto = false; root.abrir_formulario_editar(root.menu_canto_id, root.menu_canto_titulo); } } HorizontalLayout { padding-left: 12px; spacing: 10px; Text { text: "✎"; color: Theme.text_secondary; font-size: 13px; vertical-alignment: center; } Text { text: "Editar canto"; color: Theme.text_primary; font-size: 11px; font-weight: 600; vertical-alignment: center; } } }
                Rectangle { height: 1px; background: Theme.separator; }
                Rectangle { height: 34px; border-radius: 6px; background: touch-del.has-hover ? rgba(220, 38, 38, 0.15) : transparent; touch-del := TouchArea { clicked => { root.mostrar_menu_canto = false; root.confirmar_eliminar_canto(root.menu_canto_id, root.menu_canto_titulo); } } HorizontalLayout { padding-left: 12px; spacing: 10px; Text { text: "✕"; color: #f87171; font-size: 12px; font-weight: 900; vertical-alignment: center; } Text { text: "Eliminar canto"; color: #f87171; font-size: 11px; font-weight: 600; vertical-alignment: center; } } }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL SELECTOR DE COLOR (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_selector_color) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        touch-bg-color := TouchArea { clicked => { root.mostrar_selector_color = false; } }
        Rectangle {
            width: 330px; height: 210px;
            background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
            touch-block-color := TouchArea {}
            VerticalLayout {
                padding: 16px; spacing: 16px;
                HorizontalLayout {
                    Text { text: "  Seleccionar Color"; color: Theme.text_primary; font-weight: 800; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle { width: 24px; height: 24px; border-radius: 4px; background: touch-close-col.has-hover ? Theme.bg_card_hover : transparent; touch-close-col := TouchArea { clicked => { root.mostrar_selector_color = false; } } Text { text: "✕"; color: Theme.text_secondary; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
                }
                VerticalLayout {
                    spacing: 8px; alignment: center;
                    for row in root.paleta_colores : HorizontalLayout {
                        spacing: 8px; alignment: center;
                        for c in row : Rectangle {
                            width: 28px; height: 28px; border-radius: 6px; background: c;
                            border-width: 1px; border-color: Theme.border_subtle;
                            touch-c := TouchArea {
                                clicked => {
                                    if (root.color_target == "biblias") { root.biblias_custom_color = c; root.biblias_font_color = c; }
                                    else { root.cantos_custom_color = c; root.cantos_font_color = c; }
                                    root.sync_estilos(); root.mostrar_selector_color = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL CONFIRMACIÓN ELIMINAR (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_confirmar_eliminar) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        touch-bg-elim := TouchArea { clicked => { root.mostrar_confirmar_eliminar = false; } }
        Rectangle {
            width: 360px; height: 170px;
            background: Theme.bg_popup; border-radius: 12px; border-width: 2px; border-color: Theme.border_strong;
            touch-block-elim := TouchArea {}
            VerticalLayout {
                padding: 28px; spacing: 14px;
                Text { text: "Eliminar canto"; color: Theme.text_primary; font-size: 14px; font-weight: 900; horizontal-alignment: center; }
                Text { text: "\"" + root.menu_canto_titulo + "\" sera eliminado permanentemente."; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout { spacing: 12px; alignment: center;
                    Rectangle { width: 110px; height: 36px; border-radius: 6px; background: touch-cancel.has-hover ? Theme.bg_card_hover : Theme.bg_input; border-width: 1px; border-color: Theme.border_strong; touch-cancel := TouchArea { clicked => { root.mostrar_confirmar_eliminar = false; } } Text { text: "Cancelar"; color: Theme.text_secondary; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 110px; height: 36px; border-radius: 6px; background: touch-confirm.has-hover ? #b91c1c : #dc2626; touch-confirm := TouchArea { clicked => { root.eliminar_canto(root.menu_canto_id); root.mostrar_confirmar_eliminar = false; } } Text { text: "Eliminar"; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL FORMULARIO AGREGAR / EDITAR (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_formulario) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 520px; height: 500px;
                    background: Theme.bg_popup; border-radius: 12px; border-width: 2px; border-color: Theme.border_strong;
                    VerticalLayout {
                        padding: 24px; spacing: 14px;
                        HorizontalLayout { alignment: space-between; height: 32px; Text { text: root.form_id == -1 ? "AGREGAR CANTO" : "EDITAR CANTO"; color: Theme.accent; font-size: 13px; font-weight: 900; vertical-alignment: center; horizontal-stretch: 1; } Rectangle { width: 28px; height: 28px; border-radius: 6px; background: touch-close-form.has-hover ? Theme.bg_card_hover : transparent; touch-close-form := TouchArea { clicked => { root.mostrar_formulario = false; } } Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } } }
                        Rectangle { height: 1px; background: rgba(0,0,0,0.07); }
                        VerticalLayout { spacing: 6px; height: 62px; Text { text: "TÍTULO"; color: Theme.text_secondary; font-size: 9px; font-weight: 800; letter-spacing: 0.5px; height: 16px; } Rectangle { height: 38px; border-radius: 6px; background: Theme.bg_input; border-width: 1px; border-color: Theme.border_subtle; TextInput { x: 12px; width: parent.width - 24px; height: 100%; text <=> root.form_titulo; color: Theme.text_primary; font-size: 12px; vertical-alignment: center; } } }
                        VerticalLayout { vertical-stretch: 1; spacing: 6px; Text { text: "LETRA  (separa estrofas con una línea vacía)"; color: Theme.text_secondary; font-size: 9px; font-weight: 800; letter-spacing: 0.5px; height: 16px; } Rectangle { vertical-stretch: 1; border-radius: 6px; background: Theme.bg_input; border-width: 1px; border-color: Theme.border_subtle; TextEdit { width: 100%; height: 100%; text <=> root.form_letra; font-size: 12px; } } }
                        HorizontalLayout { alignment: end; spacing: 12px; height: 38px;
                            Rectangle { width: 110px; height: 38px; border-radius: 6px; background: touch-cancel2.has-hover ? Theme.bg_card_hover : Theme.bg_input; border-width: 1px; border-color: Theme.border_strong; touch-cancel2 := TouchArea { clicked => { root.mostrar_formulario = false; } } Text { text: "Cancelar"; color: Theme.text_secondary; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { width: 110px; height: 38px; border-radius: 6px; background: touch-save.has-hover ? Theme.accent_hover : Theme.accent; touch-save := TouchArea { clicked => { root.guardar_canto(root.form_id, root.form_titulo, root.form_letra); root.mostrar_formulario = false; } } Text { text: "Guardar"; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL PDF (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_pdf) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        TouchArea { clicked => { root.mostrar_menu_pdf = false; } }
        Rectangle {
            x: root.menu_pdf_x; y: root.menu_pdf_y;
            width: 180px; height: root.menu_pdf_idx != -1 ? 76px : 40px;
            background: Theme.bg_popup; border-radius: 8px; border-width: 2px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Importar PDF..."; icon: ""; clicked => { root.mostrar_menu_pdf = false; root.agregar_pdf(); } }
                if (root.menu_pdf_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_pdf_idx != -1) : MenuItem { text: "Eliminar PDF"; icon: ""; text_color: #f87171; icon_color: #f87171; clicked => { root.mostrar_menu_pdf = false; root.eliminar_pdf(root.menu_pdf_idx); } }
            }
        }
    }


    //  MODAL DE MÁRGENES (adaptado al tema claro/oscuro)
    if (root.mostrar_modal_margenes) : Rectangle {
        width: 100%; height: 100%;
        background: Theme.overlay; // Capa de atenuación del tema
        TouchArea {} // Para bloquear clics debajo

        Rectangle {
            width: 400px; height: 350px;
            
            // 1. Fondo oscuro y un borde sutil
            background: Theme.bg_popup;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border_strong;
            
            VerticalLayout {
                padding: 20px;
                spacing: 15px;

               Text { 
                   text: "Márgenes de Proyección"; 
                   font-size: 18px; 
                   font-weight: 700; 
                   horizontal-alignment: center; 
                   color: Theme.text_primary; // Texto blanco
               }

                HorizontalLayout {
                    Text { text: "Superior:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 300; value: root.margen_superior;
                        changed(val) => { root.margen_superior = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_superior); width: 30px; color: Theme.accent; font-weight: 700; } // Valor en azul
                }
                HorizontalLayout {
                    Text { text: "Inferior:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 300; value: root.margen_inferior;
                        changed(val) => { root.margen_inferior = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_inferior); width: 30px; color: Theme.accent; font-weight: 700; }
                }
                HorizontalLayout {
                    Text { text: "Izquierdo:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 500; value: root.margen_izquierdo;
                        changed(val) => { root.margen_izquierdo = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_izquierdo); width: 30px; color: Theme.accent; font-weight: 700; }
                }
                HorizontalLayout {
                    Text { text: "Derecho:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 500; value: root.margen_derecho;
                        changed(val) => { root.margen_derecho = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_derecho); width: 30px; color: Theme.accent; font-weight: 700; }
                }

                // El botón estándar de Slint se adapta al tema del sistema. 
                // Si en tu PC se sigue viendo blanco y desentona mucho, avísame y te armo un botón oscuro personalizado.
                Button {
                    text: "Cerrar";
                    clicked => { root.mostrar_modal_margenes = false; }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL DE PANTALLAS (mapa visual + identificación)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_modal_pantallas) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.mostrar_modal_pantallas = false; } }

        Rectangle {
            width: 560px; height: 420px;
            background: Theme.bg_popup; border-radius: 12px;
            border-width: 2px; border-color: Theme.border_strong;
            TouchArea {} // bloquea el clic hacia el backdrop

            VerticalLayout {
                padding: 24px; spacing: 16px;

                HorizontalLayout {
                    alignment: space-between; height: 30px;
                    Text { text: "PANTALLAS"; color: Theme.text_primary; font-size: 15px; font-weight: 900; vertical-alignment: center; }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: 6px;
                        background: touch-close-pant.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-pant := TouchArea { clicked => { root.mostrar_modal_pantallas = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Text {
                    text: root.pantallas_detectadas.length == 0
                        ? "No se detectaron pantallas."
                        : root.pantallas_detectadas.length + " pantalla(s) detectada(s).";
                    color: Theme.text_secondary; font-size: 11px; font-weight: 600;
                }

                // ── MAPA VISUAL (escala relativa a la posición real) ──
                Rectangle {
                    height: 220px; border-radius: 8px; background: Theme.bg_list;
                    border-width: 1px; border-color: Theme.border_subtle; clip: true;

                    for pantalla[idx] in root.pantallas_detectadas : Rectangle {
                        x: 20px + pantalla.x * 0.12px;
                        y: 20px + pantalla.y * 0.12px;
                        width: max(96px, pantalla.width * 0.12px);
                        height: max(78px, pantalla.height * 0.12px);
                        border-radius: 6px;
                        background: pantalla.rol > 0 ? Theme.accent_soft : Theme.bg_card;
                        border-width: 2px;
                        border-color: pantalla.rol > 0 ? Theme.accent : Theme.border_subtle;

                        VerticalLayout {
                            padding: 4px; spacing: 2px; alignment: center;
                            Text { text: "Pantalla " + (idx + 1); color: Theme.text_primary; font-size: 9px; font-weight: 800; horizontal-alignment: center; }
                            Text { text: pantalla.width + "×" + pantalla.height; color: Theme.text_muted; font-size: 7px; horizontal-alignment: center; }
                            Text {
                                text: pantalla.rol == 1 ? "OPERADOR" : pantalla.rol == 2 ? "PROYECTOR" : pantalla.rol == 3 ? "STAGE DISPLAY" : "Sin asignar";
                                color: pantalla.rol > 0 ? Theme.accent : Theme.text_muted;
                                font-size: 7px; font-weight: 800; horizontal-alignment: center;
                            }
                            Rectangle { height: 4px; }
                            // Selector de rol: 3 botones pequeños
                            HorizontalLayout {
                                spacing: 3px; alignment: center;
                                Rectangle {
                                    width: 20px; height: 18px; border-radius: 4px;
                                    background: pantalla.rol == 1 ? Theme.accent : rgba(0,0,0,0.15);
                                    TouchArea { clicked => { root.asignar_rol_pantalla(pantalla.id, pantalla.rol == 1 ? 0 : 1); } }
                                    Text { text: "1"; color: white; font-size: 9px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 20px; height: 18px; border-radius: 4px;
                                    background: pantalla.rol == 2 ? Theme.accent : rgba(0,0,0,0.15);
                                    TouchArea { clicked => { root.asignar_rol_pantalla(pantalla.id, pantalla.rol == 2 ? 0 : 2); } }
                                    Text { text: "2"; color: white; font-size: 9px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 20px; height: 18px; border-radius: 4px;
                                    background: pantalla.rol == 3 ? Theme.accent : rgba(0,0,0,0.15);
                                    TouchArea { clicked => { root.asignar_rol_pantalla(pantalla.id, pantalla.rol == 3 ? 0 : 3); } }
                                    Text { text: "3"; color: white; font-size: 9px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 4px;
                            background: root.auto_proyectar_inicio ? Theme.accent : Theme.bg_input;
                            border-width: 1px; border-color: Theme.border_input;
                            TouchArea {
                                clicked => {
                                    root.auto_proyectar_inicio = !root.auto_proyectar_inicio;
                                    root.aplicar_cambios_pantallas();
                                }
                            }
                            if (root.auto_proyectar_inicio) : Text { text: "✓"; color: white; font-size: 11px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                        Text { text: "Abrir proyector automáticamente al iniciar"; color: Theme.text_secondary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                    }
                }

                Text {
                    text: "1 = Pantalla Operador   ·   2 = Proyector (Live)   ·   3 = Stage Display";
                    color: Theme.text_muted; font-size: 9px; font-weight: 600; horizontal-alignment: center;
                }

                
                // ── BOTONES: IDENTIFICAR + APLICAR CAMBIOS ──
                HorizontalLayout {
                    height: 42px; spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1; border-radius: 8px;
                        background: identificar-touch.has-hover ? Theme.accent_hover : Theme.accent;
                        identificar-touch := TouchArea {
                            clicked => { root.identificar_pantallas(); }
                        }
                        Text {
                            text: root.identificando_pantallas ? "Mostrando números..." : "Identificar Pantallas";
                            color: white; font-size: 12px; font-weight: 800;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    if (root.cambios_pendientes) : Rectangle {
                        width: 140px; border-radius: 8px;
                        background: aplicar-touch.has-hover ? #16a34a : #22c55e;
                        aplicar-touch := TouchArea {
                            clicked => { root.aplicar_cambios_pantallas(); }
                        }
                        Text {
                            text: "Aplicar Cambios";
                            color: white; font-size: 12px; font-weight: 800;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

        if (root.mostrar_modal_overlay) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.mostrar_modal_overlay = false; } }

        Rectangle {
            width: 460px; height: 380px;
            background: Theme.bg_popup; border-radius: 12px;
            border-width: 2px; border-color: Theme.border_strong;
            TouchArea {}

            VerticalLayout {
                padding: 24px; spacing: 14px;

                HorizontalLayout {
                    alignment: space-between; height: 30px;
                    Text { text: "SALIDA POR IP (OBS)"; color: Theme.text_primary; font-size: 14px; font-weight: 900; vertical-alignment: center; }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: 6px;
                        background: touch-close-ov.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-ov := TouchArea { clicked => { root.mostrar_modal_overlay = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Text {
                    text: "Agrega una fuente de \"Navegador\" en OBS con esta URL para mostrar el texto proyectado como overlay.";
                    color: Theme.text_secondary; font-size: 10px; wrap: word-wrap;
                }

                // ── URL + botón copiar ────────────────────────────────────
                Rectangle {
                    height: 48px; border-radius: 8px; background: Theme.bg_list; border-width: 1px; border-color: Theme.border_subtle;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 6px; spacing: 8px;
                        Text {
                            text: "http://" + root.overlay_ip_local + ":" + root.overlay_puerto;
                            color: Theme.accent; font-size: 13px; font-weight: 800;
                            vertical-alignment: center; horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 36px; height: 36px; border-radius: 6px;
                            background: touch-copiar-url.has-hover ? Theme.accent_soft : rgba(0,0,0,0.04);
                            touch-copiar-url := TouchArea { clicked => { root.copiar_url_overlay(); } }
                            Text {
                                text: "⧉";
                                color: touch-copiar-url.has-hover ? Theme.accent : Theme.text_secondary;
                                font-size: 15px; font-weight: 900;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px; height: 30px;
                    Text { text: "Puerto:"; color: Theme.text_secondary; font-size: 11px; vertical-alignment: center; }
                    Rectangle {
                        width: 90px; height: 30px; border-radius: 6px; background: Theme.bg_input; border-width: 1px; border-color: Theme.border_input;
                        TextInput {
                            text: root.overlay_puerto;
                            color: Theme.text_primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
                            input-type: number;
                            edited => {
                                if (self.text.to-float() > 1024 && self.text.to-float() < 65535) {
                                    root.overlay_puerto = self.text.to-float();
                                }
                            }
                        }
                    }
                }

                // ── Checkbox: Solo texto (sin fondo) ─────────────────────
                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 18px; height: 18px; border-radius: 4px;
                            background: root.overlay_solo_texto ? Theme.accent : Theme.bg_input;
                            border-width: 1px; border-color: Theme.border_input;
                            TouchArea {
                                clicked => {
                                    root.toggle_overlay_solo_texto(!root.overlay_solo_texto);
                                }
                            }
                            if (root.overlay_solo_texto) : Text {
                                text: "✓"; color: white; font-size: 12px; font-weight: 900;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        Text {
                            text: "Solo texto (sin fondo)";
                            color: Theme.text_secondary; font-size: 10px; font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    height: 42px; border-radius: 8px;
                    background: root.overlay_servidor_activo ? #dc2626 : Theme.accent;
                    TouchArea { clicked => { root.toggle_servidor_overlay(); } }
                    Text {
                        text: root.overlay_servidor_activo ? "Detener Servidor" : "Iniciar Servidor";
                        color: white; font-size: 12px; font-weight: 800;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
        }
    }

    

    // ══════════════════════════════════════════════════════════════
    //  OVERLAY DE PROGRESO DE IMPORTACIÓN PDF (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.is_importing_pdf) : Rectangle {
        width: 100%; height: 100%; background: rgba(0,0,0,0.72);
        TouchArea {} // Bloquea clics traseros
        VerticalLayout {
            alignment: center; spacing: 16px;
            Text { text: " PROCESANDO PDF"; color: Theme.text_primary; font-size: 16px; font-weight: 900; horizontal-alignment: center; letter-spacing: 2px;}
            Text { text: root.pdf_import_filename; color: Theme.accent; font-size: 13px; font-weight: 700; horizontal-alignment: center; }
            Text { text: "Convirtiendo páginas a imágenes de alta calidad para una proyección fluida..."; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; }
            
            Rectangle { height: 16px; } // Espaciador
            
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 400px; height: 16px; background: Theme.bg_card_hover; border-radius: 8px;
                    Rectangle { x: 0; width: parent.width * root.pdf_import_progress; height: 100%; background: Theme.accent; border-radius: 8px; }
                }
            }
            Text { text: round(root.pdf_import_progress * 100) + "% completado"; color: Theme.text_primary; font-size: 12px; font-weight: 800; horizontal-alignment: center; }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  OVERLAY: INSTALANDO LIBREOFFICE (soporte PPTX/ODP)
    // ══════════════════════════════════════════════════════════════
    if (root.instalando_libreoffice) : Rectangle {
        width: 100%; height: 100%; background: rgba(0,0,0,0.72);
        TouchArea {}
        VerticalLayout {
            alignment: center; spacing: 16px;
            Text { text: " INSTALANDO SOPORTE PPTX/ODP"; color: Theme.text_primary; font-size: 16px; font-weight: 900; horizontal-alignment: center; letter-spacing: 2px; }
            Text { text: "Esto puede tardar unos minutos. No cierres la aplicación."; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; }
            Rectangle { height: 16px; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 400px; height: 16px; background: Theme.bg_card_hover; border-radius: 8px;
                    Rectangle { x: 0; width: parent.width * root.libreoffice_progreso; height: 100%; background: Theme.accent; border-radius: 8px; }
                }
            }
            Text { text: root.libreoffice_progreso > 0 ? round(root.libreoffice_progreso * 100) + "% completado" : "Preparando..."; color: Theme.text_primary; font-size: 12px; font-weight: 800; horizontal-alignment: center; }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  OVERLAY: ERROR AL INSTALAR LIBREOFFICE
    // ══════════════════════════════════════════════════════════════
   if (root.libreoffice_error != "") : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.libreoffice_error = ""; } }
        Rectangle {
            width: 380px; height: 180px;
            background: Theme.bg_popup; border-radius: 12px;
            border-width: 1px; border-color: Theme.border_strong;
            drop-shadow-color: Theme.shadow; drop-shadow-blur: 20px;
            TouchArea {}
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: " No se pudo instalar"; color: #f87171; font-size: 14px; font-weight: 900; horizontal-alignment: center; }
                Text { text: root.libreoffice_error; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle {
                    height: 36px; border-radius: 6px; background: Theme.accent;
                    TouchArea { clicked => { root.libreoffice_error = ""; } }
                    Text { text: "Entendido"; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }

        // ══════════════════════════════════════════════════════════════
    //  BANNER: AVISO BREVE (archivo faltante, etc.) — ligero, sin blur
    // ══════════════════════════════════════════════════════════════
    if (root.aviso_mensaje != "") : Rectangle {
        y: parent.height - 70px; x: (parent.width - 420px) / 2;
        width: 420px; height: 46px;
        background: Theme.bg_popup; border-radius: 8px;
        border-width: 2px; border-color: #f87171;
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 10px;
            Text { text: "⚠"; color: #f87171; font-size: 16px; vertical-alignment: center; }
            Text {
                text: root.aviso_mensaje; color: Theme.text_primary; font-size: 10px; font-weight: 700;
                vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap;
            }
        }
    }
}