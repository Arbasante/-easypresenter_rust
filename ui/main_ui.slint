    in property <[Canto]> cantos: [];
    in-out property <string> buscador_texto: "";

    property <string> buscador_pending: "";
    property <bool> hay_busqueda_pendiente: false;
Timer {
    interval: 200ms;
    running: true;
    triggered => {
        if (root.hay_busqueda_pendiente) {
