    public function focus_panel() { panel-focus.focus(); }

    // ══════════════════════════════════════════════════════════════
    //  LAYOUT PRINCIPAL  (2 columnas: sidebar izquierdo + central)
    // ══════════════════════════════════════════════════════════════
    Rectangle {
        width: 100%; height: 100%;

        HorizontalLayout {

            // ╔══════════════════════════════════════════════════╗
            // ║   COLUMNA 1: SIDEBAR UNIFICADO (nav + biblioteca) ║
            // ╚══════════════════════════════════════════════════╝
            Rectangle {
                width: 300px; background: Theme.surface_sidebar;
                border-width: 0px; border-color: Theme.border_subtle;

                VerticalLayout {

                    // ── BARRA DE TABS ───────────────────────────
                    Rectangle {
                        height: 34px; background: Theme.surface_topbar;
                        border-width: 0px; border-color: Theme.border_subtle;

                        HorizontalLayout {
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "CANTOS";
                                active: root.active-tab == "cantos";
                                clicked => { 
                                    root.active-tab = "cantos"; 
                                    root.elemento_seleccionado = ""; 
                                    root.estrofas_actuales = []; 
                                    root.active_estrofa_index = -1;
                                    root.scroll_to_y = 0px;
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "BIBLIA";
                                active: root.active-tab == "biblias";
                                clicked => { 
                                    root.active-tab = "biblias"; 
                                    root.elemento_seleccionado = ""; 
                                    root.estrofas_actuales = []; 
                                    root.active_estrofa_index = -1;
                                    root.scroll_to_y = 0px;
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "IMGS";
                                active: root.active-tab == "imagenes";
                                clicked => { 
                                    root.active-tab = "imagenes"; 
                                    root.elemento_seleccionado = "";
                                    root.scroll_to_y = 0px;
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "VIDEOS";
                                active: root.active-tab == "videos";
                                clicked => { 
                                    root.active-tab = "videos"; 
                                    root.elemento_seleccionado = "";
                                    root.scroll_to_y = 0px;
                                    root.sync_estilos(); 
                                }
                            }
                            TabButton {
                                horizontal-stretch: 1; height: 34px;
                                icon: ""; text: "PDF/PPTX";
                                active: root.active-tab == "pdf";
                                clicked => { 
                                    root.active-tab = "pdf"; 
                                    root.elemento_seleccionado = "";
                                    root.scroll_to_y = 0px;
                                    root.sync_estilos(); 
                                }
                            }
                        }

                        Rectangle { y: parent.height - 1px; height: 1px; background: transparent; }
                    }

                    // ── CONTENIDO DE BIBLIOTECA (vertical-stretch) ──
                    Rectangle {
                        vertical-stretch: 1;

                        // ── TAB CANTOS ──
                         VerticalLayout {
                             visible: root.active-tab == "cantos";
                            // Buscador
                            Rectangle {
                                height: 52px;
                                Rectangle {
                                    height: 32px; x: 10px; y: 10px; width: parent.width - 20px;
                                    border-radius: 4px; background: Theme.surface_input; border-width: 1px; border-color: Theme.border_input;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px; spacing: 6px;
                                        Text { text: ""; font-size: 10px; color: Theme.text_muted; vertical-alignment: center; }
                                        TextInput { text <=> root.buscador_texto; font-size: 10px; color: Theme.text_primary; vertical-alignment: center; horizontal-stretch: 1; edited => { root.buscador_pending = self.text; root.hay_busqueda_pendiente = true; } }                                    }
                                }
                            }
                            // Lista de cantos
                            Rectangle {
                                vertical-stretch: 1; background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                                ScrollView {
                                    VerticalLayout {
                                        padding-left: 4px; padding-right: 4px; padding-top: 4px; spacing: 0px;
                                                                                for canto in root.cantos : Rectangle {
                                            height: 36px;
                                            property <bool> fila_resaltada: touch-canto.has-hover || star-touch.has-hover;
                                            background: root.elemento_seleccionado == canto.titulo ? Theme.accent_fill : (fila_resaltada ? Theme.list_hover : transparent);
                                            touch-canto := TouchArea {
                                                clicked => { 
                                                    root.scroll_to_y = 0px;
                                                    root.seleccionar_canto(canto.id); 
                                                }
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                        root.menu_canto_id = canto.id;
                                                        root.menu_canto_titulo = canto.titulo;
                                                        root.menu_x = min(self.absolute-position.x + self.mouse-x, root.width - 185px);
                                                        root.menu_y = min(self.absolute-position.y + self.mouse-y, root.height - 114px);
                                                        root.mostrar_menu_canto = true;
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                                Text { text: canto.titulo; color: root.elemento_seleccionado == canto.titulo ? Theme.text_on_accent : Theme.text_list; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                
                                                Rectangle {
                                                    width: 24px; height: 24px;
                                                    background: transparent;
                                                    star-touch := TouchArea {
                                                        clicked => { root.toggle_favorito_canto(canto.id); }
                                                    }
                                                    Text {
                                                        text: canto.favorito ? "★" : "☆";
                                                        color: root.elemento_seleccionado == canto.titulo ? Theme.text_on_accent : (canto.favorito ? Theme.warning : (star-touch.has-hover ? Theme.warning : Theme.text_muted));
                                                        font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: transparent; }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB BIBLIAS ──
                        VerticalLayout {
                            visible: root.active-tab == "biblias";
                            padding: 10px; spacing: 10px;
                            ComboBox { height: 32px; width: 100%; model: root.bible-versions; current-value <=> root.current-bible-version; selected(val) => { root.bible-version-changed(val); root.focus_panel(); } }
                            Rectangle {
                                height: 32px; width: 100%; background: Theme.surface_input; border-radius: 4px; border-width: 1px; border-color: Theme.border_input;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                                    Text { text: ""; font-size: 10px; color: Theme.text_muted; vertical-alignment: center; }
                                    search_focus := FocusScope {
                                        horizontal-stretch: 1; forward-focus: search_input;
                                        key-pressed(event) => {
                                            if (event.text == Key.Tab || event.text == Key.RightArrow) {
                                                if (root.bible-search-suggestion != "" && root.bible-search-suggestion != root.bible-search-text) {
                                                    root.bible-search-text = root.bible-search-suggestion + " ";
                                                    root.bible-search-suggestion = "";
                                                    root.bible-search-changed(root.bible-search-text);
                                                    search_input.set-selection-offsets(999, 999);
                                                    return accept;
                                                }
                                            }
                                            return reject;
                                        }
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            Text { text: root.bible-search-suggestion; color: Theme.text_muted; font-size: 1px; vertical-alignment: center; horizontal-alignment: left; width: 100%; }
                                            search_input := TextInput {
                                                width: 100%; height: 100%;
                                                text <=> root.bible-search-text;
                                                color: Theme.text_primary; font-size: 10px; vertical-alignment: center;
                                                edited => { root.bible-search-changed(self.text); }
                                                key-pressed(event) => {
                                                    if (event.text == Key.Return && event.modifiers.shift) {
                                                        root.bible-search-preview(self.text);
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                                accepted => { root.bible-search-accepted(self.text); }
                                            }
                                        }
                                    }
                                }
                            }
                            if (!root.show-bible-chapters) : Rectangle {
                                vertical-stretch: 1; background: Theme.surface_list; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_subtle;
                                ScrollView {
                                    VerticalLayout {
                                        padding: 4px;
                                        for book in root.bible-books : Rectangle {
                                            height: 36px; background: touch-book.has-hover ? Theme.accent_soft : transparent;
                                            touch-book := TouchArea { clicked => { root.selected-bible-book = book; root.show-bible-chapters = true; root.bible-book-selected(book); } }
                                            HorizontalLayout { padding-left: 8px; padding-right: 8px; Text { text: book.nombre; color: (touch-book.has-hover ? Theme.text_primary : Theme.text_secondary); font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: transparent; }
                                        }
                                    }
                                }
                            }
                            if (root.show-bible-chapters) : Rectangle {
                                vertical-stretch: 1; background: Theme.surface_list; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_subtle;
                                VerticalLayout {
                                    Rectangle {
                                        height: 36px;
                                        touch-back := TouchArea { clicked => { root.show-bible-chapters = false; } }
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px; spacing: 8px;
                                            Text { text: "<"; color: Theme.accent; font-weight: Theme.font_weight_heading; font-size: 14px; vertical-alignment: center; }
                                            Text { text: root.selected-bible-book.nombre; color: Theme.accent; font-size: 11px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; background: transparent; }
                                    }
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 12px; spacing: 8px; alignment: start;
                                            for row in root.chapter-rows : HorizontalLayout {
                                                spacing: 8px; height: 42px;
                                                for cap in row.caps : Rectangle {
                                                    width: 42px; border-radius: Theme.radius_control; border-width: 1px; border-color: Theme.border_subtle;
                                                    background: touch-cap.has-hover ? Theme.accent_fill : Theme.surface_input;
                                                    touch-cap := TouchArea { 
                                                        clicked => { 
                                                            root.scroll_to_y = 0px;
                                                            root.bible-chapter-selected(cap); 
                                                        } 
                                                    }
                                                    Text { text: cap; color: (touch-cap.has-hover ? Theme.text_on_accent : Theme.text_secondary); font-size: 12px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB IMÁGENES MULTIMEDIA ──
                        Rectangle {
                            visible: root.active-tab == "imagenes";
                            vertical-stretch: 1; background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                            TouchArea {
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        root.menu_media_idx = -1;
                                        root.menu_media_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                        root.menu_media_y = min(self.absolute-position.y + self.mouse-y, root.height - 150px);
                                        root.mostrar_menu_media = true;
                                    }
                                }
                                media-scroll := ScrollView {
                                    content-width: self.visible-width;
                                    horizontal-scrollbar-policy: always-off;
                                    GridLayout {
                                        width: parent.width; padding: 8px; spacing: 8px;
                                        for item[idx] in root.multimedia_items : Rectangle {
                                            row: idx / 3; col: mod(idx, 3);
                                            width: (media-scroll.visible-width - 32px) / 3;
                                            height: 76px; border-radius: Theme.radius_control;
                                            background: root.selected_media_idx == idx ? Theme.accent_soft : (touch-media.has-hover ? Theme.bg_card_hover : Theme.surface_card);
                                            border-width: root.selected_media_idx == idx ? 2px : 0px;
                                            border-color: Theme.accent;
                                            touch-media := TouchArea {
                                                clicked => { root.selected_media_idx = idx; root.seleccionar_media_item(idx); }
                                                double-clicked => { root.proyectar_multimedia(idx); }
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                        root.menu_media_idx = idx;
                                                        root.menu_media_x = self.absolute-position.x + self.mouse-x;
                                                        root.menu_media_y = self.absolute-position.y + self.mouse-y;
                                                        root.mostrar_menu_media = true;
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                                                border-radius: 4px; clip: true; background: Theme.bg_preview;
                                                Image { source: item.img; width: 100%; height: 100%; image-fit: item.aspecto == "rellenar" ? cover : (item.aspecto == "estirar" ? fill : contain); }
                                                if (root.default_bg_type == "imagen" && root.default_bg_idx == idx) : Rectangle {
                                                    x: parent.width - 22px; y: 4px; width: 18px; height: 18px;
                                                    border-radius: 4px; background: Theme.media_overlay;
                                                    Text { text: "★"; color: Theme.media_text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                if (touch-media.has-hover) : Rectangle {
                                                    y: parent.height - 24px; width: 100%; height: 24px;
                                                    background: @linear-gradient(180deg, Theme.media_overlay 0%, Theme.media_overlay 100%);
                                                    Text {
                                                        x: 5px; width: parent.width - 10px; height: 100%;
                                                        text: item.nombre; color: Theme.media_text; font-size: 9px;
                                                        vertical-alignment: center; horizontal-alignment: center; overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB VIDEOS (BIBLIOTECA) ──
                        Rectangle {
                            visible: root.active-tab == "videos";
                            vertical-stretch: 1; background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                            TouchArea {
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        root.menu_video_idx = -1;
                                        root.menu_video_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                        root.menu_video_y = min(self.absolute-position.y + self.mouse-y, root.height - 146px);
                                        root.mostrar_menu_video = true;
                                    }
                                }
                                video-scroll := ScrollView {
                                    content-width: self.visible-width;
                                    horizontal-scrollbar-policy: always-off;
                                    GridLayout {
                                        width: parent.width; padding: 8px; spacing: 8px;
                                        for item[idx] in root.video_items : Rectangle {
                                            row: idx / 3; col: mod(idx, 3);
                                            width: (video-scroll.visible-width - 32px) / 3;
                                            height: 76px; border-radius: Theme.radius_control;
                                            background: root.selected_video_idx == idx ? Theme.accent_soft : (touch-vid.has-hover ? Theme.bg_card_hover : Theme.surface_card);
                                            border-width: root.selected_video_idx == idx ? 2px : 0px;
                                            border-color: Theme.accent;
                                            touch-vid := TouchArea {
                                                clicked => { root.seleccionar_video_lista(idx); }
                                                double-clicked => { root.proyectar_video(idx); }
                                                pointer-event(e) => {
                                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                        root.menu_video_idx = idx;
                                                        root.menu_video_x = self.absolute-position.x + self.mouse-x;
                                                        root.menu_video_y = self.absolute-position.y + self.mouse-y;
                                                        root.mostrar_menu_video = true;
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                                                border-radius: 4px; clip: true; background: Theme.bg_preview;
                                                Image { source: item.img; width: 100%; height: 100%; image-fit: cover; }
                                                Text {
                                                    text: "▶"; color: Theme.media_text; font-size: 14px;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                    width: 100%; height: 100%;
                                                }
                                                if (item.is_loop) : Rectangle {
                                                    x: 4px; y: 4px; width: 18px; height: 18px;
                                                    border-radius: 4px; background: Theme.media_overlay;
                                                    Text { text: "↻"; color: Theme.media_text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                if (root.default_bg_type == "video" && root.default_bg_idx == idx) : Rectangle {
                                                    x: parent.width - 22px; y: 4px; width: 18px; height: 18px;
                                                    border-radius: 4px; background: Theme.media_overlay;
                                                    Text { text: "★"; color: Theme.media_text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                if (touch-vid.has-hover) : Rectangle {
                                                    y: parent.height - 24px; width: 100%; height: 24px;
                                                    background: @linear-gradient(180deg, Theme.media_overlay 0%, Theme.media_overlay 100%);
                                                    Text {
                                                        x: 5px; width: parent.width - 10px; height: 100%;
                                                        text: item.nombre; color: Theme.media_text; font-size: 9px;
                                                        vertical-alignment: center; horizontal-alignment: center; overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ── TAB PDF (BIBLIOTECA) ──
                        Rectangle {
                            visible: root.active-tab == "pdf";
                            vertical-stretch: 1; background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                            TouchArea {
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                        root.menu_pdf_idx = -1;
                                        root.menu_pdf_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                        root.menu_pdf_y = min(self.absolute-position.y + self.mouse-y, root.height - 100px);
                                        root.mostrar_menu_pdf = true;
                                    }
                                }
                            }
                            ScrollView {
                                VerticalLayout {
                                    padding: 8px; spacing: 8px;
                                    for item[idx] in root.pdf_items : Rectangle {
                                        height: 60px; border-radius: Theme.radius_control;
                                        background: root.selected_pdf_idx == idx ? Theme.accent_soft : (touch-pdf.has-hover ? Theme.bg_card_hover : transparent);
                                        touch-pdf := TouchArea {
                                            clicked => { root.seleccionar_pdf(idx); }
                                            pointer-event(e) => {
                                                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                                                    root.menu_pdf_idx = idx;
                                                    root.menu_pdf_x = min(self.absolute-position.x + self.mouse-x, root.width - 180px);
                                                    root.menu_pdf_y = min(self.absolute-position.y + self.mouse-y, root.height - 100px);
                                                    root.mostrar_menu_pdf = true;
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding: 6px; spacing: 12px;
                                            Rectangle {
                                                width: 40px; height: 48px; border-radius: 4px; clip: true; background: Theme.bg_preview;
                                                Image { source: item.miniatura; width: 100%; height: 100%; image-fit: cover; }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 4px;
                                                Text { text: item.nombre; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; horizontal-stretch: 1; overflow: elide; }
                                                Text { text: item.total_paginas + " Páginas"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── SECCIÓN FAVORITOS ───────────────────────
                    Rectangle {
                        height: 280px; background: Theme.surface_sidebar;
                        border-width: 0px; border-color: Theme.border_subtle;

                        VerticalLayout {
                            // Encabezado favoritos
                            Rectangle {
                                height: 28px;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: "FAVORITOS"; color: Theme.warning; font-size: 9px; font-weight: Theme.font_weight_body; letter-spacing: 0.8px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: root.favoritos.length > 0 ? root.favoritos.length + "" : ""; color: Theme.warning; font-size: 9px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: transparent; }
                            }

                            // Lista de favoritos
                            Rectangle {
                                vertical-stretch: 1; clip: true;
                                if (root.favoritos.length == 0) : Text {
                                    text: "Pulsa la estrella (☆) en un canto o versículo\npara fijarlo aquí";
                                    color: Theme.text_muted; font-size: 9px; font-weight: Theme.font_weight_body;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    wrap: word-wrap; width: 100%; height: 100%;
                                }
                                if (root.favoritos.length > 0) : ScrollView {
                                    VerticalLayout {
                                        padding: 4px; spacing: 0px;
                                        for fav in root.favoritos : Rectangle {
                                            height: 34px; border-radius: 4px;
                                            background: touch-fav.has-hover ? Theme.warning_soft : transparent;
                                            touch-fav := TouchArea {
                                                clicked => { 
                                                    root.scroll_to_y = 0px;
                                                    root.abrir_favorito(fav); 
                                                }
                                            }
                                            HorizontalLayout {
                                                padding-left: 9px; padding-right: 9px; spacing: 8px;
                                                // Etiqueta tipo / versión
                                                Rectangle {
                                                    width: fav.tipo == "canto" ? 44px : 48px; height: 18px; border-radius: 3px;
                                                    background: fav.tipo == "canto" ? Theme.accent_soft : Theme.warning_soft;
                                                    Text {
                                                        text: fav.tipo == "canto" ? "CANTO" : (fav.version != "" ? fav.version : "BIBLIA");
                                                        color: (fav.tipo == "canto" ? Theme.accent : Theme.warning);
                                                        font-size: 8px; font-weight: Theme.font_weight_body;
                                                        horizontal-alignment: center; vertical-alignment: center;
                                                        width: 100%; height: 100%;
                                                    }
                                                }
                                                // Título / Referencia
                                                Text {
                                                    text: fav.referencia != "" ? fav.referencia : fav.titulo;
                                                    color: (touch-fav.has-hover ? Theme.warning : Theme.text_secondary);
                                                    font-size: 10px; font-weight: Theme.font_weight_body;
                                                    vertical-alignment: center; horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                // Botón quitar
                                                Rectangle {
                                                    width: 40px; height: 20px; border-radius: 4px;
                                                    background: del-fav.has-hover ? Theme.danger_soft : Theme.surface_card;
                                                    border-width: 1px;
                                                    border-color: del-fav.has-hover ? Theme.danger : transparent;
                                                    del-fav := TouchArea {
                                                        clicked => {
                                                            root.eliminar_favorito(fav);
                                                        }
                                                    }
                                                    Text {
                                                        text: "Quitar";
                                                        color: (del-fav.has-hover ? Theme.danger : Theme.text_muted);
                                                        font-size: 8px; font-weight: Theme.font_weight_body;
                                                        horizontal-alignment: center; vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: transparent; }
                                    }
                                }
                            }
                        }
                        Rectangle { y: 0px; height: 1px; width: 100%; background: Theme.separator_main; }
                    }
                }
                Rectangle {
                    x: parent.width - 1px; width: 1px; height: 100%;
                    background: Theme.separator_main;
                }
            }

            // ╔══════════════════════════════════════════════╗
            // ║  COLUMNA 2: PANEL CENTRAL                    ║
            // ╚══════════════════════════════════════════════╝
            Rectangle {
                horizontal-stretch: 1; background: Theme.surface_main;
                VerticalLayout {
                    // ── MENÚ SUPERIOR + BARRA DE TÍTULO ─────────────────
                    VerticalLayout {
                        height: 84px;
                        spacing: 0px;

                        // Menú superior: reemplaza el botón de engranaje.
                        Rectangle {
                            height: 36px;
                            background: Theme.surface_topbar;
                            border-width: 0px;
                            border-color: Theme.border_subtle;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;

                                TopMenuItem {
                                    text: "Fondos";
                                    clicked => { root.mostrar_personalizar = true; }
                                }

                                Rectangle {
                                width: 140px; height: 36px;
                                border-radius: 4px;
                                background: cfg-touch.has-hover ? Theme.bg_card_hover : transparent;
                                cfg-touch := TouchArea {
                                    clicked => {
                                        root.menu_configuracion_x = self.absolute-position.x;
                                        root.menu_configuracion_y = self.absolute-position.y + self.height;
                                        root.mostrar_menu_configuracion = !root.mostrar_menu_configuracion;
                                    }
                                }
                                Text {
                                    text: "Configuración";
                                    color: (cfg-touch.has-hover ? Theme.text_primary : Theme.text_secondary);
                                    font-size: 11px; font-weight: Theme.font_weight_body;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }

                            Rectangle {
                                width: 118px; height: 36px;
                                border-radius: 4px;
                                background: tools-touch.has-hover ? Theme.bg_card_hover : transparent;
                                tools-touch := TouchArea {
                                    clicked => {
                                        root.menu_herramientas_x = self.absolute-position.x;
                                        root.menu_herramientas_y = self.absolute-position.y + self.height;
                                        root.mostrar_menu_herramientas = !root.mostrar_menu_herramientas;
                                    }
                                }
                                Text {
                                    text: "Herramientas";
                                    color: (tools-touch.has-hover ? Theme.text_primary : Theme.text_secondary);
                                    font-size: 11px; font-weight: Theme.font_weight_body;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }


                            Rectangle {
                                width: 90px; height: 36px;
                                border-radius: 4px;
                                background: help-touch.has-hover ? Theme.bg_card_hover : transparent;
                                help-touch := TouchArea {
                                    clicked => {
                                        root.menu_ayuda_x = self.absolute-position.x;
                                        root.menu_ayuda_y = self.absolute-position.y + self.height;
                                        root.mostrar_menu_ayuda = !root.mostrar_menu_ayuda;
                                    }
                                }
                                Text {
                                    text: "Ayuda";
                                    color: (help-touch.has-hover ? Theme.text_primary : Theme.text_secondary);
                                    font-size: 11px; font-weight: Theme.font_weight_body;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }

                                Rectangle { horizontal-stretch: 1; }

                                // Botón Generador IA
                                Rectangle {
                                    width: 36px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius_control;
                                    background: touch-ia.has-hover ? Theme.accent_hover : Theme.accent_fill;
                                    border-width: 1px;
                                    border-color: Theme.accent_fill;

                                    touch-ia := TouchArea {
                                        clicked => {
                                            root.click_boton_ia();
                                        }
                                    }

                                    Text {
                                        text: "IA";
                                        font-size: 11px;
                                        font-weight: Theme.font_weight_heading;
                                        letter-spacing: 0.8px;
                                        color: Theme.text_on_accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle { width: 6px; }

                                Rectangle {
                                    width: 54px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius_control;
                                    background: touch-live.has-hover ? Theme.danger_hover : Theme.danger_fill;
                                    border-width: 1px;
                                    border-color: Theme.danger_fill;

                                    touch-live := TouchArea {
                                        clicked => {
                                            root.abrir_proyector();
                                            if (root.default_bg_type == "imagen" && root.default_bg_idx >= 0 && root.default_bg_idx < root.multimedia_items.length) {
                                                root.proyectar_multimedia(root.default_bg_idx);
                                            } else if (root.default_bg_type == "video" && root.default_bg_idx >= 0 && root.default_bg_idx < root.video_items.length) {
                                                root.proyectar_video(root.default_bg_idx);
                                            }
                                        }
                                    }

                                    Text {
                                        text: "LIVE";
                                        font-size: 10px;
                                        font-weight: Theme.font_weight_heading;
                                        letter-spacing: 0.8px;
                                        color: Theme.text_on_accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 48px;
                            background: Theme.surface_main;

                            HorizontalLayout {
                                padding-left: 20px; padding-right: 20px;

                                Text {
                                    text: root.elemento_seleccionado == "" ? "SELECCIONA UN ELEMENTO" : " " + root.elemento_seleccionado;
                                    color: (root.elemento_seleccionado == "" ? Theme.text_muted : Theme.accent);
                                    font-size: 12px;
                                    font-weight: Theme.font_weight_heading;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.separator_main;
                            }
                        }
                    }

                    panel-focus := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(event) => {
                            if (root.estrofas_actuales.length > 0 && (root.active-tab == "cantos" || root.active-tab == "biblias")) {
                                if (event.text == Key.UpArrow) {
                                    if (root.active_estrofa_index > 0) {
                                        root.active_estrofa_index -= 1;
                                        root.proyectar_estrofa(root.estrofas_actuales[root.active_estrofa_index].texto, root.active-tab == "biblias" ? root.elemento_seleccionado + ":" + root.estrofas_actuales[root.active_estrofa_index].orden : "");
                                        
                                        // Scroll dinámico con valor NEGATIVO para enlace bidireccional
                                        root.scroll_to_y = root.active-tab == "biblias" 
                                            ? -(root.active_estrofa_index * 115px > 150px ? root.active_estrofa_index * 115px - 150px : 0px)
                                            : -((root.active_estrofa_index / 3) * 192px > 150px ? (root.active_estrofa_index / 3) * 192px - 150px : 0px);
                                    }
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    if (root.active_estrofa_index < root.estrofas_actuales.length - 1) {
                                        root.active_estrofa_index += 1;
                                        root.proyectar_estrofa(root.estrofas_actuales[root.active_estrofa_index].texto, root.active-tab == "biblias" ? root.elemento_seleccionado + ":" + root.estrofas_actuales[root.active_estrofa_index].orden : "");
                                        
                                        // Scroll dinámico con valor NEGATIVO para enlace bidireccional
                                        root.scroll_to_y = root.active-tab == "biblias" 
                                            ? -(root.active_estrofa_index * 115px > 150px ? root.active_estrofa_index * 115px - 150px : 0px)
                                            : -((root.active_estrofa_index / 3) * 192px > 150px ? (root.active_estrofa_index / 3) * 192px - 150px : 0px);
                                    } else if (root.active_estrofa_index == -1) {
                                        root.active_estrofa_index = 0;
                                        root.proyectar_estrofa(root.estrofas_actuales[root.active_estrofa_index].texto, root.active-tab == "biblias" ? root.elemento_seleccionado + ":" + root.estrofas_actuales[root.active_estrofa_index].orden : "");
                                        root.scroll_to_y = 0px;
                                    }
                                    return accept;
                                }
                            }
                            return reject;
                        }

                        Rectangle {
                            width: 100%; height: 100%; background: Theme.surface_main;

                            // ── VISTA CANTOS / BIBLIAS ──
                            Rectangle {
                                visible: root.active-tab == "cantos" || root.active-tab == "biblias";
                                width: 100%; height: 100%;
                                if (root.estrofas_actuales.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: root.elemento_seleccionado == "" ? "SELECCIONA UN ARCHIVO DE LA BIBLIOTECA" : root.elemento_seleccionado; color: Theme.text_empty; font-size: 13px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
                                }
                                if (root.estrofas_actuales.length > 0) : ScrollView {
                                    content-y <=> root.scroll_to_y;
                                    VerticalLayout {
                                        padding: 16px; spacing: 12px;
                                        // ── CUADRÍCULA 3×N ──
                                        // Fila 0: índices 0,1,2
                                        // Fila 1: índices 3,4,5 … etc.
                                        // Se generan filas de hasta 3 celdas usando GridLayout
                                        GridLayout {
                                            spacing: 12px;
                                            for estrofa[idx] in root.estrofas_actuales : Rectangle {
                                                row: root.active-tab == "biblias" ? idx : idx / 3;
                                                col: root.active-tab == "biblias" ? 0 : mod(idx, 3);
                                                height: root.active-tab == "biblias" ? 103px : 180px;
                                                border-radius: Theme.radius_surface; border-width: 1px;
                                                background: idx == root.active_estrofa_index
                                                    ? Theme.danger_soft
                                                    : (touch-estrofa.has-hover ? Theme.accent_soft : Theme.surface_card);
                                                border-color: idx == root.active_estrofa_index
                                                    ? Theme.danger_fill
                                                    : (touch-estrofa.has-hover ? Theme.accent : transparent);

                                                touch-estrofa := TouchArea {
                                                    clicked => {
                                                        root.active_estrofa_index = idx;
                                                        root.proyectar_estrofa(
                                                            estrofa.texto,
                                                            root.active-tab == "biblias"
                                                                ? root.elemento_seleccionado + ":" + estrofa.orden
                                                                : ""
                                                        );
                                                        panel-focus.focus();
                                                    }
                                                }

                                                VerticalLayout {
                                                    padding: 10px; spacing: 6px;

                                                    // ── Cabecera: número + estrellita + badge LIVE/PROYECTAR ──
                                                    HorizontalLayout {
                                                        spacing: 6px; alignment: space-between;
                                                        
                                                        // Agrupamos el número y la estrellita a la izquierda
                                                        HorizontalLayout {
                                                            spacing: 8px;
                                                            Text {
                                                                text: estrofa.orden;
                                                                color: idx == root.active_estrofa_index ? (Theme.danger) : Theme.accent;
                                                                font-weight: Theme.font_weight_heading; font-size: 10px;
                                                                vertical-alignment: center;
                                                            }
                                                            
                                                            // Botón favorito
                                                            Rectangle {
                                                                width: 20px; height: 18px;
                                                                background: transparent;
                                                                star-fav-touch := TouchArea {
                                                                    mouse-cursor: pointer;
                                                                    clicked => {
                                                                        root.toggle_favorito_estrofa(root.elemento_seleccionado + ":" + estrofa.orden, estrofa.texto);
                                                                    }
                                                                }
                                                                Text {
                                                                    text: estrofa.favorito ? "★" : "☆";
                                                                    color: (estrofa.favorito ? Theme.warning : (star-fav-touch.has-hover ? Theme.warning : Theme.text_muted));
                                                                    font-size: 13px;
                                                                    horizontal-alignment: center;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }

                                                        Rectangle {
                                                            width: 58px; height: 18px; border-radius: 4px; border-width: 1px;
                                                            background: idx == root.active_estrofa_index ? Theme.danger_fill : transparent;
                                                            border-color: idx == root.active_estrofa_index
                                                                ? Theme.danger_fill
                                                                : (touch-estrofa.has-hover ? Theme.accent_fill : transparent);
                                                            Text {
                                                                text: idx == root.active_estrofa_index ? "EN VIVO" : "PROYECTAR";
                                                                color: (idx == root.active_estrofa_index ? Theme.text_on_accent : (touch-estrofa.has-hover ? Theme.accent : Theme.text_muted));
                                                                font-size: 8px; font-weight: Theme.font_weight_body;
                                                                horizontal-alignment: center; vertical-alignment: center;
                                                            }
                                                        }
                                                    }

                                                    // ── Separador ──
                                                    Rectangle {
                                                        height: 1px;
                                                        background: idx == root.active_estrofa_index
                                                            ? Theme.danger_soft
                                                            : Theme.border_subtle;
                                                    }

                                                    // ── Texto de la estrofa (tamaño fijo uniforme) ──
                                                    Rectangle {
                                                        vertical-stretch: 1; clip: true;
                                                        Text {
                                                            text: estrofa.texto;
                                                            color: (idx == root.active_estrofa_index
                                                                ? Theme.text_primary
                                                                : (touch-estrofa.has-hover ? Theme.text_primary : Theme.text_secondary));
                                                            font-size: root.active-tab == "biblias" ? 13.5px : 11.5px;
                                                            font-weight: Theme.font_weight_body;
                                                            wrap: word-wrap;
                                                            overflow: elide;
                                                            width: 100%; height: 100%;
                                                            vertical-alignment: top;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ── VISTA IMÁGENES (panel central) ──
                            Rectangle {
                                visible: root.active-tab == "imagenes";
                                width: 100%; height: 100%; background: Theme.surface_main;
                                clip: true;
                                touch-central-media := TouchArea {
                                    clicked => { root.proyectar_multimedia(root.selected_media_idx); }
                                }
                                if (root.selected_media_idx >= 0 && root.selected_media_idx < root.multimedia_items.length) : VerticalLayout {
                                    width: 100%; height: 100%;
                                    padding: 12px;
                                    Rectangle {
                                        min-width: 0px; min-height: 0px;
                                        vertical-stretch: 1; horizontal-stretch: 1; clip: true; background: Theme.bg_preview; border-radius: Theme.radius_surface;
                                        Image {
                                            source: root.selected_media_full_img.width > 0 ? root.selected_media_full_img : root.multimedia_items[root.selected_media_idx].img;
                                            width: 100%; height: 100%;
                                            image-fit: root.multimedia_items[root.selected_media_idx].aspecto == "rellenar" ? cover : (root.multimedia_items[root.selected_media_idx].aspecto == "estirar" ? fill : contain);
                                        }
                                        Rectangle {
                                            width: 175px; height: 32px; x: 10px; y: 10px;
                                            background: Theme.surface_card; border-radius: Theme.radius_control; border-width: 1px; border-color: Theme.border_subtle;
                                            Text {
                                                text: root.multimedia_items[root.selected_media_idx].aspecto == "centro" ? "MODO: AJUSTAR AL CENTRO" : root.multimedia_items[root.selected_media_idx].aspecto == "rellenar" ? "MODO: RELLENAR PANTALLA" : "MODO: ESTIRAR";
                                                color: Theme.text_secondary; font-size: 10px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                if (root.selected_media_idx == -1 || root.multimedia_items.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: "SELECCIONA UNA IMAGEN DE LA BIBLIOTECA"; color: Theme.text_empty; font-size: 13px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
                                }
                            }

                            // ── VISTA VIDEOS (panel central) ──
                            Rectangle {
                                visible: root.active-tab == "videos";
                                width: 100%; height: 100%; background: Theme.surface_main;
                                if (root.selected_video_idx >= 0 && root.selected_video_idx < root.video_items.length) : VerticalLayout {
                                    padding: 16px; spacing: 12px;
                                    Rectangle {
                                        height: 45px; border-radius: Theme.radius_control;
                                        background: root.is_video_projecting ? Theme.danger_fill : Theme.accent_fill;
                                        TouchArea {
                                            clicked => {
                                                if (!root.is_video_projecting) { root.proyectar_video(root.selected_video_idx); }
                                            }
                                        }
                                        Text {
                                            text: root.is_video_projecting ? "VIDEO EN PROYECCIÓN" : "PROYECTAR VIDEO";
                                            color: Theme.text_on_accent; font-weight: Theme.font_weight_body; font-size: 13px;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        vertical-stretch: 1; horizontal-stretch: 1; clip: true; background: Theme.bg_preview; border-radius: Theme.radius_surface;
                                        Image { source: root.preview_video_frame; width: 100%; height: 100%; image-fit: contain; }
                                        TouchArea {
                                            clicked => { root.toggle_preview_video(root.selected_video_idx); }
                                        }

                                        // ── Controles de Vista Previa (Retrasar 10s, Play/Pausa, Adelantar 10s) ──
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 12px;
                                            y: parent.height - 52px;
                                            height: 38px;

                                            // Retrasar 10 segundos
                                            Rectangle {
                                                width: 88px; height: 36px; border-radius: Theme.radius_control;
                                                background: touch-prev-rewind.has-hover ? Theme.media_hover : Theme.media_overlay;
                                                border-width: 1px; border-color: Theme.media_border;
                                                touch-prev-rewind := TouchArea {
                                                    clicked => { root.seek_preview_relativo(-10.0); }
                                                }
                                                Text {
                                                    text: "⏪ -10s";
                                                    color: Theme.media_text; font-size: 11px; font-weight: Theme.font_weight_body;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }

                                            // Reproducir / Pausar
                                            Rectangle {
                                                width: 108px; height: 36px; border-radius: Theme.radius_control;
                                                background: touch-prev-play.has-hover ? Theme.media_hover : Theme.media_overlay;
                                                border-width: 1px; border-color: Theme.media_border;
                                                touch-prev-play := TouchArea {
                                                    clicked => { root.toggle_preview_video(root.selected_video_idx); }
                                                }
                                                Text {
                                                    text: root.is_preview_playing ? "⏸ Pausar" : "▶ Reproducir";
                                                    color: Theme.media_text; font-size: 11px; font-weight: Theme.font_weight_body;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }

                                            // Adelantar 10 segundos
                                            Rectangle {
                                                width: 88px; height: 36px; border-radius: Theme.radius_control;
                                                background: touch-prev-fwd.has-hover ? Theme.media_hover : Theme.media_overlay;
                                                border-width: 1px; border-color: Theme.media_border;
                                                touch-prev-fwd := TouchArea {
                                                    clicked => { root.seek_preview_relativo(10.0); }
                                                }
                                                Text {
                                                    text: "+10s ⏩";
                                                    color: Theme.media_text; font-size: 11px; font-weight: Theme.font_weight_body;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                    if (root.is_video_projecting) : HorizontalLayout {
                                        height: 40px; spacing: 12px; padding-left: 16px; padding-right: 16px;
                                        Rectangle {
                                            width: 86px; height: 32px; border-radius: Theme.radius_control; background: Theme.surface_card; border-width: 1px; border-color: Theme.border_subtle;
                                            TouchArea { clicked => { root.toggle_proyector_play(); } }
                                            Text { text: root.is_proyector_playing ? "Pausar" : "Reproducir"; color: Theme.text_primary; font-size: 10px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            width: 86px; height: 32px; border-radius: Theme.radius_control; background: Theme.surface_card; border-width: 1px; border-color: Theme.border_subtle;
                                            TouchArea { clicked => { root.toggle_proyector_mute(); } }
                                            Text { text: root.is_proyector_muted ? "Activar Audio" : "Silenciar"; color: Theme.text_primary; font-size: 10px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            alignment: center; horizontal-stretch: 1;
                                            Rectangle {
                                                horizontal-stretch: 1; height: 12px; background: Theme.border_input; border-radius: Theme.radius_control;
                                                Rectangle { x: 0; y: 0; width: parent.width * root.proyector_progress; height: 100%; background: Theme.accent_fill; border-radius: Theme.radius_control; }
                                                touch_progress := TouchArea {
                                                    width: 100%; height: 100%;
                                                    clicked => { root.seek_proyector_video(touch_progress.mouse-x / touch_progress.width); }
                                                }
                                            }
                                        }
                                        Text { text: root.proyector_time; color: Theme.text_secondary; font-size: 13px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                    }
                                }
                                if (root.selected_video_idx == -1 || root.video_items.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: "SELECCIONA UN VIDEO DE LA BIBLIOTECA"; color: Theme.text_empty; font-size: 13px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
                                }
                            }

                            // ── VISTA PDF (panel central) ──
                            Rectangle {
                                visible: root.active-tab == "pdf";
                                width: 100%; height: 100%; background: Theme.surface_main;
                                if (root.pdf_pages.length == 0) : VerticalLayout {
                                    alignment: center; spacing: 16px;
                                    Text { text: ""; color: Theme.text_muted; font-size: 48px; horizontal-alignment: center; }
                                    Text { text: "SELECCIONA O AGREGA UN PDF"; color: Theme.text_empty; font-size: 13px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
                                }
                                if (root.pdf_pages.length > 0) : ScrollView {
                                    GridLayout {
                                        padding: 16px; spacing: 16px;
                                        for page[idx] in root.pdf_pages : Rectangle {
                                            row: idx / 3; col: mod(idx, 3);
                                            height: 220px; border-radius: Theme.radius_surface; clip: true;
                                            border-width: 2px;
                                            border-color: idx == root.active_pdf_page ? Theme.danger : (touch-page.has-hover ? Theme.accent : transparent);
                                            Image { source: page; width: 100%; height: 100%; image-fit: contain; }
                                            touch-page := TouchArea { clicked => { root.proyectar_pdf_pagina(idx); } }
                                            
                                            // Indicador de número de página
                                            Rectangle {
                                                x: 8px; y: 8px; width: 28px; height: 28px; border-radius: 14px; 
                                                background: idx == root.active_pdf_page ? Theme.danger_fill : Theme.media_overlay;
                                                Text { text: idx + 1; color: idx == root.active_pdf_page ? Theme.text_on_accent : Theme.media_text; font-size: 11px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL MULTIMEDIA IMÁGENES (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_media) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        TouchArea {
            clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; }
        }
        Rectangle {
            x: root.menu_media_x; y: root.menu_media_y;
            width: 180px; height: root.menu_media_idx != -1 ? 150px : 40px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Agregar Imagen"; icon: ""; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.agregar_multimedia(); } }
                if (root.menu_media_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_media_idx != -1) : VerticalLayout {
                    spacing: 2px;
                    MenuItem {
                        text: "Aspecto de Imagen"; icon: ""; has_submenu: true;
                        hovered => { root.mostrar_submenu_aspecto = true; }
                        clicked => { root.mostrar_submenu_aspecto = true; }
                    }
                    
                    // NUEVO BOTON PREDETERMINADO
                    MenuItem { text: "Fondo Predeterminado"; icon: ""; text_color: Theme.warning; icon_color: Theme.warning; clicked => { root.default_bg_type = "imagen"; root.default_bg_idx = root.menu_media_idx; root.mostrar_menu_media = false; } }
                    
                    HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                    MenuItem { text: "Eliminar Imagen"; icon: ""; text_color: Theme.danger; icon_color: Theme.danger; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.eliminar_multimedia(root.menu_media_idx); } }
                }
            }
        }
        if (root.mostrar_submenu_aspecto && root.menu_media_idx != -1) : Rectangle {
            x: root.menu_media_x + 178px; y: root.menu_media_y + 36px;
            width: 170px; height: 106px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Ajustar al centro"; icon: ""; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.cambiar_aspecto_multimedia(root.menu_media_idx, "centro"); } }
                MenuItem { text: "Rellenar pantalla"; icon: ""; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.cambiar_aspecto_multimedia(root.menu_media_idx, "rellenar"); } }
                MenuItem { text: "Estirar"; icon: ""; text_color: Theme.accent; icon_color: Theme.accent; clicked => { root.mostrar_menu_media = false; root.mostrar_submenu_aspecto = false; root.cambiar_aspecto_multimedia(root.menu_media_idx, "estirar"); } }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL VIDEOS (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_video) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        TouchArea { clicked => { root.mostrar_menu_video = false; root.mostrar_submenu_reproduccion = false; } }
        if (root.mostrar_submenu_reproduccion && root.menu_video_idx != -1) : Rectangle {
            x: root.menu_video_x + 178px; y: root.menu_video_y + 35px;
            width: 160px; height: 72px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            VerticalLayout {
                padding: 4px; spacing: 2px;
                Rectangle {
                    height: 30px; border-radius: 4px; background: touch_norm.has-hover ? Theme.bg_card_hover : transparent;
                    touch_norm := TouchArea { clicked => { root.cambiar_modo_reproduccion(root.menu_video_idx, "normal"); root.mostrar_submenu_reproduccion = false; root.mostrar_menu_video = false; } }
                    Text { text: "Normal (Una vez)"; color: Theme.text_primary; font-size: 13px; x: 12px; vertical-alignment: center; height: 100%; }
                }
                Rectangle {
                    height: 30px; border-radius: 4px; background: touch_loop.has-hover ? Theme.bg_card_hover : transparent;
                    touch_loop := TouchArea { clicked => { root.cambiar_modo_reproduccion(root.menu_video_idx, "bucle"); root.mostrar_submenu_reproduccion = false; root.mostrar_menu_video = false; } }
                    Text { text: "Bucle Infinito"; color: Theme.accent; font-size: 13px; font-weight: Theme.font_weight_body; x: 12px; vertical-alignment: center; height: 100%; }
                }
            }
        }
        Rectangle {
            x: root.menu_video_x; y: root.menu_video_y;
            width: 180px; height: root.menu_video_idx != -1 ? 146px : 40px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Agregar Video"; icon: ""; clicked => { root.mostrar_menu_video = false; root.mostrar_submenu_reproduccion = false; root.agregar_video(); } }
                if (root.menu_video_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_video_idx != -1) : MenuItem {
                    text: "Reproducción"; has_submenu: true;
                    hovered => { root.mostrar_submenu_reproduccion = true; }
                    clicked => { root.mostrar_submenu_reproduccion = true; }
                }
                
                // NUEVO BOTON PREDETERMINADO
                if (root.menu_video_idx != -1) : MenuItem { text: "Fondo Predeterminado"; icon: ""; text_color: Theme.warning; icon_color: Theme.warning; clicked => { root.default_bg_type = "video"; root.default_bg_idx = root.menu_video_idx; root.mostrar_menu_video = false; } }
                
                if (root.menu_video_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_video_idx != -1) : MenuItem { text: "Eliminar Video"; icon: ""; text_color: Theme.danger; icon_color: Theme.danger; clicked => { root.mostrar_menu_video = false; root.mostrar_submenu_reproduccion = false; root.eliminar_video(root.menu_video_idx); } }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL DE PERSONALIZACIÓN (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════
    //  MODAL PERSONALIZACIÓN — diseño minimalista v2
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_personalizar) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        nm-backdrop := TouchArea { clicked => { root.mostrar_personalizar = false; } }

        Rectangle {
            width: 620px; height: 498px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset;
            border-radius: Theme.radius_modal;
            border-width: 0px; border-color: Theme.border_strong;
            nm-blocker := TouchArea {}

            property <string> current_gal_tab: "imagenes";

            VerticalLayout {
                // ── HEADER ─────────────────────────────────────────────────
                Rectangle {
                    height: 50px;
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 0px;
                        Text { text: "PROYECCIÓN"; color: Theme.text_muted; font-size: 9px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        // Pill tab switcher
                        Rectangle {
                            width: 160px; height: 30px; border-radius: Theme.radius_surface;
                            background: Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle;
                            HorizontalLayout { padding: 3px; spacing: 3px;
                                Rectangle { horizontal-stretch: 1; border-radius: Theme.radius_control; background: root.modal_tab == "biblias" ? Theme.accent_soft : transparent; nm-t1 := TouchArea { clicked => { root.modal_tab = "biblias"; } } Text { text: "BIBLIA"; color: (root.modal_tab == "biblias" ? Theme.accent : Theme.text_secondary); font-size: 9px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Rectangle { horizontal-stretch: 1; border-radius: Theme.radius_control; background: root.modal_tab == "cantos" ? Theme.accent_soft : transparent; nm-t2 := TouchArea { clicked => { root.modal_tab = "cantos"; } } Text { text: "CANTO"; color: (root.modal_tab == "cantos" ? Theme.accent : Theme.text_secondary); font-size: 9px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                            }
                        }
                        Rectangle { width: 10px; }
                        // Close
                        Rectangle { width: 30px; height: 30px; border-radius: Theme.radius_surface; background: nm-close.has-hover ? Theme.bg_card_hover : transparent; nm-close := TouchArea { clicked => { root.mostrar_personalizar = false; } } Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                }
                Rectangle { height: 1px; background: Theme.separator; }

// ── FUENTE (GLOBAL: aplica igual a biblia y canto) ──────────
Rectangle {
    height: 54px;
    HorizontalLayout {
        padding-left: 22px; padding-right: 22px; spacing: 12px;
        Text {
            text: "FUENTE"; color: Theme.text_muted; font-size: 10px;
            font-weight: Theme.font_weight_heading; letter-spacing: 2px; vertical-alignment: center;
        }
        ComboBox {
    width: 180px; height: 30px;
    model: root.fuentes_disponibles;
    current-value: root.proyeccion_font_family;
    selected(val) => {
        root.proyeccion_font_family = val;
        root.cambiar_fuente_proyeccion(val);
    }
}
        Rectangle { horizontal-stretch: 1; }
    }
}
Rectangle { height: 1px; background: Theme.separator; }

// ── CONTENT ────────────────────────────────────────────────
Rectangle {
    vertical-stretch: 1;

                    // ═══ BIBLIA TAB ═════════════════════════════════════════
                    if (root.modal_tab == "biblias") : VerticalLayout {
                        padding-left: 22px; padding-right: 22px; padding-top: 17px; padding-bottom: 17px; spacing: 0px;

                        // — FONDO —
                        Text { text: "FONDO"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; }
                        Rectangle { height: 10px; }
                        HorizontalLayout { spacing: 0px; alignment: space-between;
                            // BG type pills
                            HorizontalLayout { spacing: 6px; alignment: start;
                                Rectangle { width: 44px; height: 32px; border-radius: Theme.radius_control; background: #000000; border-width: 2px; border-color: root.biblias_bg_type == "negro" ? Theme.accent : Theme.border_input; nm-bbn := TouchArea { clicked => { root.biblias_bg_type = "negro"; root.sync_estilos(); } } }
                               Rectangle { width: 44px; height: 32px; border-radius: Theme.radius_control; background: #ffffff; border-width: 2px; border-color: root.biblias_bg_type == "blanco" ? Theme.accent : Theme.border_input; nm-bbb := TouchArea { clicked => { root.biblias_bg_type = "blanco"; root.sync_estilos(); } } }
                                Rectangle { width: 66px; height: 32px; border-radius: Theme.radius_control; background: root.biblias_bg_type == "imagen" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: root.biblias_bg_type == "imagen" ? Theme.accent : Theme.border_subtle; nm-bbi := TouchArea { clicked => { root.biblias_bg_type = "imagen"; root.sync_estilos(); } } Text { text: "Imagen"; font-size: 11px; font-weight: Theme.font_weight_body; color: (root.biblias_bg_type == "imagen" ? Theme.accent : Theme.text_secondary); horizontal-alignment: center; vertical-alignment: center; }  }
                                Rectangle { width: 62px; height: 32px; border-radius: Theme.radius_control; background: root.biblias_bg_type == "video" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: root.biblias_bg_type == "video" ? Theme.accent : Theme.border_subtle; nm-bbv := TouchArea { clicked => { root.biblias_bg_type = "video"; root.sync_estilos(); } } Text { text: "Video"; font-size: 9px; font-weight: Theme.font_weight_body; color: (root.biblias_bg_type == "video" ? Theme.accent : Theme.text_secondary); horizontal-alignment: center; vertical-alignment: center; } }
                            }
                            // Opacity inline (solo aplica a imágenes y videos)
                            HorizontalLayout {
                                spacing: 8px; alignment: end;
                                opacity: (root.biblias_bg_type == "imagen" || root.biblias_bg_type == "video") ? 1.0 : 0.3;
                                Text { text: "Opacidad"; color: Theme.text_muted; font-size: 9px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                Slider {
                                    width: 100px; minimum: 0.0; maximum: 1.0;
                                    enabled: root.biblias_bg_type == "imagen" || root.biblias_bg_type == "video";
                                    value <=> root.biblias_fondo_opacity; changed => { root.sync_estilos(); }
                                }
                                Text {
                                    text: (root.biblias_bg_type == "imagen" || root.biblias_bg_type == "video") ? (round(root.biblias_fondo_opacity * 100) + "%") : "—";
                                    color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; vertical-alignment: center; min-width: 30px;
                                }
                            }
                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 1px; background: Theme.separator; }
                        Rectangle { height: 16px; }

                        // — TEXTO —
                        HorizontalLayout { spacing: 0px; alignment: space-between;
                            VerticalLayout { spacing: 8px; alignment: start;
                                Text { text: "TEXTO"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; }
                                HorizontalLayout { spacing: 5px; alignment: start;
                                    // White
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #ffffff ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.biblias_font_color == #ffffff ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #ffffff; border-width: 1px; border-color: Theme.border_input; } nm-bfc0 := TouchArea { clicked => { root.biblias_font_color = #ffffff; root.sync_estilos(); } } }
                                    // Black
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #000000 ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.biblias_font_color == #000000 ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #000000; border-width: 1px; border-color: Theme.border_subtle; } nm-bfc1 := TouchArea { clicked => { root.biblias_font_color = #000000; root.sync_estilos(); } } }
                                    // Amarillo
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #fef08a ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.biblias_font_color == #fef08a ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #fef08a; } nm-bfc2 := TouchArea { clicked => { root.biblias_font_color = #fef08a; root.sync_estilos(); } } }
                                    // Verde
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #86efac ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.biblias_font_color == #86efac ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #86efac; } nm-bfc3 := TouchArea { clicked => { root.biblias_font_color = #86efac; root.sync_estilos(); } } }
                                    // Azul
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #93c5fd ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.biblias_font_color == #93c5fd ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #93c5fd; } nm-bfc4 := TouchArea { clicked => { root.biblias_font_color = #93c5fd; root.sync_estilos(); } } }
                                    // Coral
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #fca5a5 ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.biblias_font_color == #fca5a5 ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #fca5a5; } nm-bfc5 := TouchArea { clicked => { root.biblias_font_color = #fca5a5; root.sync_estilos(); } } }
                                    // Lila
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.biblias_font_color == #d8b4fe ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.biblias_font_color == #d8b4fe ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #d8b4fe; } nm-bfc6 := TouchArea { clicked => { root.biblias_font_color = #d8b4fe; root.sync_estilos(); } } }
                                    // Más colores
                                    Rectangle { width: 38px; height: 28px; border-radius: Theme.radius_control; background: Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; nm-bfcc := TouchArea { clicked => { root.color_target = "biblias"; root.mostrar_selector_color = true; } } Text { text: "Color"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                                }
                            }
                            // Tamaño de letra
                            VerticalLayout { spacing: 8px; alignment: start; horizontal-stretch: 0;
                                Text { text: "TAMAÑO"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; }
                                HorizontalLayout { spacing: 4px; alignment: start;
                                    Rectangle { width: 38px; height: 28px; border-radius: Theme.radius_control; background: nm-bsm.has-hover ? Theme.bg_card_hover : Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; nm-bsm := TouchArea { clicked => { root.biblias_font_scale = max(0.5, root.biblias_font_scale - 0.1); root.sync_font_scale(); } } Text { text: "Menor"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                                    Rectangle { width: 46px; height: 28px; border-radius: Theme.radius_control; background: Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; Text { text: round(root.biblias_font_scale * 100) + "%"; color: Theme.text_secondary; font-size: 10px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                    Rectangle { width: 38px; height: 28px; border-radius: Theme.radius_control; background: nm-bsp.has-hover ? Theme.bg_card_hover : Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; nm-bsp := TouchArea { clicked => { root.biblias_font_scale = min(2.0, root.biblias_font_scale + 0.1); root.sync_font_scale(); } } Text { text: "Mayor"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                                }
                            }
                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 1px; background: Theme.separator; }
                        Rectangle { height: 14px; }

                        // — GALERÍA —
                        HorizontalLayout { alignment: space-between;
                            Text { text: "GALERÍA"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; vertical-alignment: center; }
                            HorizontalLayout { spacing: 0px;
                                Rectangle { width: 80px; height: 24px; border-top-left-radius: 6px; border-bottom-left-radius: 6px; background: current_gal_tab == "imagenes" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: current_gal_tab == "imagenes" ? Theme.accent : Theme.border_subtle; nm-bgi := TouchArea { clicked => { current_gal_tab = "imagenes"; } } Text { text: "Imágenes"; color: (current_gal_tab == "imagenes" ? Theme.accent : Theme.text_secondary); font-size: 8px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Rectangle { width: 70px; height: 24px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; background: current_gal_tab == "videos" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: current_gal_tab == "videos" ? Theme.accent : Theme.border_subtle; nm-bgv := TouchArea { clicked => { current_gal_tab = "videos"; } } Text { text: "Videos"; color: (current_gal_tab == "videos" ? Theme.accent : Theme.text_secondary); font-size: 8px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                            }
                        }
                        Rectangle { height: 10px; }

                        Rectangle {
                            vertical-stretch: 1; border-radius: Theme.radius_surface; clip: true;
                            if (current_gal_tab == "imagenes") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 1px; border-color: Theme.border_subtle; background: nm-bagi.has-hover ? Theme.bg_card_hover : Theme.bg_card; nm-bagi := TouchArea { clicked => { root.agregar_a_galeria("biblias-img"); } } VerticalLayout { alignment: center; spacing: 0px; Text { text: "Agregar"; color: Theme.text_muted; font-size: 11px; horizontal-alignment: center; font-weight: Theme.font_weight_body; } } }
                                    for img[idx] in root.biblias_image_data : Rectangle { width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 2px; border-color: root.biblias_selected_img == idx ? Theme.accent : Theme.bg_card; clip: true; Image { source: img; width: 100%; height: 100%; image-fit: cover; } TouchArea { clicked => { root.seleccionar_galeria_item("biblias-img", idx); } } Rectangle { width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: Theme.radius_surface; background: Theme.media_overlay; TouchArea { clicked => { root.eliminar_galeria_item("biblias-img", idx); } } Text { text: "✕"; color: Theme.danger; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: Theme.font_weight_heading; } } }
                                }
                            }
                            if (current_gal_tab == "videos") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 1px; border-color: Theme.border_subtle; background: nm-bagv.has-hover ? Theme.bg_card_hover : Theme.bg_card; nm-bagv := TouchArea { clicked => { root.agregar_a_galeria("biblias-vid"); } } VerticalLayout { alignment: center; spacing: 0px; Text { text: "Agregar"; color: Theme.text_muted; font-size: 11px; horizontal-alignment: center; font-weight: Theme.font_weight_body; } } }
                                    for vid[idx] in root.biblias_video_gallery : Rectangle {
    width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 2px; clip: true;
    background: Theme.bg_preview;
    border-color: root.biblias_selected_vid == idx ? Theme.accent : Theme.bg_card;
    Image { source: vid.img; width: 100%; height: 100%; image-fit: cover; }
    Rectangle {
        y: parent.height - 18px; width: 100%; height: 18px;
        background: Theme.media_overlay;
        Text { text: vid.nombre; font-size: 7px; color: Theme.media_text; horizontal-alignment: center; vertical-alignment: center; overflow: elide; width: 100%; }
    }
    TouchArea { clicked => { root.seleccionar_galeria_item("biblias-vid", idx); } }
    Rectangle {
        width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: Theme.radius_surface;
        background: Theme.media_overlay;
        TouchArea { clicked => { root.eliminar_galeria_item("biblias-vid", idx); } }
        Text { text: "✕"; color: Theme.danger; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: Theme.font_weight_heading; }
    }
}
                                }
                            }
                        }
                    }

                    // ═══ CANTO TAB ══════════════════════════════════════════
                    if (root.modal_tab == "cantos") : VerticalLayout {
                        padding-left: 22px; padding-right: 22px; padding-top: 17px; padding-bottom: 17px; spacing: 0px;

                        Text { text: "FONDO"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; }
                        Rectangle { height: 10px; }
                        HorizontalLayout { spacing: 0px; alignment: space-between;
                            HorizontalLayout { spacing: 6px; alignment: start;
                                Rectangle { width: 44px; height: 32px; border-radius: Theme.radius_control; background: #000000; border-width: 2px; border-color: root.cantos_bg_type == "negro" ? Theme.accent : Theme.border_input; nm-cbn := TouchArea { clicked => { root.cantos_bg_type = "negro"; root.sync_estilos(); } } }
                                Rectangle { width: 44px; height: 32px; border-radius: Theme.radius_control; background: #ffffff; border-width: 2px; border-color: root.cantos_bg_type == "blanco" ? Theme.accent : Theme.border_input; nm-cbb := TouchArea { clicked => { root.cantos_bg_type = "blanco"; root.sync_estilos(); } } }
                                Rectangle { width: 66px; height: 32px; border-radius: Theme.radius_control; background: root.cantos_bg_type == "imagen" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: root.cantos_bg_type == "imagen" ? Theme.accent : Theme.border_subtle; nm-cbi := TouchArea { clicked => { root.cantos_bg_type = "imagen"; root.sync_estilos(); } } Text { text: "Imagen"; font-size: 11px; font-weight: Theme.font_weight_body; color: (root.cantos_bg_type == "imagen" ? Theme.accent : Theme.text_secondary); horizontal-alignment: center; vertical-alignment: center; } }
                                Rectangle { width: 62px; height: 32px; border-radius: Theme.radius_control; background: root.cantos_bg_type == "video" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: root.cantos_bg_type == "video" ? Theme.accent : Theme.border_subtle; nm-cbv := TouchArea { clicked => { root.cantos_bg_type = "video"; root.sync_estilos(); } } Text { text: "Video"; font-size: 11px; font-weight: Theme.font_weight_body; color: (root.cantos_bg_type == "video" ? Theme.accent : Theme.text_secondary); horizontal-alignment: center; vertical-alignment: center; } }
                            }
                            // Opacity inline (solo aplica a imágenes y videos)
                            HorizontalLayout {
                                spacing: 8px; alignment: end;
                                opacity: (root.cantos_bg_type == "imagen" || root.cantos_bg_type == "video") ? 1.0 : 0.3;
                                Text { text: "Opacidad"; color: Theme.text_muted; font-size: 9px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                Slider {
                                    width: 100px; minimum: 0.0; maximum: 1.0;
                                    enabled: root.cantos_bg_type == "imagen" || root.cantos_bg_type == "video";
                                    value <=> root.cantos_fondo_opacity; changed => { root.sync_estilos(); }
                                }
                                Text {
                                    text: (root.cantos_bg_type == "imagen" || root.cantos_bg_type == "video") ? (round(root.cantos_fondo_opacity * 100) + "%") : "—";
                                    color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; vertical-alignment: center; min-width: 30px;
                                }
                            }
                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 1px; background: Theme.separator; }
                        Rectangle { height: 16px; }

                        HorizontalLayout { spacing: 0px; alignment: space-between;
                            VerticalLayout { spacing: 8px; alignment: start;
                                Text { text: "TEXTO"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; }
                                HorizontalLayout { spacing: 5px; alignment: start;
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.cantos_font_color == #ffffff ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.cantos_font_color == #ffffff ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #ffffff; border-width: 1px; border-color: Theme.border_input; } nm-cfc0 := TouchArea { clicked => { root.cantos_font_color = #ffffff; root.sync_estilos(); } } }
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.cantos_font_color == #000000 ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.cantos_font_color == #000000 ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #000000; border-width: 1px; border-color: Theme.border_subtle; } nm-cfc1 := TouchArea { clicked => { root.cantos_font_color = #000000; root.sync_estilos(); } } }
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.cantos_font_color == #fef08a ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.cantos_font_color == #fef08a ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #fef08a; } nm-cfc2 := TouchArea { clicked => { root.cantos_font_color = #fef08a; root.sync_estilos(); } } }
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.cantos_font_color == #86efac ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.cantos_font_color == #86efac ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #86efac; } nm-cfc3 := TouchArea { clicked => { root.cantos_font_color = #86efac; root.sync_estilos(); } } }
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.cantos_font_color == #93c5fd ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.cantos_font_color == #93c5fd ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #93c5fd; } nm-cfc4 := TouchArea { clicked => { root.cantos_font_color = #93c5fd; root.sync_estilos(); } } }
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.cantos_font_color == #fca5a5 ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.cantos_font_color == #fca5a5 ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #fca5a5; } nm-cfc5 := TouchArea { clicked => { root.cantos_font_color = #fca5a5; root.sync_estilos(); } } }
                                    Rectangle { width: 28px; height: 28px; border-radius: 14px; background: root.cantos_font_color == #d8b4fe ? Theme.accent_soft : transparent; border-width: 2px; border-color: root.cantos_font_color == #d8b4fe ? Theme.accent : transparent; Rectangle { width: 20px; height: 20px; border-radius: 10px; x: 2px; y: 2px; background: #d8b4fe; } nm-cfc6 := TouchArea { clicked => { root.cantos_font_color = #d8b4fe; root.sync_estilos(); } } }
                                    Rectangle { width: 38px; height: 28px; border-radius: Theme.radius_control; background: Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; nm-cfcc := TouchArea { clicked => { root.color_target = "cantos"; root.mostrar_selector_color = true; } } Text { text: "Color"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                                }
                            }
                            VerticalLayout { spacing: 8px; alignment: start; horizontal-stretch: 0;
                                Text { text: "TAMAÑO"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; }
                                HorizontalLayout { spacing: 4px; alignment: start;
                                    Rectangle { width: 38px; height: 28px; border-radius: Theme.radius_control; background: nm-csm.has-hover ? Theme.bg_card_hover : Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; nm-csm := TouchArea { clicked => { root.cantos_font_scale = max(0.5, root.cantos_font_scale - 0.1); root.sync_font_scale(); } } Text { text: "Menor"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                                    Rectangle { width: 46px; height: 28px; border-radius: Theme.radius_control; background: Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; Text { text: round(root.cantos_font_scale * 100) + "%"; color: Theme.text_secondary; font-size: 10px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                    Rectangle { width: 38px; height: 28px; border-radius: Theme.radius_control; background: nm-csp.has-hover ? Theme.bg_card_hover : Theme.bg_card; border-width: 1px; border-color: Theme.border_subtle; nm-csp := TouchArea { clicked => { root.cantos_font_scale = min(2.0, root.cantos_font_scale + 0.1); root.sync_font_scale(); } } Text { text: "Mayor"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                                }
                            }
                        }

                        Rectangle { height: 16px; }
                        Rectangle { height: 1px; background: Theme.separator; }
                        Rectangle { height: 14px; }

                        HorizontalLayout { alignment: space-between;
                            Text { text: "GALERÍA"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; vertical-alignment: center; }
                            HorizontalLayout { spacing: 0px;
                                Rectangle { width: 80px; height: 24px; border-top-left-radius: 6px; border-bottom-left-radius: 6px; background: current_gal_tab == "imagenes" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: current_gal_tab == "imagenes" ? Theme.accent : Theme.border_subtle; nm-cgi := TouchArea { clicked => { current_gal_tab = "imagenes"; } } Text { text: "Imágenes"; color: (current_gal_tab == "imagenes" ? Theme.accent : Theme.text_secondary); font-size: 8px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                                Rectangle { width: 70px; height: 24px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; background: current_gal_tab == "videos" ? Theme.accent_soft : Theme.bg_card; border-width: 1px; border-color: current_gal_tab == "videos" ? Theme.accent : Theme.border_subtle; nm-cgv := TouchArea { clicked => { current_gal_tab = "videos"; } } Text { text: "Videos"; color: (current_gal_tab == "videos" ? Theme.accent : Theme.text_secondary); font-size: 8px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; } }
                            }
                        }
                        Rectangle { height: 10px; }

                        Rectangle {
                            vertical-stretch: 1; border-radius: Theme.radius_surface; clip: true;
                            if (current_gal_tab == "imagenes") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 1px; border-color: Theme.border_subtle; background: nm-cagi.has-hover ? Theme.bg_card_hover : Theme.bg_card; nm-cagi := TouchArea { clicked => { root.agregar_a_galeria("cantos-img"); } } VerticalLayout { alignment: center; spacing: 0px; Text { text: "Agregar"; color: Theme.text_muted; font-size: 11px; horizontal-alignment: center; font-weight: Theme.font_weight_body; } } }
                                    for img[idx] in root.cantos_image_data : Rectangle { width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 2px; border-color: root.cantos_selected_img == idx ? Theme.accent : Theme.bg_card; clip: true; Image { source: img; width: 100%; height: 100%; image-fit: cover; } TouchArea { clicked => { root.seleccionar_galeria_item("cantos-img", idx); } } Rectangle { width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: Theme.radius_surface; background: Theme.media_overlay; TouchArea { clicked => { root.eliminar_galeria_item("cantos-img", idx); } } Text { text: "✕"; color: Theme.danger; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: Theme.font_weight_heading; } } }
                                }
                            }
                            if (current_gal_tab == "videos") : ScrollView {
                                width: 100%; height: 100%;
                                HorizontalLayout { padding: 2px; spacing: 8px; alignment: start;
                                    Rectangle { width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 1px; border-color: Theme.border_subtle; background: nm-cagv.has-hover ? Theme.bg_card_hover : Theme.bg_card; nm-cagv := TouchArea { clicked => { root.agregar_a_galeria("cantos-vid"); } } VerticalLayout { alignment: center; spacing: 3px; Text { text: "+"; color: Theme.text_muted; font-size: 20px; horizontal-alignment: center; } Text { text: "Agregar"; color: Theme.text_muted; font-size: 8px; horizontal-alignment: center; font-weight: Theme.font_weight_body; } } }
                                    for vid[idx] in root.cantos_video_gallery : Rectangle {
    width: 92px; height: 64px; border-radius: Theme.radius_surface; border-width: 2px; clip: true;
    background: Theme.bg_preview;
    border-color: root.cantos_selected_vid == idx ? Theme.accent : Theme.bg_card;
    Image { source: vid.img; width: 100%; height: 100%; image-fit: cover; }
    Rectangle {
        y: parent.height - 18px; width: 100%; height: 18px;
        background: Theme.media_overlay;
        Text { text: vid.nombre; font-size: 7px; color: Theme.media_text; horizontal-alignment: center; vertical-alignment: center; overflow: elide; width: 100%; }
    }
    TouchArea { clicked => { root.seleccionar_galeria_item("cantos-vid", idx); } }
    Rectangle {
        width: 16px; height: 16px; x: parent.width - 20px; y: 4px; border-radius: Theme.radius_surface;
        background: Theme.media_overlay;
        TouchArea { clicked => { root.eliminar_galeria_item("cantos-vid", idx); } }
        Text { text: "✕"; color: Theme.danger; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; font-weight: Theme.font_weight_heading; }
    }
}
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    in-out property <bool> mostrar_menu_configuracion: false;
    changed mostrar_menu_configuracion => {
        if (!root.mostrar_menu_configuracion) { root.mostrar_menu_tema = false; }
    }
    private property <bool> mostrar_menu_tema: false;
    public function actualizar_paleta_widgets() {
        Palette.color-scheme = Theme.is_dark || Theme.is_black ? ColorScheme.dark : ColorScheme.light;
    }
    function seleccionar_tema(modo: int) {
        Theme.is_black = modo == 2;
        Theme.is_dark = modo != 0;
        root.actualizar_paleta_widgets();
        root.mostrar_menu_tema = false;
        root.mostrar_menu_configuracion = false;
        root.notificar_cambio_tema(Theme.is_dark);
    }
    in-out property <length> menu_configuracion_x: 0px;
    in-out property <length> menu_configuracion_y: 0px;

    in-out property <bool> mostrar_menu_herramientas: false;
    in-out property <length> menu_herramientas_x: 0px;
    in-out property <length> menu_herramientas_y: 0px;

    in-out property <bool> mostrar_menu_ayuda: false;
    in-out property <length> menu_ayuda_x: 0px;
    in-out property <length> menu_ayuda_y: 0px;

    in-out property <bool> mostrar_acerca_de: false;
    in-out property <string> acerca_version: "";
    in-out property <string> acerca_aceleracion: "";

    in-out property <bool> libreoffice_listo: false;
    in-out property <bool> instalando_libreoffice: false;
    in-out property <float> libreoffice_progreso: 0.0;
    in-out property <string> libreoffice_error: "";
    callback activar_soporte_pptx();
    in-out property <string> aviso_mensaje: "";

    // ══════════════════════════════════════════════════════════════
//  MENÚ DESPLEGABLE: CONFIGURACIÓN (Proyector + Tema)
// ══════════════════════════════════════════════════════════════
if (root.mostrar_menu_configuracion) : Rectangle {
    width: 100%; height: 100%; background: transparent;
    TouchArea { clicked => { root.mostrar_menu_configuracion = false; } }
    Rectangle {
        x: root.menu_configuracion_x; y: root.menu_configuracion_y;
        width: 175px; height: 145px;
        background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
        TouchArea {}
        VerticalLayout {
            padding: 4px; spacing: 2px;
            MenuItem {
                text: "Proyector"; icon: "";
                clicked => { root.mostrar_menu_configuracion = false; root.mostrar_modal_margenes = true; }
            }
            MenuItem {
                text: "Pantallas"; icon: "";
                clicked => {
                    root.mostrar_menu_configuracion = false;
                    root.mostrar_modal_pantallas = true;
                    root.abrir_modal_pantallas();
                }
            }
            MenuItem {
                text: "Configuración IA"; icon: "";
                clicked => {
                    root.mostrar_menu_configuracion = false;
                    root.temp_gemini_api_key = root.gemini_api_key;
                    root.config_ia_status_msg = "";
                    root.config_ia_es_error = false;
                    root.mostrar_modal_config_ia = true;
                }
            }
            MenuItem {
                text: "Tema: " + Theme.name; icon: ""; has_submenu: true;
                hovered => { root.mostrar_menu_tema = true; }
                clicked => { root.mostrar_menu_tema = true; }
            }
        }
    }
// Submenú lateral; permite pasar del elemento Tema a sus opciones.
    if (root.mostrar_menu_tema) : Rectangle {
        x: root.menu_configuracion_x + 173px; y: root.menu_configuracion_y + 106px;
        width: 175px; height: 108px;
        background: Theme.surface_popup;
        border-radius: Theme.radius_surface;
        border-width: 0px; border-color: Theme.border_strong;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.popup_shadow_blur;
        drop-shadow-offset-y: Theme.popup_shadow_offset;
        TouchArea {}
        VerticalLayout {
            padding: 4px; spacing: 2px;
            MenuItem {
                text: "Blanco"; selected: !Theme.is_dark && !Theme.is_black;
                clicked => { root.seleccionar_tema(0); }
            }
            MenuItem {
                text: "Azul oscuro"; selected: Theme.is_dark && !Theme.is_black;
                clicked => { root.seleccionar_tema(1); }
            }
            MenuItem {
                text: "Negro"; selected: Theme.is_black;
                clicked => { root.seleccionar_tema(2); }
            }
        }
    }
}

// ══════════════════════════════════════════════════════════════
//  MENÚ DESPLEGABLE: HERRAMIENTAS (Importar/Exportar)
// ══════════════════════════════════════════════════════════════
if (root.mostrar_respaldo_online) : Rectangle {
    width: 100%; height: 100%; background: Theme.media_overlay;
    TouchArea { clicked => { if (!root.respaldo_ocupado) { root.mostrar_respaldo_online = false; } } }
    Rectangle {
        width: 480px; height: 300px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface_popup;
        border-radius: Theme.radius_surface;
        TouchArea {}
        VerticalLayout {
            padding: 24px; spacing: 14px;
            Text { text: "Respaldo en línea"; font-size: 20px; color: Theme.text_primary; }
            Text { text: root.respaldo_estado; wrap: word-wrap; color: Theme.text_primary; }
            Text {
                text: "Inicia sesión en tu navegador y autoriza el acceso a Google Drive. Cantos y Biblias se guardan automáticamente cada 10 minutos.";
                wrap: word-wrap; font-size: 12px; color: Theme.text_secondary;
            }
            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: "Iniciar sesión con Google";
                    enabled: !root.respaldo_ocupado;
                    clicked => { root.respaldo_ocupado = true; root.respaldo_iniciar_sesion(); }
                }
                Button {
                    text: "Restaurar datos en este equipo";
                    enabled: !root.respaldo_ocupado;
                    clicked => { root.respaldo_ocupado = true; root.respaldo_restaurar(); }
                }
            }
            Button { text: "Cerrar"; enabled: !root.respaldo_ocupado; clicked => { root.mostrar_respaldo_online = false; } }
        }
    }
}

if (root.mostrar_menu_herramientas) : Rectangle {
    width: 100%; height: 100%; background: transparent;
    TouchArea { clicked => { root.mostrar_menu_herramientas = false; } }
    Rectangle {
        x: root.menu_herramientas_x; y: root.menu_herramientas_y;
        width: 200px; height: 146px;
        background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
        TouchArea {}
        VerticalLayout {
            padding: 4px; spacing: 2px;
            MenuItem {
                text: "Importar/Exportar"; icon: "";
                clicked => {
                    root.mostrar_menu_herramientas = false;
                    root.mostrar_modal_db = true;
                    root.abrir_modal_db();
                }
            }
            MenuItem {
                text: "Respaldo en línea";
                clicked => {
                    root.mostrar_menu_herramientas = false;
                    root.mostrar_respaldo_online = true;
                }
            }
            
            MenuItem {
                text: "Salida por IP (OBS)"; icon: "";
                clicked => {
                    root.mostrar_menu_herramientas = false;
                    root.mostrar_modal_overlay = true;
                    root.abrir_modal_overlay();
                }
            }

            MenuItem {
                text: root.libreoffice_listo ? "PPTX/ODP: Activado" : "Activar PPTX/ODP";
                icon: root.libreoffice_listo ? "" : "";
                text_color: root.libreoffice_listo ? Theme.success : Theme.menu_text;
                icon_color: root.libreoffice_listo ? Theme.success : Theme.menu_icon;
                clicked => {
                    root.mostrar_menu_herramientas = false;
                    if (!root.libreoffice_listo) {
                        root.activar_soporte_pptx();
                    }
                }
            }
        }
    }
}


// ══════════════════════════════════════════════════════════════
//  MENÚ DESPLEGABLE: AYUDA
// ══════════════════════════════════════════════════════════════
if (root.mostrar_menu_ayuda) : Rectangle {
    width: 100%; height: 100%; background: transparent;
    TouchArea { clicked => { root.mostrar_menu_ayuda = false; } }
    Rectangle {
        x: root.menu_ayuda_x; y: root.menu_ayuda_y;
        width: 170px; height: 40px;
        background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
        TouchArea {}
        VerticalLayout {
            padding: 4px; spacing: 2px;
            MenuItem {
                text: "Acerca de"; icon: "";
                clicked => {
                    root.mostrar_menu_ayuda = false;
                    root.mostrar_acerca_de = true;
                }
            }
        }
    }
}
// ══════════════════════════════════════════════════════════════
//  MODAL: ACERCA DE
// ══════════════════════════════════════════════════════════════
if (root.mostrar_acerca_de) : Rectangle {
    width: 100%; height: 100%; background: Theme.overlay;
    TouchArea { clicked => { root.mostrar_acerca_de = false; } }

    Rectangle {
        width: 520px; height: 560px;
        background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_modal;
        border-width: 0px; border-color: Theme.border_strong;
        TouchArea {}

        VerticalLayout {
            // ── Header ───────────────────────────────────────────────
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 20px;
                    Text { text: "ACERCA DE"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 2px; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle {
                        width: 32px; height: 32px; border-radius: Theme.radius_surface;
                        background: touch-close-acerca.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-acerca := TouchArea { clicked => { root.mostrar_acerca_de = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.separator; }

            // ── Contenido ────────────────────────────────────────────
            VerticalLayout {
                vertical-stretch: 1;
                padding-left: 32px; padding-right: 32px;
                padding-top: 28px; padding-bottom: 28px;
                spacing: 0px;

                // Nombre y versión, centrados y con más aire
                VerticalLayout {
                    alignment: center; spacing: 8px;
                    Text { text: "ReadyShow"; color: Theme.accent; font-size: 30px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; }
                    Rectangle {
                        width: 90px; height: 26px; border-radius: 13px;
                        background: Theme.accent_soft;
                        Text {
                            text: "Versión " + root.acerca_version;
                            color: Theme.accent; font-size: 11px; font-weight: Theme.font_weight_body;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                    }
                }

                Rectangle { height: 26px; }

                // Estado de aceleración — más aire y texto más grande
                Rectangle {
                    height: 58px; border-radius: 10px;
                    background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 12px;
                        Rectangle {
                            width: 32px; height: 32px; border-radius: Theme.radius_surface;
                            background: Theme.accent_soft;
                            Text { text: "⚙"; color: Theme.accent; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                        Text {
                            text: root.acerca_aceleracion;
                            color: Theme.text_secondary; font-size: 11px; font-weight: Theme.font_weight_body;
                            wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                        }
                    }
                }

                Rectangle { height: 24px; }

                // Licencia — ocupa el espacio restante, con buen padding interno
                Text { text: "LICENCIA MIT"; color: Theme.text_muted; font-size: 10px; font-weight: Theme.font_weight_heading; letter-spacing: 1.5px; height: 18px; }
                Rectangle { height: 8px; }
                Rectangle {
                    vertical-stretch: 1; border-radius: 10px;
                    background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                    clip: true;
                    ScrollView {
                        VerticalLayout {
                            padding: 18px;
                            Text {
                                text: "Copyright © 2025 Arbasante\n\nSe concede permiso, de forma gratuita, a cualquier persona que obtenga una copia de este software y de los archivos de documentación asociados, para utilizar el software sin restricción, incluyendo, sin limitación, los derechos de uso, copia, modificación, fusión, publicación, distribución, sublicencia y/o venta de copias del software, y a permitir a las personas a quienes se les proporcione el software hacerlo, sujeto a las siguientes condiciones:\n\nEl aviso de copyright anterior y este aviso de permiso se incluirán en todas las copias o partes sustanciales del software.\n\nEl software se proporciona \"tal cual\", sin garantía de ningún tipo, expresa o implícita, incluyendo pero sin limitarse a las garantías de comerciabilidad, idoneidad para un propósito particular y no infracción.";
                                color: Theme.text_secondary; font-size: 11px; wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}


    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL DE CANTO (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_canto) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        touch-dismiss := TouchArea { clicked => { root.mostrar_menu_canto = false; } }
        Rectangle {
            x: root.menu_x; y: root.menu_y;
            width: 185px; height: 114px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            touch-block := TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 0px;
                Rectangle { height: 34px; border-radius: Theme.radius_control; background: touch-add.has-hover ? Theme.accent_soft : transparent; touch-add := TouchArea { clicked => { root.mostrar_menu_canto = false; root.abrir_formulario_nuevo(); } } HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Agregar canto"; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } } }
                Rectangle { height: 34px; border-radius: Theme.radius_control; background: touch-edit.has-hover ? Theme.accent_soft : transparent; touch-edit := TouchArea { clicked => { root.mostrar_menu_canto = false; root.abrir_formulario_editar(root.menu_canto_id, root.menu_canto_titulo); } } HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Editar canto"; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } } }
                Rectangle { height: 1px; background: Theme.separator; }
                Rectangle { height: 34px; border-radius: Theme.radius_control; background: touch-del.has-hover ? Theme.danger_soft : transparent; touch-del := TouchArea { clicked => { root.mostrar_menu_canto = false; root.confirmar_eliminar_canto(root.menu_canto_id, root.menu_canto_titulo); } } HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { text: "Eliminar canto"; color: Theme.danger; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } } }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL SELECTOR DE COLOR (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_selector_color) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        touch-bg-color := TouchArea { clicked => { root.mostrar_selector_color = false; } }
        Rectangle {
            width: 330px; height: 210px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            touch-block-color := TouchArea {}
            VerticalLayout {
                padding: 16px; spacing: 16px;
                HorizontalLayout {
                    Text { text: "  Seleccionar Color"; color: Theme.text_primary; font-weight: Theme.font_weight_body; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle { width: 24px; height: 24px; border-radius: 4px; background: touch-close-col.has-hover ? Theme.bg_card_hover : transparent; touch-close-col := TouchArea { clicked => { root.mostrar_selector_color = false; } } Text { text: "✕"; color: Theme.text_secondary; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; } }
                }
                VerticalLayout {
                    spacing: 8px; alignment: center;
                    for row in root.paleta_colores : HorizontalLayout {
                        spacing: 8px; alignment: center;
                        for c in row : Rectangle {
                            width: 28px; height: 28px; border-radius: Theme.radius_control; background: c;
                            border-width: 1px; border-color: Theme.border_subtle;
                            touch-c := TouchArea {
                                clicked => {
                                    if (root.color_target == "biblias") { root.biblias_custom_color = c; root.biblias_font_color = c; }
                                    else { root.cantos_custom_color = c; root.cantos_font_color = c; }
                                    root.sync_estilos(); root.mostrar_selector_color = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL CONFIRMACIÓN ELIMINAR (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_confirmar_eliminar) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        touch-bg-elim := TouchArea { clicked => { root.mostrar_confirmar_eliminar = false; } }
        Rectangle {
            width: 360px; height: 170px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            touch-block-elim := TouchArea {}
            VerticalLayout {
                padding: 28px; spacing: 14px;
                Text { text: "Eliminar canto"; color: Theme.text_primary; font-size: 14px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; }
                Text { text: "\"" + root.menu_canto_titulo + "\" sera eliminado permanentemente."; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout { spacing: 12px; alignment: center;
                    Rectangle { width: 110px; height: 36px; border-radius: Theme.radius_control; background: touch-cancel.has-hover ? Theme.bg_card_hover : Theme.surface_input; border-width: 1px; border-color: Theme.border_strong; touch-cancel := TouchArea { clicked => { root.mostrar_confirmar_eliminar = false; } } Text { text: "Cancelar"; color: Theme.text_secondary; font-size: 11px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 110px; height: 36px; border-radius: Theme.radius_control; background: touch-confirm.has-hover ? Theme.danger_hover : Theme.danger_fill; touch-confirm := TouchArea { clicked => { root.eliminar_canto(root.menu_canto_id); root.mostrar_confirmar_eliminar = false; } } Text { text: "Eliminar"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL FORMULARIO AGREGAR / EDITAR (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_formulario) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 520px; height: 500px;
                    background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
                    VerticalLayout {
                        padding: 24px; spacing: 14px;
                        HorizontalLayout { alignment: space-between; height: 32px; Text { text: root.form_id == -1 ? "AGREGAR CANTO" : "EDITAR CANTO"; color: Theme.accent; font-size: 13px; font-weight: Theme.font_weight_heading; vertical-alignment: center; horizontal-stretch: 1; } Rectangle { width: 28px; height: 28px; border-radius: Theme.radius_control; background: touch-close-form.has-hover ? Theme.bg_card_hover : transparent; touch-close-form := TouchArea { clicked => { root.mostrar_formulario = false; } } Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } } }
                        Rectangle { height: 1px; background: Theme.bg_card_hover; }
                        VerticalLayout { spacing: 6px; height: 62px; Text { text: "TÍTULO"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; letter-spacing: 0.5px; height: 16px; } Rectangle { height: 38px; border-radius: Theme.radius_control; background: Theme.surface_input; border-width: 1px; border-color: Theme.border_subtle; TextInput { x: 12px; width: parent.width - 24px; height: 100%; text <=> root.form_titulo; color: Theme.text_primary; font-size: 12px; vertical-alignment: center; } } }
                        VerticalLayout { vertical-stretch: 1; spacing: 6px; Text { text: "LETRA  (separa estrofas con una línea vacía)"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; letter-spacing: 0.5px; height: 16px; } Rectangle { vertical-stretch: 1; border-radius: Theme.radius_control; background: Theme.surface_input; border-width: 1px; border-color: Theme.border_subtle; TextEdit { width: 100%; height: 100%; text <=> root.form_letra; font-size: 12px; } } }
                        HorizontalLayout { alignment: end; spacing: 12px; height: 38px;
                            Rectangle { width: 110px; height: 38px; border-radius: Theme.radius_control; background: touch-cancel2.has-hover ? Theme.bg_card_hover : Theme.surface_input; border-width: 1px; border-color: Theme.border_strong; touch-cancel2 := TouchArea { clicked => { root.mostrar_formulario = false; } } Text { text: "Cancelar"; color: Theme.text_secondary; font-size: 11px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                            Rectangle { width: 110px; height: 38px; border-radius: Theme.radius_control; background: touch-save.has-hover ? Theme.accent_hover : Theme.accent_fill; touch-save := TouchArea { clicked => { root.guardar_canto(root.form_id, root.form_titulo, root.form_letra); root.mostrar_formulario = false; } } Text { text: "Guardar"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; } }
                        }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MENÚ CONTEXTUAL PDF (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_menu_pdf) : Rectangle {
        width: 100%; height: 100%; background: transparent;
        TouchArea { clicked => { root.mostrar_menu_pdf = false; } }
        Rectangle {
            x: root.menu_pdf_x; y: root.menu_pdf_y;
            width: 180px; height: root.menu_pdf_idx != -1 ? 76px : 40px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface; border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 4px; spacing: 2px;
                MenuItem { text: "Importar PDF..."; icon: ""; clicked => { root.mostrar_menu_pdf = false; root.agregar_pdf(); } }
                if (root.menu_pdf_idx != -1) : HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Rectangle { height: 1px; background: Theme.separator; } }
                if (root.menu_pdf_idx != -1) : MenuItem { text: "Eliminar PDF"; icon: ""; text_color: Theme.danger; icon_color: Theme.danger; clicked => { root.mostrar_menu_pdf = false; root.eliminar_pdf(root.menu_pdf_idx); } }
            }
        }
    }


    //  MODAL DE MÁRGENES (adaptado al tema claro/oscuro)
    if (root.mostrar_modal_margenes) : Rectangle {
        width: 100%; height: 100%;
        background: Theme.overlay; // Capa de atenuación del tema
        TouchArea {} // Para bloquear clics debajo

        Rectangle {
            width: 400px; height: 350px;
            
            // 1. Fondo oscuro y un borde sutil
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset;
            border-radius: Theme.radius_surface;
            border-width: 0px;
            border-color: Theme.border_strong;
            
            VerticalLayout {
                padding: 20px;
                spacing: 15px;

               Text { 
                   text: "Márgenes de Proyección"; 
                   font-size: 18px; 
                   font-weight: Theme.font_weight_body;
                   horizontal-alignment: center; 
                   color: Theme.text_primary; // Texto blanco
               }

                HorizontalLayout {
                    Text { text: "Superior:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 300; value: root.margen_superior;
                        changed(val) => { root.margen_superior = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_superior); width: 30px; color: Theme.accent; font-weight: Theme.font_weight_body; } // Valor en azul
                }
                HorizontalLayout {
                    Text { text: "Inferior:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 300; value: root.margen_inferior;
                        changed(val) => { root.margen_inferior = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_inferior); width: 30px; color: Theme.accent; font-weight: Theme.font_weight_body; }
                }
                HorizontalLayout {
                    Text { text: "Izquierdo:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 500; value: root.margen_izquierdo;
                        changed(val) => { root.margen_izquierdo = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_izquierdo); width: 30px; color: Theme.accent; font-weight: Theme.font_weight_body; }
                }
                HorizontalLayout {
                    Text { text: "Derecho:"; vertical-alignment: center; width: 80px; color: Theme.text_secondary; }
                    Slider { 
                        minimum: 0; maximum: 500; value: root.margen_derecho;
                        changed(val) => { root.margen_derecho = val; root.actualizar_margenes(root.margen_izquierdo, root.margen_derecho, root.margen_superior, root.margen_inferior); }
                    }
                    Text { text: floor(root.margen_derecho); width: 30px; color: Theme.accent; font-weight: Theme.font_weight_body; }
                }

                // El botón estándar de Slint se adapta al tema del sistema. 
                // Si en tu PC se sigue viendo blanco y desentona mucho, avísame y te armo un botón oscuro personalizado.
                Button {
                    text: "Cerrar";
                    clicked => { root.mostrar_modal_margenes = false; }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL DE PANTALLAS (mapa visual + identificación)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_modal_pantallas) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.mostrar_modal_pantallas = false; } }

        Rectangle {
            width: 560px; height: 420px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
            border-width: 0px; border-color: Theme.border_strong;
            TouchArea {} // bloquea el clic hacia el backdrop

            VerticalLayout {
                padding: 24px; spacing: 16px;

                HorizontalLayout {
                    alignment: space-between; height: 30px;
                    Text { text: "PANTALLAS"; color: Theme.text_primary; font-size: 15px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: Theme.radius_control;
                        background: touch-close-pant.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-pant := TouchArea { clicked => { root.mostrar_modal_pantallas = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Text {
                    text: root.pantallas_detectadas.length == 0
                        ? "No se detectaron pantallas."
                        : root.pantallas_detectadas.length + " pantalla(s) detectada(s).";
                    color: Theme.text_secondary; font-size: 11px; font-weight: Theme.font_weight_body;
                }

                // ── MAPA VISUAL (escala relativa a la posición real) ──
                Rectangle {
                    height: 220px; border-radius: Theme.radius_surface; background: Theme.surface_list;
                    border-width: 0px; border-color: Theme.border_subtle; clip: true;

                    for pantalla[idx] in root.pantallas_detectadas : Rectangle {
                        x: 20px + pantalla.x * 0.12px;
                        y: 20px + pantalla.y * 0.12px;
                        width: max(96px, pantalla.width * 0.12px);
                        height: max(78px, pantalla.height * 0.12px);
                        border-radius: Theme.radius_control;
                        background: pantalla.rol > 0 ? Theme.accent_soft : Theme.surface_card;
                        border-width: 2px;
                        border-color: pantalla.rol > 0 ? Theme.accent : transparent;

                        VerticalLayout {
                            padding: 4px; spacing: 2px; alignment: center;
                            Text { text: "Pantalla " + (idx + 1); color: Theme.text_primary; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
                            Text { text: pantalla.width + "×" + pantalla.height; color: Theme.text_muted; font-size: 7px; horizontal-alignment: center; }
                            Text {
                                text: pantalla.rol == 1 ? "OPERADOR" : pantalla.rol == 2 ? "PROYECTOR" : pantalla.rol == 3 ? "STAGE DISPLAY" : "Sin asignar";
                                color: (pantalla.rol > 0 ? Theme.accent : Theme.text_muted);
                                font-size: 7px; font-weight: Theme.font_weight_body; horizontal-alignment: center;
                            }
                            Rectangle { height: 4px; }
                            // Selector de rol: 3 botones pequeños
                            HorizontalLayout {
                                spacing: 3px; alignment: center;
                                Rectangle {
                                    width: 20px; height: 18px; border-radius: 4px;
                                    background: pantalla.rol == 1 ? Theme.accent_fill : Theme.bg_card;
                                    TouchArea { clicked => { root.asignar_rol_pantalla(pantalla.id, pantalla.rol == 1 ? 0 : 1); } }
                                    Text { text: "1"; color: pantalla.rol == 1 ? Theme.text_on_accent : Theme.text_primary; font-size: 9px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 20px; height: 18px; border-radius: 4px;
                                    background: pantalla.rol == 2 ? Theme.accent_fill : Theme.bg_card;
                                    TouchArea { clicked => { root.asignar_rol_pantalla(pantalla.id, pantalla.rol == 2 ? 0 : 2); } }
                                    Text { text: "2"; color: pantalla.rol == 2 ? Theme.text_on_accent : Theme.text_primary; font-size: 9px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 20px; height: 18px; border-radius: 4px;
                                    background: pantalla.rol == 3 ? Theme.accent_fill : Theme.bg_card;
                                    TouchArea { clicked => { root.asignar_rol_pantalla(pantalla.id, pantalla.rol == 3 ? 0 : 3); } }
                                    Text { text: "3"; color: pantalla.rol == 3 ? Theme.text_on_accent : Theme.text_primary; font-size: 9px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 4px;
                            background: root.auto_proyectar_inicio ? Theme.accent_fill : Theme.surface_input;
                            border-width: 1px; border-color: Theme.border_input;
                            TouchArea {
                                clicked => {
                                    root.auto_proyectar_inicio = !root.auto_proyectar_inicio;
                                    root.aplicar_cambios_pantallas();
                                }
                            }
                            if (root.auto_proyectar_inicio) : Text { text: "✓"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                        }
                        Text { text: "Abrir proyector automáticamente al iniciar"; color: Theme.text_secondary; font-size: 10px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                    }
                }

                Text {
                    text: "1 = Pantalla Operador   ·   2 = Proyector (Live)   ·   3 = Stage Display";
                    color: Theme.text_muted; font-size: 9px; font-weight: Theme.font_weight_body; horizontal-alignment: center;
                }

                
                // ── BOTONES: IDENTIFICAR + APLICAR CAMBIOS ──
                HorizontalLayout {
                    height: 42px; spacing: 10px;
                    Rectangle {
                        horizontal-stretch: 1; border-radius: Theme.radius_surface;
                        background: identificar-touch.has-hover ? Theme.accent_hover : Theme.accent_fill;
                        identificar-touch := TouchArea {
                            clicked => { root.identificar_pantallas(); }
                        }
                        Text {
                            text: root.identificando_pantallas ? "Mostrando números..." : "Identificar Pantallas";
                            color: Theme.text_on_accent; font-size: 12px; font-weight: Theme.font_weight_body;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    if (root.cambios_pendientes) : Rectangle {
                        width: 140px; border-radius: Theme.radius_surface;
                        background: aplicar-touch.has-hover ? Theme.success_fill : Theme.success_fill;
                        aplicar-touch := TouchArea {
                            clicked => { root.aplicar_cambios_pantallas(); }
                        }
                        Text {
                            text: "Aplicar Cambios";
                            color: Theme.text_on_accent; font-size: 12px; font-weight: Theme.font_weight_body;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

        if (root.mostrar_modal_overlay) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.mostrar_modal_overlay = false; } }

        Rectangle {
            width: 460px; height: 380px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
            border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}

            VerticalLayout {
                padding: 24px; spacing: 14px;

                HorizontalLayout {
                    alignment: space-between; height: 30px;
                    Text { text: "SALIDA POR IP (OBS)"; color: Theme.text_primary; font-size: 14px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: Theme.radius_control;
                        background: touch-close-ov.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-ov := TouchArea { clicked => { root.mostrar_modal_overlay = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Text {
                    text: "Agrega una fuente de \"Navegador\" en OBS con esta URL para mostrar el texto proyectado como overlay.";
                    color: Theme.text_secondary; font-size: 10px; wrap: word-wrap;
                }

                // ── URL + botón copiar ────────────────────────────────────
                Rectangle {
                    height: 48px; border-radius: Theme.radius_surface; background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                    HorizontalLayout {
                        padding-left: 11px; padding-right: 11px; spacing: 8px;
                        Text {
                            text: "http://" + root.overlay_ip_local + ":" + root.overlay_puerto;
                            color: Theme.accent; font-size: 13px; font-weight: Theme.font_weight_body;
                            vertical-alignment: center; horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 64px; height: 32px; border-radius: Theme.radius_control;
                            background: touch-copiar-url.has-hover ? Theme.accent_soft : Theme.bg_card;
                            border-width: 1px; border-color: Theme.border_subtle;
                            touch-copiar-url := TouchArea { clicked => { root.copiar_url_overlay(); } }
                            Text {
                                text: "Copiar";
                                color: (touch-copiar-url.has-hover ? Theme.accent : Theme.text_secondary);
                                font-size: 11px; font-weight: Theme.font_weight_body;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px; height: 30px;
                    Text { text: "Puerto:"; color: Theme.text_secondary; font-size: 11px; vertical-alignment: center; }
                    Rectangle {
                        width: 90px; height: 30px; border-radius: Theme.radius_control; background: Theme.surface_input; border-width: 1px; border-color: Theme.border_input;
                        TextInput {
                            text: root.overlay_puerto;
                            color: Theme.text_primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
                            input-type: number;
                            edited => {
                                if (self.text.to-float() > 1024 && self.text.to-float() < 65535) {
                                    root.overlay_puerto = self.text.to-float();
                                }
                            }
                        }
                    }
                }

                // ── Checkbox: Solo texto (sin fondo) ─────────────────────
                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 18px; height: 18px; border-radius: 4px;
                            background: root.overlay_solo_texto ? Theme.accent_fill : Theme.surface_input;
                            border-width: 1px; border-color: Theme.border_input;
                            TouchArea {
                                clicked => {
                                    root.toggle_overlay_solo_texto(!root.overlay_solo_texto);
                                }
                            }
                            if (root.overlay_solo_texto) : Text {
                                text: "✓"; color: Theme.text_on_accent; font-size: 12px; font-weight: Theme.font_weight_heading;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                        }
                        Text {
                            text: "Solo texto (sin fondo)";
                            color: Theme.text_secondary; font-size: 10px; font-weight: Theme.font_weight_body;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    height: 42px; border-radius: Theme.radius_surface;
                    background: root.overlay_servidor_activo ? Theme.danger_fill : Theme.accent_fill;
                    TouchArea { clicked => { root.toggle_servidor_overlay(); } }
                    Text {
                        text: root.overlay_servidor_activo ? "Detener Servidor" : "Iniciar Servidor";
                        color: Theme.text_on_accent; font-size: 12px; font-weight: Theme.font_weight_body;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }
        }
    }

    

    // ══════════════════════════════════════════════════════════════
    //  OVERLAY DE PROGRESO DE IMPORTACIÓN PDF (adaptado al tema claro/oscuro)
    // ══════════════════════════════════════════════════════════════
    if (root.is_importing_pdf) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea {} // Bloquea clics traseros
        VerticalLayout {
            alignment: center; spacing: 16px;
            Text { text: " PROCESANDO PDF"; color: Theme.text_primary; font-size: 16px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; letter-spacing: 2px;}
            Text { text: root.pdf_import_filename; color: Theme.accent; font-size: 13px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
            Text { text: "Convirtiendo páginas a imágenes de alta calidad para una proyección fluida..."; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; }
            
            Rectangle { height: 16px; } // Espaciador
            
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 400px; height: 16px; background: Theme.bg_card_hover; border-radius: Theme.radius_surface;
                    Rectangle { x: 0; width: parent.width * root.pdf_import_progress; height: 100%; background: Theme.accent_fill; border-radius: Theme.radius_surface; }
                }
            }
            Text { text: round(root.pdf_import_progress * 100) + "% completado"; color: Theme.text_primary; font-size: 12px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  OVERLAY: INSTALANDO LIBREOFFICE (soporte PPTX/ODP)
    // ══════════════════════════════════════════════════════════════
    if (root.instalando_libreoffice) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea {}
        VerticalLayout {
            alignment: center; spacing: 16px;
            Text { text: " INSTALANDO SOPORTE PPTX/ODP"; color: Theme.text_primary; font-size: 16px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; letter-spacing: 2px; }
            Text { text: "Esto puede tardar unos minutos. No cierres la aplicación."; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; }
            Rectangle { height: 16px; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 400px; height: 16px; background: Theme.bg_card_hover; border-radius: Theme.radius_surface;
                    Rectangle { x: 0; width: parent.width * root.libreoffice_progreso; height: 100%; background: Theme.accent_fill; border-radius: Theme.radius_surface; }
                }
            }
            Text { text: root.libreoffice_progreso > 0 ? round(root.libreoffice_progreso * 100) + "% completado" : "Preparando..."; color: Theme.text_primary; font-size: 12px; font-weight: Theme.font_weight_body; horizontal-alignment: center; }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  OVERLAY: ERROR AL INSTALAR LIBREOFFICE
    // ══════════════════════════════════════════════════════════════
   if (root.libreoffice_error != "") : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.libreoffice_error = ""; } }
        Rectangle {
            width: 380px; height: 180px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
            border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}
            VerticalLayout {
                padding: 24px; spacing: 12px;
                Text { text: " No se pudo instalar"; color: Theme.danger; font-size: 14px; font-weight: Theme.font_weight_heading; horizontal-alignment: center; }
                Text { text: root.libreoffice_error; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                Rectangle {
                    height: 36px; border-radius: Theme.radius_control; background: Theme.accent_fill;
                    TouchArea { clicked => { root.libreoffice_error = ""; } }
                    Text { text: "Entendido"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }

        // ══════════════════════════════════════════════════════════════
    //  BANNER: AVISO BREVE (archivo faltante, etc.) — ligero, sin blur
    // ══════════════════════════════════════════════════════════════
    if (root.aviso_mensaje != "") : Rectangle {
        y: parent.height - 70px; x: (parent.width - 420px) / 2;
        width: 420px; height: 46px;
        background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
        border-width: 0px; border-color: Theme.danger;
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 10px;
            Text { text: "⚠"; color: Theme.danger; font-size: 16px; vertical-alignment: center; }
            Text {
                text: root.aviso_mensaje; color: Theme.text_primary; font-size: 10px; font-weight: Theme.font_weight_body;
                vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap;
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL: IMPORTAR / EXPORTAR BASES DE DATOS
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_modal_db) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.mostrar_modal_db = false; } }

        Rectangle {
            width: 560px; height: 440px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
            border-width: 0px; border-color: Theme.border_strong;
            TouchArea {} // bloquea clics hacia el fondo

            VerticalLayout {
                padding: 22px; spacing: 12px;

                // ── Cabecera ──────────────────────────────────────
                HorizontalLayout {
                    alignment: space-between; height: 28px;
                    Text { text: "IMPORTAR Y EXPORTAR BASES DE DATOS"; color: Theme.text_primary; font-size: 13px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: Theme.radius_control;
                        background: touch-close-db.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-db := TouchArea { clicked => { root.mostrar_modal_db = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Text {
                    text: "Respalda o restaura tus archivos de base de datos SQLite (.db). Al importar, se validará el esquema y se aplicarán los índices optimizados automáticamente.";
                    color: Theme.text_secondary; font-size: 10px; wrap: word-wrap;
                }

                // ── Tarjeta: Base de datos de Cantos ──────────────
                Rectangle {
                    height: 120px; border-radius: Theme.radius_surface; background: Theme.surface_list;
                    border-width: 0px; border-color: Theme.border_subtle;
                    VerticalLayout {
                        padding: 12px; spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Base de Datos de Cantos (cantos.db)"; color: Theme.text_primary; font-size: 12px; font-weight: Theme.font_weight_body; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        Text {
                            text: "Contiene el repertorio de alabanzas, estrofas y versículos favoritos.";
                            color: Theme.text_muted; font-size: 9px;
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            spacing: 10px; height: 34px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: Theme.radius_control;
                                background: touch-exp-cantos.has-hover ? Theme.bg_card_hover : Theme.surface_card;
                                border-width: 1px; border-color: Theme.border_strong;
                                touch-exp-cantos := TouchArea { clicked => { root.exportar_db_cantos(); } }
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "Exportar Cantos"; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: Theme.radius_control;
                                background: touch-imp-cantos.has-hover ? Theme.accent_hover : Theme.accent_fill;
                                touch-imp-cantos := TouchArea { clicked => { root.importar_db_cantos(); } }
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "Importar Cantos"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // ── Tarjeta: Base de datos de Biblias ─────────────
                Rectangle {
                    height: 120px; border-radius: Theme.radius_surface; background: Theme.surface_list;
                    border-width: 0px; border-color: Theme.border_subtle;
                    VerticalLayout {
                        padding: 12px; spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Base de Datos de Biblias (biblias.db)"; color: Theme.text_primary; font-size: 12px; font-weight: Theme.font_weight_body; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        Text {
                            text: "Contiene todas las versiones de la Biblia, libros y versículos indexados.";
                            color: Theme.text_muted; font-size: 9px;
                        }
                        Rectangle { vertical-stretch: 1; }
                        HorizontalLayout {
                            spacing: 10px; height: 34px;
                            Rectangle {
                                horizontal-stretch: 1; border-radius: Theme.radius_control;
                                background: touch-exp-biblias.has-hover ? Theme.bg_card_hover : Theme.surface_card;
                                border-width: 1px; border-color: Theme.border_strong;
                                touch-exp-biblias := TouchArea { clicked => { root.exportar_db_biblias(); } }
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "Exportar Biblias"; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1; border-radius: Theme.radius_control;
                                background: touch-imp-biblias.has-hover ? Theme.accent_hover : Theme.accent_fill;
                                touch-imp-biblias := TouchArea { clicked => { root.importar_db_biblias(); } }
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "Importar Biblias"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // ── Mensaje de estado / resultado ─────────────────
                if (root.db_modal_mensaje != "") : Rectangle {
                    height: 38px; border-radius: Theme.radius_control;
                    background: root.db_modal_es_error ? Theme.danger_soft : Theme.success_soft;
                    border-width: 1px;
                    border-color: root.db_modal_es_error ? Theme.danger : Theme.success;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Text {
                            text: root.db_modal_es_error ? "⚠" : "✓";
                            color: (root.db_modal_es_error ? Theme.danger : Theme.success);
                            font-size: 13px; font-weight: Theme.font_weight_heading; vertical-alignment: center;
                        }
                        Text {
                            text: root.db_modal_mensaje;
                            color: Theme.text_primary; font-size: 10px; font-weight: Theme.font_weight_body;
                            vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap;
                        }
                        Rectangle {
                            width: 20px; height: 20px; border-radius: 4px;
                            touch-clr-msg := TouchArea { clicked => { root.db_modal_mensaje = ""; } }
                            Text { text: "✕"; color: Theme.text_muted; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  OVERLAY DE OSCURECIMIENTO: IMPORTANDO Y OPTIMIZANDO DB
    // ══════════════════════════════════════════════════════════════
    if (root.is_importing_db) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea {} // Bloquea cualquier clic
        VerticalLayout {
            alignment: center; spacing: 14px;
            Text {
                text: "IMPORTANDO BASE DE DATOS";
                color: Theme.text_primary; font-size: 16px; font-weight: Theme.font_weight_heading;
                horizontal-alignment: center; letter-spacing: 2px;
            }
            Text {
                text: root.db_import_status != "" ? root.db_import_status : "Validando esquema, aplicando índices y optimizando rendimiento...";
                color: Theme.accent; font-size: 12px; font-weight: Theme.font_weight_body;
                horizontal-alignment: center;
            }
            Text {
                text: "Por favor espera un momento, no cierres la aplicación.";
                color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center;
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL: AVISO IA (API KEY NO CONFIGURADA)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_modal_aviso_ia) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.mostrar_modal_aviso_ia = false; } }

        Rectangle {
            width: 480px; height: 230px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
            border-width: 0px; border-color: Theme.border_strong;
            TouchArea {} // Evita propagar clic al fondo

            VerticalLayout {
                padding: 22px; spacing: 14px;

                HorizontalLayout {
                    alignment: space-between; height: 28px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "⚠"; color: Theme.warning; font-size: 16px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                        Text { text: "CONFIGURACIÓN DE IA REQUERIDA"; color: Theme.text_primary; font-size: 13px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: Theme.radius_control;
                        background: touch-close-aviso-ia.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-aviso-ia := TouchArea { clicked => { root.mostrar_modal_aviso_ia = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Text {
                    text: "Para generar imágenes con Inteligencia Artificial, primero debes establecer tu API Key de Google Gemini en la configuración del sistema.";
                    color: Theme.text_secondary; font-size: 12px; wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end; spacing: 10px; height: 36px;
                    Rectangle {
                        width: 100px; border-radius: Theme.radius_control;
                        background: touch-cancel-aviso.has-hover ? Theme.bg_card_hover : Theme.surface_card;
                        border-width: 1px; border-color: Theme.border_strong;
                        touch-cancel-aviso := TouchArea { clicked => { root.mostrar_modal_aviso_ia = false; } }
                        HorizontalLayout { alignment: center; Text { text: "Cerrar"; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } }
                    }
                    Rectangle {
                        width: 170px; border-radius: Theme.radius_control;
                        background: touch-ir-cfg.has-hover ? Theme.accent_hover : Theme.accent_fill;
                        touch-ir-cfg := TouchArea {
                            clicked => {
                                root.mostrar_modal_aviso_ia = false;
                                root.temp_gemini_api_key = root.gemini_api_key;
                                root.config_ia_status_msg = "";
                                root.config_ia_es_error = false;
                                root.mostrar_modal_config_ia = true;
                            }
                        }
                        HorizontalLayout { alignment: center; Text { text: "Configurar API Key"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL: CONFIGURACIÓN IA (API KEY DE GEMINI)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_modal_config_ia) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { clicked => { root.mostrar_modal_config_ia = false; } }

        Rectangle {
            width: 520px; height: 320px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
            border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}

            VerticalLayout {
                padding: 22px; spacing: 14px;

                HorizontalLayout {
                    alignment: space-between; height: 28px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "✨"; font-size: 15px; vertical-alignment: center; }
                        Text { text: "CONFIGURACIÓN IA (GOOGLE GEMINI)"; color: Theme.text_primary; font-size: 13px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: Theme.radius_control;
                        background: touch-close-cfg-ia.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-cfg-ia := TouchArea { clicked => { root.mostrar_modal_config_ia = false; } }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Text {
                    text: "Ingresa tu API Key de Gemini para activar la creación de fondos para cantos, biblias e imágenes informativas con IA.";
                    color: Theme.text_secondary; font-size: 11px; wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 6px;
                    Text { text: "GEMINI API KEY"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; letter-spacing: 0.5px; }
                    Rectangle {
                        height: 38px; border-radius: Theme.radius_control;
                        background: Theme.surface_input; border-width: 1px; border-color: Theme.border_subtle;
                        TextInput {
                            x: 12px; width: parent.width - 24px; height: 100%;
                            text <=> root.temp_gemini_api_key;
                            color: Theme.text_primary; font-size: 12px; vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "💡 Puedes obtener tu API Key gratuita en Google AI Studio (aistudio.google.com). Se guarda en tu equipo local.";
                    color: Theme.text_muted; font-size: 9px; wrap: word-wrap;
                }

                if (root.config_ia_status_msg != "") : Rectangle {
                    height: 32px; border-radius: Theme.radius_control;
                    background: root.config_ia_es_error ? Theme.danger_soft : Theme.success_soft;
                    border-width: 1px; border-color: root.config_ia_es_error ? Theme.danger : Theme.success;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        Text { text: root.config_ia_status_msg; color: (root.config_ia_es_error ? Theme.danger : Theme.success); font-size: 10px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end; spacing: 10px; height: 36px;
                    Rectangle {
                        width: 100px; border-radius: Theme.radius_control;
                        background: touch-can-cfgia.has-hover ? Theme.bg_card_hover : Theme.surface_card;
                        border-width: 1px; border-color: Theme.border_strong;
                        touch-can-cfgia := TouchArea { clicked => { root.mostrar_modal_config_ia = false; } }
                        HorizontalLayout { alignment: center; Text { text: "Cerrar"; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } }
                    }
                    Rectangle {
                        width: 130px; border-radius: Theme.radius_control;
                        background: touch-sav-cfgia.has-hover ? Theme.accent_hover : Theme.accent_fill;
                        touch-sav-cfgia := TouchArea { clicked => { root.guardar_gemini_api_key(root.temp_gemini_api_key); } }
                        HorizontalLayout { alignment: center; Text { text: "Guardar API Key"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } }
                    }
                }
            }
        }
    }

    // ══════════════════════════════════════════════════════════════
    //  MODAL: GENERADOR DE IMÁGENES IA (GEMINI)
    // ══════════════════════════════════════════════════════════════
    if (root.mostrar_modal_generar_ia) : Rectangle {
        width: 100%; height: 100%; background: Theme.overlay;
        TouchArea { 
            clicked => { 
                if (!root.ia_generando) {
                    root.mostrar_modal_generar_ia = false; 
                }
            } 
        }

        Rectangle {
            width: 620px; height: 500px;
            background: Theme.surface_popup;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: Theme.popup_shadow_blur;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Theme.popup_shadow_offset; border-radius: Theme.radius_surface;
            border-width: 0px; border-color: Theme.border_strong;
            TouchArea {}

            VerticalLayout {
                padding: 22px; spacing: 14px;

                // ── Encabezado ──
                HorizontalLayout {
                    alignment: space-between; height: 28px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "✨"; font-size: 16px; vertical-alignment: center; }
                        Text { text: "GENERADOR DE IMÁGENES CON IA"; color: Theme.text_primary; font-size: 13px; font-weight: Theme.font_weight_heading; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: Theme.radius_control;
                        background: touch-close-gen-ia.has-hover ? Theme.bg_card_hover : transparent;
                        touch-close-gen-ia := TouchArea { 
                            clicked => { 
                                if (!root.ia_generando) {
                                    root.mostrar_modal_generar_ia = false; 
                                }
                            } 
                        }
                        Text { text: "✕"; color: Theme.text_secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // ── Selector de Tipo de Imagen (3 Botones) ──
                Text { text: "¿QUÉ DESEAS GENERAR?"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; letter-spacing: 0.5px; }

                HorizontalLayout {
                    spacing: 10px; height: 56px;

                    // Opción 1: Fondo de Cantos
                    Rectangle {
                        horizontal-stretch: 1; border-radius: Theme.radius_surface;
                        background: root.ia_tipo_seleccionado == "cantos" ? Theme.accent_soft : (touch-opt-c.has-hover ? Theme.bg_card_hover : Theme.surface_card);
                        border-width: root.ia_tipo_seleccionado == "cantos" ? 2px : 1px;
                        border-color: root.ia_tipo_seleccionado == "cantos" ? Theme.accent : Theme.border_strong;
                        touch-opt-c := TouchArea {
                            clicked => { root.ia_tipo_seleccionado = "cantos"; }
                        }
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            HorizontalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: "🎵"; font-size: 12px; vertical-alignment: center; }
                                Text { text: "Fondo de Cantos"; color: (root.ia_tipo_seleccionado == "cantos" ? Theme.accent : Theme.text_primary); font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                            }
                            Text { text: "Para alabanzas y letras"; color: Theme.text_muted; font-size: 9px; horizontal-alignment: center; }
                        }
                    }

                    // Opción 2: Fondo de Biblias
                    Rectangle {
                        horizontal-stretch: 1; border-radius: Theme.radius_surface;
                        background: root.ia_tipo_seleccionado == "biblias" ? Theme.accent_soft : (touch-opt-b.has-hover ? Theme.bg_card_hover : Theme.surface_card);
                        border-width: root.ia_tipo_seleccionado == "biblias" ? 2px : 1px;
                        border-color: root.ia_tipo_seleccionado == "biblias" ? Theme.accent : Theme.border_strong;
                        touch-opt-b := TouchArea {
                            clicked => { root.ia_tipo_seleccionado = "biblias"; }
                        }
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            HorizontalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: "📖"; font-size: 12px; vertical-alignment: center; }
                                Text { text: "Fondo de Biblias"; color: (root.ia_tipo_seleccionado == "biblias" ? Theme.accent : Theme.text_primary); font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                            }
                            Text { text: "Para lectura y versículos"; color: Theme.text_muted; font-size: 9px; horizontal-alignment: center; }
                        }
                    }

                    // Opción 3: Imagen Informativa
                    Rectangle {
                        horizontal-stretch: 1; border-radius: Theme.radius_surface;
                        background: root.ia_tipo_seleccionado == "informativa" ? Theme.accent_soft : (touch-opt-i.has-hover ? Theme.bg_card_hover : Theme.surface_card);
                        border-width: root.ia_tipo_seleccionado == "informativa" ? 2px : 1px;
                        border-color: root.ia_tipo_seleccionado == "informativa" ? Theme.accent : Theme.border_strong;
                        touch-opt-i := TouchArea {
                            clicked => { root.ia_tipo_seleccionado = "informativa"; }
                        }
                        VerticalLayout {
                            alignment: center; spacing: 2px;
                            HorizontalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: "🖼️"; font-size: 12px; vertical-alignment: center; }
                                Text { text: "Informativa"; color: (root.ia_tipo_seleccionado == "informativa" ? Theme.accent : Theme.text_primary); font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                            }
                            Text { text: "Avisos y eventos (IMGS)"; color: Theme.text_muted; font-size: 9px; horizontal-alignment: center; }
                        }
                    }
                }

                // ── Explicación de destino / optimización de prompt ──
                Rectangle {
                    height: 38px; border-radius: Theme.radius_control;
                    background: Theme.surface_list; border-width: 0px; border-color: Theme.border_subtle;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        Text {
                            text: root.ia_tipo_seleccionado == "cantos" ? "🎵 Se creará un fondo 16:9 con iluminación cinematográfica y centro despejado para letras legibles. Se aplicará a Cantos." : (root.ia_tipo_seleccionado == "biblias" ? "📖 Se creará un fondo sobrio y reverente en alta definición optimizado para lectura bíblica. Se aplicará a Biblias." : "🖼️ Se creará una imagen informativa completa para presentaciones o avisos. Se añadirá a la sección IMGS.");
                            color: Theme.text_secondary; font-size: 10px; vertical-alignment: center; wrap: word-wrap;
                        }
                    }
                }

                // ── Campo de Prompt ──
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "DESCRIBE LA IMAGEN QUE DESEAS (PROMPT)"; color: Theme.text_secondary; font-size: 9px; font-weight: Theme.font_weight_body; letter-spacing: 0.5px; }
                    Rectangle {
                        height: 70px; border-radius: Theme.radius_control;
                        background: Theme.surface_input; border-width: 1px; border-color: Theme.border_subtle;
                        TextInput {
                            x: 10px; y: 6px; width: parent.width - 20px; height: parent.height - 12px;
                            text <=> root.ia_prompt_usuario;
                            color: Theme.text_primary; font-size: 12px;
                        }
                    }
                }

                Text {
                    text: "Sugerencia: Puedes indicar colores, iluminación o elementos como 'Atardecer cálido con silueta de montañas', 'Cielo nocturno con estrellas y nebulosa suave', o 'Reunión de jóvenes con estilo moderno'.";
                    color: Theme.text_muted; font-size: 9px; wrap: word-wrap;
                }

                // ── Mensaje de estado / resultado ──
                if (root.ia_status_msg != "") : Rectangle {
                    height: 36px; border-radius: Theme.radius_control;
                    background: root.ia_generando ? Theme.accent_soft : (root.ia_es_error ? Theme.danger_soft : Theme.success_soft);
                    border-width: 1px;
                    border-color: root.ia_generando ? Theme.accent : (root.ia_es_error ? Theme.danger : Theme.success);
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Text {
                            text: root.ia_generando ? "⏳" : (root.ia_es_error ? "⚠" : "✓");
                            color: (root.ia_generando ? Theme.accent : (root.ia_es_error ? Theme.danger : Theme.success));
                            font-size: 13px; font-weight: Theme.font_weight_heading; vertical-alignment: center;
                        }
                        Text {
                            text: root.ia_status_msg;
                            color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body;
                            vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ── Botones de Acción ──
                HorizontalLayout {
                    alignment: end; spacing: 10px; height: 38px;
                    Rectangle {
                        width: 100px; border-radius: Theme.radius_control;
                        background: touch-can-genia.has-hover ? Theme.bg_card_hover : Theme.surface_card;
                        border-width: 1px; border-color: Theme.border_strong;
                        touch-can-genia := TouchArea { 
                            clicked => { 
                                if (!root.ia_generando) {
                                    root.mostrar_modal_generar_ia = false; 
                                }
                            } 
                        }
                        HorizontalLayout { alignment: center; Text { text: "Cerrar"; color: Theme.text_primary; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; } }
                    }
                    Rectangle {
                        width: 160px; border-radius: Theme.radius_control;
                        background: root.ia_generando ? Theme.disabled_fill : (touch-gen-btn.has-hover ? Theme.accent_hover : Theme.accent_fill);
                        touch-gen-btn := TouchArea { 
                            clicked => { 
                                if (!root.ia_generando && root.ia_prompt_usuario != "") {
                                    root.generar_imagen_ia(root.ia_tipo_seleccionado, root.ia_prompt_usuario);
                                }
                            } 
                        }
                        HorizontalLayout { 
                            alignment: center; spacing: 6px;
                            Text { text: root.ia_generando ? "⏳ Generando..." : "✨ Generar Imagen"; color: Theme.text_on_accent; font-size: 11px; font-weight: Theme.font_weight_body; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
