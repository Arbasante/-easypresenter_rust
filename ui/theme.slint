export global Theme {
    in-out property <bool> is_dark: false;
    in-out property <bool> is_black: false;
    out property <string> name: root.is_black ? "Negro" : (root.is_dark ? "Azul oscuro" : "Blanco");

    out property <color> bg_main: root.is_black ? BlackPalette.bg_main : (root.is_dark ? NavyPalette.bg_main : LightPalette.bg_main);
    out property <color> bg_sidebar: root.is_black ? BlackPalette.bg_sidebar : (root.is_dark ? NavyPalette.bg_sidebar : LightPalette.bg_sidebar);
    out property <color> bg_topbar: root.is_black ? BlackPalette.bg_titlebar : (root.is_dark ? NavyPalette.bg_titlebar : LightPalette.bg_titlebar);
    out property <color> bg_input: root.is_black ? BlackPalette.bg_input : (root.is_dark ? NavyPalette.bg_input : LightPalette.bg_input);
    out property <color> bg_list: root.is_black ? BlackPalette.bg_list : (root.is_dark ? NavyPalette.bg_list : LightPalette.bg_list);
    out property <color> bg_card: root.is_black ? BlackPalette.bg_input : (root.is_dark ? NavyPalette.bg_input : LightPalette.bg_input);
    out property <color> bg_card_hover: root.is_black ? BlackPalette.panel_hover : (root.is_dark ? NavyPalette.panel_hover : LightPalette.panel_hover);
    out property <color> bg_popup: root.is_black ? BlackPalette.bg_main : (root.is_dark ? NavyPalette.bg_main : LightPalette.bg_main);
    out property <color> bg_preview: root.is_black ? BlackPalette.bg_preview : (root.is_dark ? NavyPalette.bg_preview : LightPalette.bg_preview);
    out property <color> bg_panel_right: root.is_black ? BlackPalette.bg_panel_right : (root.is_dark ? NavyPalette.bg_panel_right : LightPalette.bg_panel_right);
    out property <color> bg_titlebar: root.is_black ? BlackPalette.bg_titlebar : (root.is_dark ? NavyPalette.bg_titlebar : LightPalette.bg_titlebar);
    out property <color> border_subtle: root.is_black ? BlackPalette.border_main : (root.is_dark ? NavyPalette.border_main : LightPalette.border_main);
    out property <color> border_input: root.is_black ? BlackPalette.border_input : (root.is_dark ? NavyPalette.border_input : LightPalette.border_input);
    out property <color> border_strong: root.is_black ? BlackPalette.border_input : (root.is_dark ? NavyPalette.border_input : LightPalette.border_input);
    out property <color> separator: root.is_black ? BlackPalette.border_list_item : (root.is_dark ? NavyPalette.border_list_item : LightPalette.border_list_item);
    out property <color> separator_main: root.is_black ? BlackPalette.border_main : (root.is_dark ? NavyPalette.border_main : LightPalette.border_main);
    out property <color> border_dashed: root.is_black ? BlackPalette.border_dashed : (root.is_dark ? NavyPalette.border_dashed : LightPalette.border_dashed);
    out property <color> tint_main: root.is_black ? BlackPalette.bg_main : (root.is_dark ? NavyPalette.bg_main : LightPalette.bg_main);
    out property <color> tint_panel: root.is_black ? BlackPalette.bg_main : (root.is_dark ? NavyPalette.bg_main : LightPalette.bg_main);
    out property <color> tint_card: root.is_black ? BlackPalette.bg_input : (root.is_dark ? NavyPalette.bg_input : LightPalette.bg_input);
    out property <color> text_primary: root.is_black ? BlackPalette.text_primary : (root.is_dark ? NavyPalette.text_primary : LightPalette.text_primary);
    out property <color> text_on_accent: root.is_black ? BlackPalette.text_on_accent : (root.is_dark ? NavyPalette.text_on_accent : LightPalette.text_on_accent);
    out property <color> text_secondary: root.is_black ? BlackPalette.text_menu : (root.is_dark ? NavyPalette.text_menu : LightPalette.text_menu);
    out property <color> text_muted: root.is_black ? BlackPalette.text_muted : (root.is_dark ? NavyPalette.text_muted : LightPalette.text_muted);
    out property <color> text_list: root.is_black ? BlackPalette.text_list : (root.is_dark ? NavyPalette.text_list : LightPalette.text_list);
    out property <color> text_menu: root.is_black ? BlackPalette.text_menu : (root.is_dark ? NavyPalette.text_menu : LightPalette.text_menu);
    out property <color> text_header: root.is_black ? BlackPalette.text_header : (root.is_dark ? NavyPalette.text_header : LightPalette.text_header);
    out property <color> text_section: root.is_black ? BlackPalette.text_section : (root.is_dark ? NavyPalette.text_section : LightPalette.text_section);
    out property <color> text_placeholder: root.is_black ? BlackPalette.text_placeholder : (root.is_dark ? NavyPalette.text_placeholder : LightPalette.text_placeholder);
    out property <color> text_empty: root.is_black ? BlackPalette.text_empty : (root.is_dark ? NavyPalette.text_empty : LightPalette.text_empty);
    out property <color> accent: root.is_black ? BlackPalette.accent_text : (root.is_dark ? NavyPalette.accent_text : LightPalette.accent_text);
