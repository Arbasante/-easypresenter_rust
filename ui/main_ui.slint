export struct Canto { id: int, titulo: string, letra: string, favorito: bool }
export struct BookInfo { id: int, nombre: string, capitulos: int }
export struct DiapositivaUI { orden: string, texto: string, font_size: float, favorito: bool }
export struct ChapterRow { caps: [int] }
export struct MediaItem { id: int, nombre: string, path: string, img: image, aspecto: string, is_loop: bool, }
export struct PdfItem { id: int, nombre: string, miniatura: image, total_paginas: int }

export component SplashWindow inherits Window {
    width: 500px;
    height: 300px;
    no-frame: true;
    always-on-top: true;
    
    in property <string> loading_status: "Iniciando...";
    in property <string> app_version: "0.0.0";

    // Contenedor principal con esquinas redondeadas
    Rectangle {
        background: #1e1e2e;
        border-radius: 12px;
        clip: true; // IMPORTANTE: Esto recorta la imagen para que respete los bordes redondeados

        // Imagen de fondo
        Image {
            source: @image-url("../assets/readyshow.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
        }

        // Degradado oscuro superpuesto para que el texto de la versión se lea bien
        Rectangle {
            background: @linear-gradient(0deg, #000000dd 0%, transparent 60%);
        }

        // Capa de textos superpuesta sobre la imagen
        VerticalLayout {
            padding: 20px;
            alignment: end; // Manda todo hacia abajo

            VerticalLayout {
                spacing: 4px;

                // Estado de carga actual
                Text {
                    text: root.loading_status;
                    font-size: 13px;
                    color: #a6e3a1; // Verde suave
                }

                // Versión de la app
                Text {
                    text: "Versión " + root.app_version;
                    font-size: 11px;
                    color: #a6adc8;
                }
            }
        }
    }
}

export struct ScreenInfo {
    id: int,
    nombre: string,
    x: int,
    y: int,
    width: int,
    height: int,
    es_primaria: bool,
    rol: int, // 0 = sin asignar, 1 = Operador, 2 = Proyector, 3 = Stage Display
}

// ─────────────────────────────────────────────────────────────
//  TEMA GLOBAL — claro / oscuro
//  Un solo interruptor (is_dark) controla todos los colores
//  estructurales de la app. Los componentes leen Theme.xxx en
//  vez de un color fijo, así el cambio se propaga solo.
// ─────────────────────────────────────────────────────────────
export global Theme {
    in-out property <bool> is_dark: false;



    // ── Fondos ───────────────────────────────────────────────
    // Modo claro: chrome gris más marcado contra paneles blancos,
    // para que la separación entre áreas se note sin depender solo del borde.
    out property <color> bg_main:       root.is_dark ? #18181b : #ededed;
    out property <color> bg_sidebar:    root.is_dark ? #111111 : #ffffff;
    out property <color> bg_topbar:     root.is_dark ? #0d0d0d : #d7d7d7;
    out property <color> bg_input:      root.is_dark ? #1f1f1f : #ffffff;
    out property <color> bg_list:       root.is_dark ? rgba(0, 0, 0, 0.3)  : #f7f7f7;
    out property <color> bg_card:       root.is_dark ? rgba(255,255,255,0.02) : #ffffff;
    out property <color> bg_card_hover: root.is_dark ? rgba(255,255,255,0.05) : #e6eaeb;
    out property <color> bg_popup:      root.is_dark ? #1e1e1e : #ffffff; // menús contextuales y modales

    // ── Bordes ───────────────────────────────────────────────
    // Modo claro: gris marcado, visible a simple vista sin ser negro puro.
    out property <color> border_subtle: root.is_dark ? rgba(255,255,255,0.06) : #d0d0d0;
    out property <color> border_input:  root.is_dark ? rgba(255,255,255,0.08) : #b8b8b8;
    out property <color> border_strong: root.is_dark ? #374151 : #aaaaaa; // bordes de popups/modales
    out property <color> separator:     root.is_dark ? #2d2d2d : #d7d7d7; // líneas divisorias internas

    // ── Texto ────────────────────────────────────────────────
    // Modo claro: negro casi puro para texto principal, jerarquía marcada
    // pero siempre legible (nada de grises lavados).
    out property <color> text_primary:   root.is_dark ? #ffffff : #000000;
    out property <color> text_secondary: root.is_dark ? #ffffff : #000000;
    out property <color> text_muted:     root.is_dark ? #ffffff : #000000;

    out property <color> accent: root.is_dark ? #0ea5e9 : #3f6f73;
    out property <color> accent_hover: root.is_dark ? #0284c7 : #31585b;
    out property <color> accent_soft: root.is_dark ? rgba(14,165,233,0.14) : rgba(63,111,115,0.14);
    out property <color> menu_hover: root.is_dark ? rgba(255,255,255,0.05) : #e8e8e8;
    out property <color> menu_text: root.is_dark ? #ffffff : #000000;
    out property <color> menu_icon: root.is_dark ? #ffffff : #000000;
    out property <color> overlay: root.is_dark ? rgba(0,0,0,0.65) : rgba(0,0,0,0.35);
    out property <color> shadow: root.is_dark ? rgba(0,0,0,0.6) : rgba(0,0,0,0.22);
}

// ─────────────────────────────────────────────────────────────
//  TAB BUTTON (nuevo componente para la barra de navegación)
// ─────────────────────────────────────────────────────────────
component TabButton inherits Rectangle {
    in property <string> text;
    in property <string> icon; // se mantiene la propiedad por compatibilidad, no se usa visualmente
    in property <bool> active: false;
    callback clicked;

    background: root.active ? Theme.accent_soft : (touch.has-hover ? Theme.bg_card_hover : transparent);
    touch := TouchArea { clicked => { root.clicked(); } }

    Text {
        text: root.text; font-size: 9px; font-weight: 800; letter-spacing: 0.4px;
        horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%;
        color: root.active ? Theme.accent : (touch.has-hover ? Theme.text_secondary : Theme.text_muted);
    }

    // Indicador inferior activo
    Rectangle {
        y: parent.height - 2px; height: 2px; width: 100%;
        background: root.active ? Theme.accent : transparent;
    }
}

// ─────────────────────────────────────────────────────────────
//  COMPONENTES PERSONALIZADOS (sin cambios)
// ─────────────────────────────────────────────────────────────
component TopMenuItem inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: 118px;
    height: 36px;
    border-radius: 4px;
    background: touch-top.has-hover ? Theme.bg_card_hover : transparent;

    touch-top := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: touch-top.has-hover ? Theme.text_primary : Theme.text_secondary;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> has_submenu: false;
    in property <color> text_color: Theme.menu_text;
    in property <color> icon_color: Theme.menu_icon;
    callback clicked();

    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.menu_hover : transparent;

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        alignment: space-between;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.icon; color: touch.has-hover ? Theme.accent : root.icon_color; font-size: 14px; vertical-alignment: center; }
            Text { text: root.text; color: touch.has-hover ? Theme.text_primary : root.text_color; font-size: 11px; vertical-alignment: center; font-weight: 600; }
        }
        if (root.has_submenu) : Text { text: ">"; color: touch.has-hover ? Theme.accent : Theme.menu_icon; font-size: 11px; vertical-alignment: center; font-weight: 600; }
    }
}



// 👇 Aquí está la estructura que te está pidiendo
export struct FavoritoItem { tipo: string, id: int, titulo: string, referencia: string }

export component IdentifyWindow inherits Window {
    title: "";
    no-frame: true;
    background: transparent;

    in property <int> numero_pantalla: 1;
    callback cerrar_solicitado();
    public function enfocar_pantalla() { id-focus.focus(); }

    forward-focus: id-focus;
    id-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cerrar_solicitado();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.75);
            VerticalLayout {
                alignment: center; spacing: 24px;
                Text {
                    text: root.numero_pantalla;
                    color: white;
                    font-size: 180px;
                    font-weight: 900;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Presiona ESC para salir";
                    color: rgba(255,255,255,0.65);
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

