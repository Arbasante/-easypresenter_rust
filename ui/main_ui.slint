export struct Canto { id: int, titulo: string, letra: string, favorito: bool }
export struct BookInfo { id: int, nombre: string, capitulos: int }
export struct DiapositivaUI { orden: string, texto: string, font_size: float, favorito: bool }
export struct ChapterRow { caps: [int] }
export struct MediaItem { id: int, nombre: string, path: string, img: image, aspecto: string, is_loop: bool, }
export struct VideoGaleriaItem { nombre: string, path: string, img: image }
export struct PdfItem { id: int, nombre: string, miniatura: image, total_paginas: int }

export component SplashWindow inherits Window {
    width: 500px;
    height: 300px;
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    always-on-top: true;
    
    in property <string> loading_status: "Iniciando...";
    in property <string> app_version: "0.0.0";

    // Contenedor principal con esquinas redondeadas
    Rectangle {
        background: Theme.bg_sidebar;
        border-radius: Theme.radius_surface;
        clip: true; // IMPORTANTE: Esto recorta la imagen para que respete los bordes redondeados

        // Imagen de fondo
        Image {
            source: @image-url("../assets/readyshow.jpg");
            width: 100%;
            height: 100%;
            image-fit: cover;
        }

        // Capa de textos superpuesta sobre la imagen
        VerticalLayout {
            padding: 20px;
            alignment: end; // Manda todo hacia abajo

            VerticalLayout {
                spacing: 4px;

                // Estado de carga actual
                Text {
                    text: root.loading_status;
                    font-size: 13px;
                    color: Theme.media_text; // Estado de carga
                }

                // Versión de la app
                Text {
                    text: "Versión " + root.app_version;
                    font-size: 11px;
                    color: Theme.media_muted;
                }
            }
        }
    }
}

export struct ScreenInfo {
    id: int,
    nombre: string,
    x: int,
    y: int,
    width: int,
    height: int,
    es_primaria: bool,
    rol: int, // 0 = sin asignar, 1 = Operador, 2 = Proyector, 3 = Stage Display
}

// ─────────────────────────────────────────────────────────────
//  TAB BUTTON (nuevo componente para la barra de navegación)
// ─────────────────────────────────────────────────────────────
component TabButton inherits Rectangle {
    in property <string> text;
    in property <string> icon; // se mantiene la propiedad por compatibilidad, no se usa visualmente
    in property <bool> active: false;
    callback clicked;

    background: root.active ? Theme.accent_fill : (touch.has-hover ? Theme.menu_hover : transparent);
    touch := TouchArea { clicked => { root.clicked(); } }

    Text {
        text: root.text; font-size: 9px; font-weight: Theme.font_weight_body; letter-spacing: 0.4px;
        horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%;
        color: root.active ? Theme.text_on_accent : (touch.has-hover ? Theme.text_primary : Theme.text_menu);
    }

    // Indicador inferior activo
    Rectangle {
        y: parent.height - 2px; height: 2px; width: 100%;
        background: root.active ? Theme.accent_fill : transparent;
    }
}

// ─────────────────────────────────────────────────────────────
//  COMPONENTES PERSONALIZADOS (sin cambios)
// ─────────────────────────────────────────────────────────────
component TopMenuItem inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: 118px;
    height: 36px;
    border-radius: 4px;
    background: touch-top.has-hover ? Theme.bg_card_hover : transparent;

    touch-top := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        color: (touch-top.has-hover ? Theme.text_primary : Theme.text_secondary);
        font-size: 11px;
        font-weight: Theme.font_weight_body;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> has_submenu: false;
    in property <bool> selected: false;
    in property <color> text_color: Theme.menu_text;
    in property <color> icon_color: Theme.menu_icon;
    callback clicked();
    callback hovered();

    height: 32px;
    border-radius: 4px;
    background: root.selected ? Theme.accent_fill : (touch.has-hover ? Theme.menu_hover : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { if (self.has-hover) { root.hovered(); } }
    }

    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 10px;
        alignment: space-between;
        HorizontalLayout {
            spacing: 8px;
            if (root.icon != "") : Text { text: root.icon; color: root.selected ? Theme.text_on_accent : (touch.has-hover ? Theme.text_primary : root.icon_color); font-size: 14px; vertical-alignment: center; }
            Text { text: root.text; color: root.selected ? Theme.text_on_accent : (touch.has-hover ? Theme.text_primary : root.text_color); font-size: 11px; vertical-alignment: center; font-weight: Theme.font_weight_body; }
        }
        if (root.has_submenu) : Text { text: ">"; color: root.selected ? Theme.text_on_accent : (touch.has-hover ? Theme.text_primary : Theme.menu_icon); font-size: 11px; vertical-alignment: center; font-weight: Theme.font_weight_body; }
    }
}



// 👇 Aquí está la estructura que te está pidiendo
export struct FavoritoItem { tipo: string, id: int, titulo: string, referencia: string, version: string }

export component IdentifyWindow inherits Window {
    title: "";
    no-frame: true;
    background: transparent;

    in property <int> numero_pantalla: 1;
    callback cerrar_solicitado();
    public function enfocar_pantalla() { id-focus.focus(); }

    forward-focus: id-focus;
    id-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cerrar_solicitado();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%; height: 100%;
            background: Theme.media_overlay;
            VerticalLayout {
                alignment: center; spacing: 24px;
                Text {
                    text: root.numero_pantalla;
                    color: Theme.media_text;
                    font-size: 180px;
                    font-weight: Theme.font_weight_heading;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Presiona ESC para salir";
                    color: Theme.media_muted;
                    font-size: 20px;
                    font-weight: Theme.font_weight_body;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

